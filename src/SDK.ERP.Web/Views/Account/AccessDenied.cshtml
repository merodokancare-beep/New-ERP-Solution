@inject SDK.ERP.Application.Common.ICompanyContext CompanyContext
@{
    ViewData["Title"] = "Access Denied - 403 Forbidden";
    Layout = "_Layout";
    var currentUser = await CompanyContext.GetCurrentUserAsync();
    var userRole = currentUser?.Role?.RoleName ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "USER";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5" style="border: 1px solid #E2E8F0 !important;">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: #FEF2F2; color: #DC2626;">
                        <i class="fa-solid fa-shield-halved fa-2xl"></i>
                    </div>
                </div>

                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mx-auto mb-3" style="font-size: 12px; font-weight: 700; letter-spacing: 0.5px;">
                    403 FORBIDDEN &bull; ROLE RESTRICTION
                </span>

                <h3 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px;">Access Denied</h3>
                <p class="text-muted mb-4" style="font-size: 14px; line-height: 1.6;">
                    You do not have the required role permissions to access this specific module or perform this action.
                </p>

                <div class="bg-light rounded-3 p-3 mb-4 text-start border" style="font-size: 13px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted"><i class="fa-solid fa-user me-1 text-primary"></i> Current User:</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(currentUser.FullName) ? currentUser.Username : currentUser.FullName)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted"><i class="fa-solid fa-id-badge me-1 text-secondary"></i> Active Role:</span>
                        <span class="badge bg-primary text-white">@userRole</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted"><i class="fa-solid fa-envelope me-1 text-info"></i> Account:</span>
                        <span class="text-secondary">@(string.IsNullOrEmpty(currentUser.Email) ? currentUser.Username : currentUser.Email)</span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold" style="font-size: 13.5px;">
                        <i class="fa-solid fa-house me-1"></i> Return to Dashboard
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold w-100" style="font-size: 13.5px;">
                            <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Switch Account
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
