@model SDK.ERP.Application.ViewModels.RegisterCompanyViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register Enterprise Organization - ERP Onboarding";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --erp-primary: #0284C7;
            --erp-primary-hover: #0369A1;
            --erp-dark: #0F172A;
            --erp-slate: #1E293B;
            --erp-border: #E2E8F0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #0B1329 0%, #1E293B 50%, #0F172A 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #1E293B;
        }

        .register-card {
            background: #FFFFFF;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 680px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .register-header {
            background: linear-gradient(135deg, #0284C7 0%, #0EA5E9 100%);
            padding: 28px 32px;
            color: #FFFFFF;
            text-align: center;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 12px;
            padding: 6px 14px;
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .register-body {
            padding: 32px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 4px;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #CBD5E1;
            padding: 9px 12px;
            font-size: 13.5px;
            transition: all 0.2s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--erp-primary);
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
        }

        .btn-register {
            background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
            border: none;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 15px;
            padding: 12px;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
            transition: all 0.2s ease;
        }

        .btn-register:hover {
            background: linear-gradient(135deg, #0369A1 0%, #075985 100%);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .section-tag {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--erp-primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-tag::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #E2E8F0;
        }
    </style>
</head>
<body>

<div class="register-card">
    <div class="register-header">
        <div class="brand-badge">
            <i class="fa-solid fa-cube me-2"></i> ENTERPRISE ERP ONBOARDING
        </div>
        <h4 class="fw-bold mb-1">Register New Organization</h4>
        <p class="mb-0 text-white-50" style="font-size: 13px;">Dedicated Tenant Provisioning with Guaranteed Zero Data Leakage</p>
    </div>

    <div class="register-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show p-3 mb-4 shadow-sm" role="alert" style="font-size: 13px;">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2 flex-shrink-0"></i>
                    <div>
                        <div asp-validation-summary="All" class="text-danger fw-semibold mb-0 list-unstyled"></div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <!-- 1. Organization Details -->
            <div class="section-tag"><i class="fa-solid fa-building"></i> 1. Organization Information</div>
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <label class="form-label">Company Trade Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="CompanyName" value="@Model.CompanyName" required placeholder="e.g. Apex Global Logistics" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Brand Short Code <span class="text-danger">*</span></label>
                    <input type="text" class="form-control text-uppercase fw-bold" name="BrandShortName" value="@Model.BrandShortName" maxlength="6" required placeholder="e.g. APEX" />
                    <small class="text-muted" style="font-size: 11px;">2-6 letters acronym for your logo badge.</small>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Base Currency</label>
                    <select class="form-select" name="BaseCurrency">
                        <option value="INR" selected>INR - Indian Rupee (&#8377;)</option>
                        <option value="USD">USD - US Dollar ($)</option>
                        <option value="EUR">EUR - Euro (&euro;)</option>
                        <option value="AED">AED - UAE Dirham (AED)</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label">Operating City &amp; State</label>
                    <input type="text" class="form-control" name="City" value="@Model.City" placeholder="City, State" />
                </div>
            </div>

            <!-- 2. Administrator Account Details -->
            <div class="section-tag"><i class="fa-solid fa-user-shield"></i> 2. Primary Administrator (Owner) Account</div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Admin Full Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="AdminFullName" value="@Model.AdminFullName" required placeholder="e.g. Bhawani Prasad" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Admin Username <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="AdminUsername" value="@Model.AdminUsername" required placeholder="e.g. bhawani.admin" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Official Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" name="AdminEmail" value="@Model.AdminEmail" required placeholder="admin@yourcompany.com" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Phone / Mobile Number</label>
                    <input type="tel" class="form-control" name="AdminPhone" value="@Model.AdminPhone" placeholder="+91 98765 43210" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Account Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" name="AdminPassword" required placeholder="Minimum 6 characters" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" name="ConfirmPassword" required placeholder="Re-type password" />
                </div>
            </div>

            <button type="submit" class="btn btn-register w-100 mb-3 shadow-sm">
                <i class="fa-solid fa-rocket me-2"></i> Register Organization &amp; Open Workspace
            </button>

            <div class="text-center pt-2 border-top">
                <span class="text-muted small">Already registered?</span>
                <a href="/Account/Login" class="text-primary fw-bold small text-decoration-none ms-1">
                    <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Log In to Existing Workspace
                </a>
            </div>
        </form>
    </div>
</div>

</body>
</html>
