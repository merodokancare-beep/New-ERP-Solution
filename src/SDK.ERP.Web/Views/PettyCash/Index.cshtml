<!-- Datalist for User Autocomplete -->
<datalist id="userList">
    @foreach (var u in Model.Users)
    {
        <option value="@u.FullName" />
    }
    <option value="Ramesh Kumar (Accountant)" />
    <option value="Sunil Verma (Site Supervisor)" />
    <option value="Admin / Finance Manager" />
</datalist>

@section Scripts {
<script>
    const availableCashInHand = @Model.CashInHand;

    function toggleBankFields() {
        var src = document.getElementById('withdrawalSourceType').value;
        var bankGroup = document.getElementById('bankAccountGroup');
        if (src === 'BANK_WITHDRAWAL') {
            bankGroup.style.display = 'block';
            updateBankBalanceInfo();
        } else {
            bankGroup.style.display = 'none';
            document.getElementById('bankBalanceBadge').style.display = 'none';
            document.getElementById('bankBalanceAlert').classList.add('d-none');
        }
    }

    function updateBankBalanceInfo() {
        var select = document.getElementById('bankAccountIdSelect');
        var badge = document.getElementById('bankBalanceBadge');
        if (!select || select.selectedIndex < 0) return;
        var opt = select.options[select.selectedIndex];
        var bal = parseFloat(opt.getAttribute('data-balance')) || 0;
        if (opt.value) {
            badge.innerText = 'Book Bal: ₹ ' + bal.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            badge.style.display = 'inline-block';
        } else {
            badge.style.display = 'none';
        }
        validateWithdrawalAmount();
    }

    function validateWithdrawalAmount() {
        var src = document.getElementById('withdrawalSourceType').value;
        if (src !== 'BANK_WITHDRAWAL') {
            document.getElementById('bankBalanceAlert').classList.add('d-none');
            return true;
        }

        var select = document.getElementById('bankAccountIdSelect');
        if (!select || select.selectedIndex < 0) return true;
        var opt = select.options[select.selectedIndex];
        var bal = parseFloat(opt.getAttribute('data-balance')) || 0;
        var amt = parseFloat(document.getElementById('withdrawalAmountInput').value) || 0;

        if (opt.value && amt > bal) {
            document.getElementById('bankBalanceAlert').classList.remove('d-none');
            return false;
        } else {
            document.getElementById('bankBalanceAlert').classList.add('d-none');
            return true;
        }
    }

    function validateWithdrawalSubmit() {
        var isValid = validateWithdrawalAmount();
        if (!isValid) {
            alert('Withdrawal amount exceeds the selected bank account book balance.');
            return false;
        }
        return true;
    }

    function validateExpenseAmount() {
        var amt = parseFloat(document.getElementById('expenseAmountInput').value) || 0;
        var status = document.getElementById('expenseStatusSelect').value;
        var alertDiv = document.getElementById('cashExceededAlert');
        var submitBtn = document.getElementById('expenseSubmitBtn');

        if (amt > availableCashInHand && (status === 'POSTED' || status === 'APPROVED')) {
            alertDiv.classList.remove('d-none');
            submitBtn.disabled = true;
            submitBtn.title = 'Cannot save: amount exceeds cash in hand';
        } else {
            alertDiv.classList.add('d-none');
            submitBtn.disabled = false;
            submitBtn.title = '';
        }
    }

    function validateExpenseSubmit() {
        var amt = parseFloat(document.getElementById('expenseAmountInput').value) || 0;
        var status = document.getElementById('expenseStatusSelect').value;

        if (amt > availableCashInHand && (status === 'POSTED' || status === 'APPROVED')) {
            alert('Cannot create ' + status + ' voucher of ₹' + amt.toFixed(2) + '.\n\nAvailable cash in hand is only ₹' + Math.max(0, availableCashInHand).toFixed(2) + '.\nPlease select "Draft" status or record a bank cash withdrawal first to replenish the float.');
            return false;
        }
        return true;
    }

    function openWithdrawModalForBank(bankId) {
        document.getElementById('withdrawalSourceType').value = 'BANK_WITHDRAWAL';
        toggleBankFields();
        document.getElementById('bankAccountIdSelect').value = bankId;
        updateBankBalanceInfo();
        var modal = new bootstrap.Modal(document.getElementById('newWithdrawalModal'));
        modal.show();
    }

    var currentUtilisation = null;

    async function openManualAllocationModal(utilId) {
        var modalEl = document.getElementById('manualAllocationModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();

        document.getElementById('mAllocVoucherNo').innerText = 'Loading...';
        document.getElementById('mAllocTotalAmount').innerText = '-';
        document.getElementById('mAllocRemainingAmount').innerText = '-';
        document.getElementById('manualAllocTableBody').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fa-solid fa-spinner fa-spin me-2"></i>Loading available withdrawals...</td></tr>';

        try {
            var res = await fetch('/PettyCash/GetUtilisationAllocationsJson?id=' + utilId);
            var data = await res.json();
            currentUtilisation = data.utilisation;

            document.getElementById('manualAllocUtilisationId').value = data.utilisation.id;
            document.getElementById('mAllocVoucherNo').innerText = data.utilisation.voucherNumber;
            document.getElementById('mAllocTotalAmount').innerText = '₹ ' + Number(data.utilisation.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 });
            document.getElementById('mAllocRemainingAmount').innerText = '₹ ' + Number(data.utilisation.remainingUnallocated).toLocaleString('en-IN', { minimumFractionDigits: 2 });

            var tbody = document.getElementById('manualAllocTableBody');
            tbody.innerHTML = '';

            var existingMap = {};
            if (data.existingAllocations) {
                data.existingAllocations.forEach(function(a) {
                    existingMap[a.withdrawalId] = a.amount;
                });
            }

            if (!data.availableWithdrawals || data.availableWithdrawals.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>No open or partly utilised cash withdrawals found in database. Please record a cash withdrawal first.</td></tr>';
                return;
            }

            data.availableWithdrawals.forEach(function(w) {
                var currentVal = existingMap[w.id] || 0;
                var effectiveMax = w.availableAmount + currentVal;

                var tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="ps-3 fw-bold text-primary">${w.referenceNumber}</td>
                    <td>${w.withdrawalDate.substring(0, 10)}</td>
                    <td><span class="badge badge-soft-secondary">${w.sourceType}</span></td>
                    <td class="text-end">₹ ${Number(w.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td class="text-end fw-semibold text-success">₹ ${Number(w.availableAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                    <td class="text-end pe-3">
                        <input type="number" step="0.01" min="0" max="${effectiveMax}" 
                               data-withdrawal-id="${w.id}" 
                               data-max="${effectiveMax}"
                               class="form-control form-control-sm text-end fw-bold alloc-input" 
                               value="${currentVal > 0 ? currentVal : ''}" 
                               placeholder="0.00" 
                               oninput="recalcManualAlloc()" />
                    </td>
                `;
                tbody.appendChild(tr);
            });

            recalcManualAlloc();
        } catch (e) {
            document.getElementById('manualAllocTableBody').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error loading data: ' + e.message + '</td></tr>';
        }
    }

    function recalcManualAlloc() {
        var inputs = document.querySelectorAll('.alloc-input');
        var sum = 0;
        inputs.forEach(function(inp) {
            var val = parseFloat(inp.value) || 0;
            sum += val;
        });

        document.getElementById('mAllocCalculatedTotal').innerText = '₹ ' + sum.toLocaleString('en-IN', { minimumFractionDigits: 2 });

        if (currentUtilisation) {
            var remaining = Math.max(0, currentUtilisation.amount - sum);
            document.getElementById('mAllocRemainingAmount').innerText = '₹ ' + remaining.toLocaleString('en-IN', { minimumFractionDigits: 2 });

            if (sum > currentUtilisation.amount) {
                document.getElementById('mAllocCalculatedTotal').classList.add('text-danger');
                document.getElementById('mAllocCalculatedTotal').classList.remove('text-success');
            } else {
                document.getElementById('mAllocCalculatedTotal').classList.add('text-success');
                document.getElementById('mAllocCalculatedTotal').classList.remove('text-danger');
            }
        }
    }

    function validateManualAlloc() {
        var inputs = document.querySelectorAll('.alloc-input');
        var items = [];
        var total = 0;

        for (var i = 0; i < inputs.length; i++) {
            var inp = inputs[i];
            var val = parseFloat(inp.value) || 0;
            var max = parseFloat(inp.dataset.max) || 0;
            var wId = parseInt(inp.dataset.withdrawalId);

            if (val > max) {
                alert('Allocated amount ₹' + val + ' exceeds available balance ₹' + max + ' for this withdrawal.');
                return false;
            }

            if (val > 0) {
                items.push({ withdrawalId: wId, amount: val });
                total += val;
            }
        }

        if (currentUtilisation && total > currentUtilisation.amount) {
            alert('Total allocated ₹' + total + ' cannot exceed total expense voucher amount ₹' + currentUtilisation.amount);
            return false;
        }

        document.getElementById('manualAllocJson').value = JSON.stringify(items);
        return true;
    }

    function showWithdrawalAllocations(wId, refNo, amount, utilised) {
        document.getElementById('viewWAllocTitle').innerText = 'Expenses Funded by ' + refNo;
        var modal = new bootstrap.Modal(document.getElementById('viewWithdrawalAllocModal'));
        modal.show();

        var body = document.getElementById('viewWAllocBody');
        body.innerHTML = `
            <div class="p-3 mb-3 bg-light rounded d-flex justify-content-between">
                <div><strong>Total Inflow:</strong> ₹ ${amount.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</div>
                <div class="text-danger"><strong>Utilised:</strong> ₹ ${utilised.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</div>
                <div class="text-success"><strong>Remaining:</strong> ₹ ${(amount - utilised).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</div>
            </div>
            <p class="text-muted" style="font-size: 13px;">This withdrawal has funded the following expense voucher(s):</p>
            <div class="text-center py-3">
                <a href="/PettyCash?tab=allocations" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open Full Allocation Join Matrix
                </a>
            </div>
        `;
    }

    function openReconcileModal(wId, refNo, amount, bankName) {
        document.getElementById('reconcileWithdrawalId').value = wId;
        document.getElementById('recWithdrawalRef').innerText = refNo;
        document.getElementById('recWithdrawalAmount').innerText = '₹ ' + Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 });
        document.getElementById('recWithdrawalBank').innerText = bankName;
        document.getElementById('recStatementRefInput').value = '';

        var modal = new bootstrap.Modal(document.getElementById('reconcileWithdrawalModal'));
        modal.show();
    }
</script>
}
