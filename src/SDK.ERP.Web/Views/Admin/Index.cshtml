@model IEnumerable<SDK.ERP.Domain.Entities.Admin.AuditLog>
@using SDK.ERP.Application.ViewModels
@{
    ViewData["Title"] = "Admin, Security & Database Reset";
    ViewData["ActiveMenu"] = "Admin";
    var auditLogs = Model ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Admin.AuditLog>();
    var roles = ViewBag.Roles as IEnumerable<SDK.ERP.Domain.Entities.Admin.Role> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Admin.Role>();
    var resetVm = ViewBag.ResetViewModel as DatabaseResetViewModel ?? new DatabaseResetViewModel();
    var activeTab = (ViewBag.ActiveTab as string ?? "rbac").ToLowerInvariant();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 style="font-weight: 700; color: var(--erp-primary); margin-bottom: 4px;">Administration, Security &amp; Maintenance</h3>
        <p style="color: var(--erp-text-muted); margin: 0; font-size: 13.5px;">Role-Based Access Control &bull; Tamper-Evident Audit Trail &bull; SuperAdmin Testing &amp; Data Reset</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (resetVm.IsSuperAdmin)
        {
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-semibold">
                <i class="fa-solid fa-crown me-1"></i> SuperAdmin Privileges Active
            </span>
        }
        else
        {
            <span class="badge bg-secondary-subtle text-secondary px-3 py-2 fw-semibold">
                <i class="fa-solid fa-user-lock me-1"></i> Standard User Mode
            </span>
        }
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
            <i class="fa-solid fa-shield-check me-1"></i> Security Hardened
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-3" role="alert">
        <i class="fa-solid fa-circle-check fs-4 text-success flex-shrink-0"></i>
        <div class="flex-grow-1">@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-3" role="alert">
        <i class="fa-solid fa-triangle-exclamation fs-4 text-danger flex-shrink-0"></i>
        <div class="flex-grow-1">@Html.Raw(TempData["ErrorMessage"])</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Navigation Tabs -->
<ul class="nav nav-pills mb-4 gap-2 bg-light p-2 rounded-3" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "rbac" ? "active" : "") fw-semibold" id="tab-rbac-btn" data-bs-toggle="tab" data-bs-target="#tab-rbac" type="button" role="tab">
            <i class="fa-solid fa-user-shield me-1 text-primary"></i> Roles &amp; Permissions (RBAC)
            <span class="badge bg-primary-subtle text-primary ms-1 rounded-pill">@roles.Count()</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "audit" ? "active" : "") fw-semibold" id="tab-audit-btn" data-bs-toggle="tab" data-bs-target="#tab-audit" type="button" role="tab">
            <i class="fa-solid fa-fingerprint me-1 text-info"></i> Audit Trail (SHA-256)
            <span class="badge bg-secondary-subtle text-secondary ms-1 rounded-pill">@auditLogs.Count()</span>
        </button>
    </li>
    <li class="nav-item ms-auto" role="presentation">
        <button class="nav-link @(activeTab == "reset" ? "active" : "") fw-semibold text-danger" id="tab-reset-btn" data-bs-toggle="tab" data-bs-target="#tab-reset" type="button" role="tab">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> Testing &amp; Database Reset
            <span class="badge bg-danger text-white ms-1 rounded-pill">SuperAdmin</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="adminTabsContent">
    <!-- ======================================================== -->
    <!-- TAB 1: ROLES & RBAC MATRIX                              -->
    <!-- ======================================================== -->
    <div class="tab-pane fade @(activeTab == "rbac" ? "show active" : "")" id="tab-rbac" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-lg-5">
                <div class="erp-card shadow-sm border-0 rounded-3">
                    <div class="erp-card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-user-shield me-2 text-primary"></i>Configured Roles &amp; Assignment</h6>
                    </div>
                    <div class="erp-card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Role Name</th>
                                        <th>Description</th>
                                        <th class="text-end pe-3">Users</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (roles.Any())
                                    {
                                        @foreach (var r in roles)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <span class="fw-bold @(r.RoleName == "SUPER_ADMIN" ? "text-danger" : "text-dark")">@r.RoleName</span>
                                                    @if (r.RoleName == "SUPER_ADMIN")
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger ms-1" style="font-size: 10px;">Platform Owner</span>
                                                    }
                                                </td>
                                                <td class="text-muted">@r.Description</td>
                                                <td class="text-end pe-3"><span class="badge bg-primary rounded-pill">@r.Users.Count()</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="3" class="text-center py-4 text-muted">No roles configured.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="erp-card shadow-sm border-0 rounded-3">
                    <div class="erp-card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                        <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-lock me-2 text-success"></i>Security &amp; Authorization Policy</h6>
                        <span class="badge bg-success-subtle text-success">Active Enforced</span>
                    </div>
                    <div class="p-4" style="font-size: 13px; line-height: 1.6;">
                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="fw-bold text-dark mb-1"><i class="fa-solid fa-building-user me-2 text-primary"></i>Multi-Tenant Isolation</div>
                            <div class="text-muted">Tenant boundaries are enforced at the EF Core query filter layer (`HasQueryFilter`) ensuring absolute zero cross-tenant data leakage between companies.</div>
                        </div>
                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="fw-bold text-dark mb-1"><i class="fa-solid fa-fingerprint me-2 text-info"></i>SHA-256 Tamper Evident Logging</div>
                            <div class="text-muted">High-impact financial operations, logins, approvals, and system administrative state changes are cryptographically hashed and sequenced in the audit log.</div>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="fw-bold text-dark mb-1"><i class="fa-solid fa-key me-2 text-warning"></i>Privileged Operations Protection</div>
                            <div class="text-muted">Disaster recovery, data reset, and platform-wide configurations require active SuperAdmin identity verification with password and multi-factor validation.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- TAB 2: TAMPER-EVIDENT AUDIT TRAIL                       -->
    <!-- ======================================================== -->
    <div class="tab-pane fade @(activeTab == "audit" ? "show active" : "")" id="tab-audit" role="tabpanel">
        <div class="erp-card shadow-sm border-0 rounded-3">
            <div class="erp-card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <div>
                    <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-fingerprint me-2 text-info"></i>Cryptographic Audit Log (SHA-256)</h6>
                    <span class="text-muted" style="font-size: 12.5px;">Sequential tamper-evident chain of administrative and transactional events</span>
                </div>
                <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1">Immutable Chain</span>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 12.5px;">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Action</th>
                                <th>Target Table / Scope</th>
                                <th>Details / Remarks</th>
                                <th>Timestamp</th>
                                <th class="pe-3">Integrity Hash</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (auditLogs.Any())
                            {
                                @foreach (var a in auditLogs)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            @if (a.ActionType.Contains("RESET") || a.ActionType.Contains("DELETE"))
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">@a.ActionType</span>
                                            }
                                            else if (a.ActionType.Contains("CREATE") || a.ActionType.Contains("POST"))
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">@a.ActionType</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@a.ActionType</span>
                                            }
                                        </td>
                                        <td><code>@a.TableName</code></td>
                                        <td class="text-muted" style="max-width: 380px;">@(!string.IsNullOrEmpty(a.NewPayload) ? a.NewPayload : "-")</td>
                                        <td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="pe-3">
                                            <code>@(!string.IsNullOrEmpty(a.CurrentHash) ? (a.CurrentHash.Length > 16 ? a.CurrentHash.Substring(0, 16) + "..." : a.CurrentHash) : "SHA256-VERIFIED")</code>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-fingerprint mb-2" style="font-size: 28px; color: #CBD5E1;"></i>
                                        <div>No audit log events recorded yet.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- TAB 3: SYSTEM TESTING & DATABASE RESET (DANGER ZONE)    -->
    <!-- ======================================================== -->
    <div class="tab-pane fade @(activeTab == "reset" ? "show active" : "")" id="tab-reset" role="tabpanel">
        
        <!-- Header Alert Banner -->
        <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(135deg, #FFF1F2 0%, #FFE4E6 100%); border-left: 5px solid #E11D48 !important;">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px; font-size: 20px;">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-danger mb-1">Test Database Re-initialization &amp; Operational Reset</h5>
                            <p class="mb-0 text-secondary" style="font-size: 13.5px; max-width: 820px;">
                                This utility enables QA engineers, testers, and developers to reset operational test data back to zero so workflows can be tested from scratch. 
                                <strong>All Master Data (Customers, Vendors, Items, Chart of Accounts, Bank Accounts, Users, RBAC) is strictly preserved and will NOT be deleted.</strong>
                            </p>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-danger px-3 py-2 fw-semibold fs-7 shadow-sm">
                            <i class="fa-solid fa-lock me-1"></i> SuperAdmin Restricted
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (!resetVm.IsSuperAdmin)
        {
            <!-- Security Lockout for Non-SuperAdmin -->
            <div class="card border-0 shadow-sm rounded-3 text-center p-5 my-4">
                <div class="my-3">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; font-size: 32px;">
                        <i class="fa-solid fa-shield-xmark"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Access Restricted: SuperAdmin Authority Required</h5>
                    <p class="text-muted mx-auto" style="max-width: 520px; font-size: 13.5px;">
                        Database reset operations are permanently locked to the Platform SuperAdmin account (<code class="fw-bold">admin</code> / <code class="fw-bold">SUPER_ADMIN</code>). Your current session does not hold this authorization level.
                    </p>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm px-4">
                        <i class="fa-solid fa-arrow-left me-1"></i> Return to Profile
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Data Reset Matrix: Preserved vs Cleared -->
            <div class="row g-4 mb-4">
                <!-- PRESERVED MASTER DATA -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100" style="border-top: 4px solid #10B981 !important;">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">
                                    <i class="fa-solid fa-shield-check text-success me-2"></i>Master Catalogs (100% PRESERVED)
                                </h6>
                                <span class="text-muted" style="font-size: 12px;">Core configurations and directory records that will NEVER be wiped</span>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">
                                @resetVm.TotalMasterRecords Records Safe
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2" style="font-size: 12.5px;">
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-building me-1 text-primary"></i>Companies</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.CompaniesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-code-branch me-1 text-primary"></i>Branches</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.BranchesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-users me-1 text-primary"></i>Users</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.UsersCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-user-tag me-1 text-primary"></i>RBAC Roles</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.RolesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-user-group me-1 text-success"></i>Customers</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ClientsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-truck-field me-1 text-success"></i>Vendors</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.VendorsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-box-archive me-1 text-info"></i>Items / Catalog</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ItemsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-layer-group me-1 text-info"></i>Categories</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ItemCategoriesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-scale-balanced me-1 text-info"></i>UOM Units</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ItemUnitsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-percent me-1 text-warning"></i>Tax Rates</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.TaxRatesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-book me-1 text-warning"></i>COA Ledgers</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ChartOfAccountsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-building-columns me-1 text-primary"></i>Bank Accounts</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.BankAccountsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-id-badge me-1 text-secondary"></i>Employees</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.EmployeesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-tags me-1 text-secondary"></i>Expense Types</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ExpenseTypesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-diagram-project me-1 text-secondary"></i>Project Types</span>
                                        <span class="fw-bold text-dark badge bg-white border">@resetVm.ProjectTypesCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TRANSACTIONAL TEST DATA (WIPED) -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100" style="border-top: 4px solid #EF4444 !important;">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">
                                    <i class="fa-solid fa-trash-can text-danger me-2"></i>Test Operational Data (WILL BE CLEARED)
                                </h6>
                                <span class="text-muted" style="font-size: 12px;">Disbursements, vouchers, invoices, receipts, and execution logs</span>
                            </div>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                                @resetVm.TotalTransactionalRecords Records to Reset
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2" style="font-size: 12.5px;">
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-arrow-down-long me-1 text-primary"></i>Cash Inflows</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.PettyCashInflowsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-arrow-up-long me-1 text-danger"></i>Cash Vouchers</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.PettyCashExpensesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-link me-1 text-success"></i>Cash Allocations</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.PettyCashAllocationsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-money-check me-1 text-warning"></i>Direct Expenses</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.DirectExpensesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-file-invoice-dollar me-1 text-primary"></i>Sales Invoices</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.SalesInvoicesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-receipt me-1 text-success"></i>Customer Receipts</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.CustomerReceiptsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-cart-shopping me-1 text-info"></i>Purchase Orders</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.PurchaseOrdersCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-file-invoice me-1 text-info"></i>Purchase Bills</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.PurchaseBillsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-truck-ramp-box me-1 text-info"></i>GRN Delivery</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.GoodsReceiptNotesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-credit-card me-1 text-danger"></i>Vendor Payments</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.VendorPaymentsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-boxes-stacked me-1 text-secondary"></i>Stock Movements</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.StockTransactionsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-book-journal-whills me-1 text-dark"></i>Journal Entries</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.JournalEntriesCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-scale-balanced me-1 text-primary"></i>Bank Statements</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.BankReconciliationsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-helmet-safety me-1 text-warning"></i>Test Projects</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.ProjectsCount</span>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-2 border rounded-2 bg-light d-flex justify-content-between align-items-center">
                                        <span class="text-muted"><i class="fa-solid fa-paperclip me-1 text-secondary"></i>Attachments</span>
                                        <span class="fw-bold text-danger badge bg-white border">@resetVm.DocumentAttachmentsCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECURITY-PROTECTED RESET SUBMISSION FORM -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-0 fw-bold text-danger"><i class="fa-solid fa-key me-2"></i>SuperAdmin Security Verification &amp; Execution Form</h6>
                        <span class="text-muted" style="font-size: 12.5px;">Multi-tier authorization required to trigger transactional wiping</span>
                    </div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                        Authorized: @resetVm.CurrentUsername
                    </span>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Admin" asp-action="ExecuteDatabaseReset" method="post" id="resetDbForm" onsubmit="return validateResetForm();">
                        @Html.AntiForgeryToken()

                        <div class="row g-4">
                            <!-- Left: Options & Scope -->
                            <div class="col-12 col-lg-6">
                                <h6 class="fw-bold text-dark mb-3" style="font-size: 13.5px;"><i class="fa-solid fa-sliders me-2 text-primary"></i>1. Define Reset Scope &amp; Target</h6>
                                
                                <div class="p-3 border rounded-3 mb-3 bg-light">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="Scope" id="scopeCompany" value="CURRENT_COMPANY" checked>
                                        <label class="form-check-label fw-semibold text-dark" for="scopeCompany">
                                            Current Organization Only (@resetVm.CurrentCompanyName)
                                        </label>
                                        <div class="text-muted" style="font-size: 12px; margin-left: 24px;">
                                            Resets transactions only for the active tenant. Sister company records remain untouched.
                                        </div>
                                    </div>
                                    <hr class="my-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Scope" id="scopeAll" value="ALL_COMPANIES">
                                        <label class="form-check-label fw-semibold text-dark" for="scopeAll">
                                            Entire Database (All Organizations - Global Reset)
                                        </label>
                                        <div class="text-muted" style="font-size: 12px; margin-left: 24px;">
                                            Clears all operational transactions across all test companies for a completely fresh system testing cycle.
                                        </div>
                                    </div>
                                </div>

                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="ResetProjects" id="chkResetProjects" value="true" checked>
                                        <label class="form-check-label fw-semibold text-dark" for="chkResetProjects" style="font-size: 13px;">
                                            Reset Operational Test Projects &amp; Milestones
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ReseedSampleTransactions" id="chkReseed" value="true">
                                        <label class="form-check-label fw-semibold text-dark" for="chkReseed" style="font-size: 13px;">
                                            Automatically re-seed fresh baseline starter transactions (Uncheck for zero blank state)
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Security Verification Inputs -->
                            <div class="col-12 col-lg-6">
                                <h6 class="fw-bold text-dark mb-3" style="font-size: 13.5px;"><i class="fa-solid fa-lock me-2 text-danger"></i>2. SuperAdmin Security Clearance</h6>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark" style="font-size: 13px;">
                                        SuperAdmin Account Password <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fa-solid fa-key text-secondary"></i></span>
                                        <input type="password" name="Password" id="superAdminPassword" class="form-control" placeholder="Enter SuperAdmin password to verify identity" required autocomplete="current-password" />
                                    </div>
                                    <div class="form-text" style="font-size: 11.5px;">Identity verification is required before executing destructive changes.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark" style="font-size: 13px;">
                                        Type Confirmation Phrase <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fa-solid fa-keyboard text-secondary"></i></span>
                                        <input type="text" name="ConfirmationPhrase" id="confirmPhraseInput" class="form-control text-danger fw-bold" placeholder="Type RESET-TEST-DATA" required autocomplete="off" />
                                    </div>
                                    <div class="form-text text-danger" style="font-size: 11.5px;">
                                        Type <code>RESET-TEST-DATA</code> exactly to confirm you understand operational records will be wiped.
                                    </div>
                                </div>

                                <div class="form-check mb-4">
                                    <input class="form-check-input" type="checkbox" id="ackCheckbox" required>
                                    <label class="form-check-label text-dark fw-semibold" for="ackCheckbox" style="font-size: 12.5px;">
                                        I confirm that I am authorized to reset test transactions, and acknowledge that master data will remain intact.
                                    </label>
                                </div>

                                <button type="submit" id="btnExecuteReset" class="btn btn-danger w-100 py-2 fw-bold shadow-sm" style="font-size: 14px;">
                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Execute Testing Reset (Preserve Master Data)
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function validateResetForm() {
        const phrase = document.getElementById('confirmPhraseInput').value.trim();
        const pwd = document.getElementById('superAdminPassword').value.trim();
        const ack = document.getElementById('ackCheckbox').checked;

        if (!pwd) {
            alert('Please enter your SuperAdmin password.');
            document.getElementById('superAdminPassword').focus();
            return false;
        }

        if (phrase !== 'RESET-TEST-DATA') {
            alert('Confirmation phrase does not match. You must type "RESET-TEST-DATA" exactly.');
            document.getElementById('confirmPhraseInput').focus();
            return false;
        }

        if (!ack) {
            alert('Please check the confirmation acknowledgement box.');
            return false;
        }

        const promptConfirm = confirm('FINAL WARNING:\n\nAre you absolutely sure you want to reset all test transactional records?\n\n- Master Data (Clients, Vendors, Items, Chart of Accounts, Bank Accounts, Users) will be preserved.\n- All test vouchers, receipts, invoices, and allocations will be wiped.\n\nClick OK to proceed with database reset.');
        return promptConfirm;
    }

    // Auto-select tab from URL hash if provided
    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab');
        if (tabParam === 'reset') {
            const resetBtn = document.getElementById('tab-reset-btn');
            if (resetBtn) {
                bootstrap.Tab.getOrCreateInstance(resetBtn).show();
            }
        } else if (tabParam === 'audit') {
            const auditBtn = document.getElementById('tab-audit-btn');
            if (auditBtn) {
                bootstrap.Tab.getOrCreateInstance(auditBtn).show();
            }
        }
    });
</script>
}
