@model IEnumerable<SDK.ERP.Domain.Entities.Procurement.PurchaseOrder>
@{
    ViewData["Title"] = "Procurement & Payables";
    ViewData["ActiveMenu"] = "Procurement";
    var poList = Model ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Procurement.PurchaseOrder>();
    var vendors = ViewBag.Vendors as IEnumerable<SDK.ERP.Domain.Entities.MasterData.Vendor> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.Vendor>();
    var projects = ViewBag.Projects as IEnumerable<SDK.ERP.Domain.Entities.Projects.Project> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Projects.Project>();
    var currentUser = ViewBag.CurrentUser as SDK.ERP.Domain.Entities.Admin.User;
    var userRole = (currentUser?.Role?.RoleName ?? "").ToUpperInvariant();
    var userDesignation = (currentUser?.Designation ?? "").ToUpperInvariant();
    var username = (currentUser?.Username ?? "").ToUpperInvariant();

    bool isSystemAdmin = userRole == "SUPER_ADMIN" || 
                         userRole == "COMPANY_ADMIN" || 
                         userRole == "ADMIN" || 
                         userRole == "ORG_ADMIN" ||
                         username == "ADMIN" || 
                         username == "SABIR" ||
                         userDesignation.Contains("DIRECTOR") || 
                         userDesignation.Contains("OWNER") || 
                         userDesignation.Contains("CEO");

    bool isManager = isSystemAdmin || 
                     userRole == "PROJECT_MANAGER" || 
                     userRole == "MANAGER" || 
                     userDesignation.Contains("MANAGER");

    bool isAccountant = userRole == "ACCOUNTANT" || 
                        userRole == "ACCOUNTS" || 
                        userDesignation.Contains("ACCOUNT");

    var totalCount = poList.Count();
    var pendingCount = poList.Count(p => p.ApprovalStatus == "PENDING" || p.ApprovalStatus == "PENDING_APPROVAL");
    var approvedCount = poList.Count(p => p.ApprovalStatus == "APPROVED");
    var markedPaymentCount = poList.Count(p => p.ApprovalStatus == "MARKED_FOR_PAYMENT");
    var rejectedCount = poList.Count(p => p.ApprovalStatus == "REJECTED");
}

<style>
    .po-filter-btn {
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        color: #475569;
        font-size: 12.5px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 6px;
        transition: all 0.15s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .po-filter-btn:hover {
        background: #F1F5F9;
        color: #0F172A;
    }
    .po-filter-btn.active {
        background: var(--erp-primary, #4F46E5);
        color: #FFFFFF;
        border-color: var(--erp-primary, #4F46E5);
    }
    .po-filter-btn .badge {
        font-size: 11px;
    }
    .status-badge-pending {
        background: #FEF3C7;
        color: #92400E;
        border: 1px solid #FDE68A;
    }
    .status-badge-approved {
        background: #D1FAE5;
        color: #065F46;
        border: 1px solid #A7F3D0;
    }
    .status-badge-payment {
        background: #EDE9FE;
        color: #5B21B6;
        border: 1px solid #DDD6FE;
    }
    .status-badge-rejected {
        background: #FEE2E2;
        color: #991B1B;
        border: 1px solid #FECACA;
    }
    .status-badge-paid {
        background: #E0E7FF;
        color: #3730A3;
        border: 1px solid #C7D2FE;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 style="font-weight: 700; color: var(--erp-primary); margin-bottom: 4px;">Procurement &amp; Payables Management</h3>
        <p style="color: var(--erp-text-muted); margin: 0; font-size: 13.5px;">Purchase Orders &bull; Goods Receipt Notes (GRN) &bull; 3-Way Match &bull; Vendor Bills</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Procurement" asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm d-inline-flex align-items-center gap-2" style="background: var(--erp-primary);">
            <i class="fa-solid fa-file-signature me-1"></i> Add Procurement Details
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
        <div>@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
        <div>@Html.Raw(TempData["ErrorMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ========================================================================= -->
<!-- APPROVAL WORKFLOW & FINANCIAL AUTHORITY BANNER -->
<!-- ========================================================================= -->
<div class="p-3 mb-3 rounded-3 shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-3" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center justify-content-center rounded-3 shadow-sm" style="width: 42px; height: 42px; background: #EEF2FF; color: #4F46E5;">
            <i class="fa-solid fa-shield-halved fs-5"></i>
        </div>
        <div>
            <div class="fw-bold text-dark" style="font-size: 13.5px;">
                Procurement Approval &amp; Payables Governance
            </div>
            <div class="text-muted d-flex flex-wrap gap-2 mt-1" style="font-size: 11.5px;">
                <span class="badge bg-light text-dark border"><i class="fa-solid fa-users text-primary me-1"></i>Subordinates: Requires Approval</span>
                <span class="badge bg-light text-dark border"><i class="fa-solid fa-calculator text-success me-1"></i>Accounts: Auto-Approved &le; &#8377;1,00,000 (1 Lakh)</span>
                <span class="badge bg-light text-dark border"><i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>&gt; &#8377;1,00,000: Needs Managerial Approval</span>
                <span class="badge bg-light text-dark border"><i class="fa-solid fa-money-bill-wave text-indigo me-1"></i>Approved PO &rarr; Marked for Payment</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="fa-solid fa-user-shield me-1"></i>Active User: @(currentUser?.FullName ?? currentUser?.Username ?? "User") (@(currentUser?.Designation ?? userRole)) &mdash; @(isSystemAdmin ? "Executive Approver" : (isManager ? "Managerial Approver" : (isAccountant ? "Accounts Authority (≤ ₹1L)" : "Subordinate / Requester")))</span>
            </div>
        </div>
    </div>
    
    <!-- Quick Status Filter Pills -->
    <div class="d-flex flex-wrap gap-1 align-items-center">
        <button type="button" class="po-filter-btn active" data-filter="ALL">
            All <span class="badge bg-secondary">@totalCount</span>
        </button>
        <button type="button" class="po-filter-btn" data-filter="PENDING">
            <i class="fa-solid fa-clock-rotate-left text-warning"></i> Pending <span class="badge bg-warning text-dark">@pendingCount</span>
        </button>
        <button type="button" class="po-filter-btn" data-filter="APPROVED">
            <i class="fa-solid fa-circle-check text-success"></i> Approved <span class="badge bg-success">@approvedCount</span>
        </button>
        <button type="button" class="po-filter-btn" data-filter="MARKED_FOR_PAYMENT">
            <i class="fa-solid fa-file-invoice-dollar text-primary"></i> For Payment <span class="badge bg-primary">@markedPaymentCount</span>
        </button>
        <button type="button" class="po-filter-btn" data-filter="REJECTED">
            <i class="fa-solid fa-circle-xmark text-danger"></i> Rejected <span class="badge bg-danger">@rejectedCount</span>
        </button>
    </div>
</div>

<div class="erp-card">
    <div class="erp-card-header d-flex justify-content-between align-items-center">
        <h5 class="erp-card-title"><i class="fa-solid fa-clipboard-check me-2"></i>Purchase Orders &amp; Vendor Bills</h5>
        <span class="badge bg-success-subtle text-success">3-Way Match Enforced</span>
    </div>
    <div class="erp-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="poTable" style="font-size: 13.5px;">
                <thead class="table-light" style="font-size: 12px;">
                    <tr>
                        <th class="ps-4">PO Number</th>
                        <th>PO Type</th>
                        <th>Date</th>
                        <th>Vendor</th>
                        <th>Project</th>
                        <th>Taxable Value</th>
                        <th>GST Amount</th>
                        <th>Total Value</th>
                        <th>Approval Status</th>
                        <th class="ps-3" style="width: 290px; min-width: 290px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (poList.Any())
                    {
                        @foreach (var po in poList)
                        {
                            var normalizedStatus = po.ApprovalStatus?.ToUpperInvariant() ?? "PENDING_APPROVAL";
                            if (normalizedStatus == "PENDING") { normalizedStatus = "PENDING_APPROVAL"; }
                            var isAboveOneLakh = po.TotalPoValue > 100000m;

                            bool isCreator = (currentUser != null) && (
                                (po.CreatedBy.HasValue && po.CreatedBy.Value == currentUser.Id) ||
                                (!string.IsNullOrWhiteSpace(po.CreatedByName) && po.CreatedByName.Equals(currentUser.Username, StringComparison.OrdinalIgnoreCase)) ||
                                (!string.IsNullOrWhiteSpace(po.CreatedByName) && !string.IsNullOrWhiteSpace(currentUser.FullName) && po.CreatedByName.Equals(currentUser.FullName, StringComparison.OrdinalIgnoreCase))
                            );

                            bool canApprove = false;
                            if (isSystemAdmin)
                            {
                                canApprove = true;
                            }
                            else if (isManager)
                            {
                                canApprove = !isCreator;
                            }
                            else if (isAccountant)
                            {
                                canApprove = (!isAboveOneLakh) && (!isCreator);
                            }
                            else
                            {
                                canApprove = false;
                            }

                            <tr class="po-row" data-status="@normalizedStatus">
                                <td class="ps-4 fw-bold text-primary">
                                    <a asp-controller="Procurement" asp-action="PrintPo" asp-route-id="@po.Id" target="_blank" class="text-decoration-none">
                                        @po.PoNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrWhiteSpace(po.PoType) ? "Standard PO" : po.PoType)
                                    </span>
                                </td>
                                <td>@po.PoDate.ToString("dd MMM yyyy")</td>
                                <td><strong>@(po.Vendor?.VendorName ?? "N/A")</strong></td>
                                <td>@(po.Project?.ProjectCode ?? "N/A")</td>
                                <td>&#8377; @po.TaxableAmount.ToString("N2")</td>
                                <td>&#8377; @po.GstAmount.ToString("N2")</td>
                                <td class="fw-bold text-dark">&#8377; @po.TotalPoValue.ToString("N2")</td>

                                <!-- ========================================================= -->
                                <!-- 1. APPROVAL STATUS COLUMN (Status of PO) -->
                                <!-- ========================================================= -->
                                <td>
                                    @if (normalizedStatus == "PENDING" || normalizedStatus == "PENDING_APPROVAL")
                                    {
                                        <span class="badge status-badge-pending px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 11px; font-weight: 600; border-radius: 5px;">
                                            <i class="fa-solid fa-clock-rotate-left"></i> PENDING APPROVAL
                                        </span>
                                        @if (isAboveOneLakh)
                                        {
                                            <div class="text-danger fw-semibold mt-1" style="font-size: 10.5px;">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>&gt; &#8377;1 Lakh (Approval Req.)
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(po.CreatedByRole) && po.CreatedByRole != "ACCOUNTANT" && po.CreatedByRole != "ADMIN" && po.CreatedByRole != "SUPER_ADMIN")
                                        {
                                            <div class="text-muted mt-1" style="font-size: 10.5px;">
                                                <i class="fa-solid fa-user-clock me-1"></i>Subordinate Request
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted mt-1" style="font-size: 10.5px;">
                                                <i class="fa-solid fa-user-check me-1"></i>Awaiting Approval
                                            </div>
                                        }
                                    }
                                    else if (normalizedStatus == "APPROVED")
                                    {
                                        <span class="badge status-badge-approved px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 11px; font-weight: 600; border-radius: 5px;">
                                            <i class="fa-solid fa-circle-check"></i> APPROVED
                                        </span>
                                        @if (!isAboveOneLakh)
                                        {
                                            <div class="text-success mt-1" style="font-size: 10.5px;">
                                                <i class="fa-solid fa-check-double me-1"></i>&le; &#8377;1 Lakh Direct Authority
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted mt-1" style="font-size: 10.5px;">
                                                <i class="fa-solid fa-shield-halved me-1"></i>Manager Authorized
                                            </div>
                                        }
                                    }
                                    else if (normalizedStatus == "MARKED_FOR_PAYMENT")
                                    {
                                        <span class="badge status-badge-payment px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 11px; font-weight: 600; border-radius: 5px;">
                                            <i class="fa-solid fa-file-invoice-dollar"></i> MARKED FOR PAYMENT
                                        </span>
                                        <div class="text-primary mt-1" style="font-size: 10.5px;">
                                            <i class="fa-solid fa-receipt me-1"></i>PO Bill Ready
                                        </div>
                                    }
                                    else if (normalizedStatus == "REJECTED")
                                    {
                                        <span class="badge status-badge-rejected px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 11px; font-weight: 600; border-radius: 5px;">
                                            <i class="fa-solid fa-circle-xmark"></i> REJECTED
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(po.RejectionReason))
                                        {
                                            <div class="text-danger mt-1 text-truncate" style="font-size: 10.5px; max-width: 140px;" title="@po.RejectionReason">
                                                <i class="fa-solid fa-comment-dots me-1"></i>@po.RejectionReason
                                            </div>
                                        }
                                    }
                                    else if (normalizedStatus == "PAID")
                                    {
                                        <span class="badge status-badge-paid px-2 py-1 shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 11px; font-weight: 600; border-radius: 5px;">
                                            <i class="fa-solid fa-money-check-dollar"></i> PAID
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1" style="font-size: 11px;">@po.ApprovalStatus</span>
                                    }
                                </td>

                                <!-- ========================================================= -->
                                <!-- 2. ACTIONS COLUMN (Approve, Reject, Mark for Payment) -->
                                <!-- ========================================================= -->
                                <td class="ps-3" style="width: 290px; min-width: 290px; white-space: nowrap;">
                                    <div class="d-flex gap-2 align-items-center justify-content-start flex-nowrap" style="white-space: nowrap;">
                                        <!-- View / Print PO Button (Always Visible, Standard Fixed Width) -->
                                        <a asp-controller="Procurement" asp-action="PrintPo" asp-route-id="@po.Id" target="_blank" class="btn btn-sm btn-outline-secondary shadow-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap flex-shrink-0" style="width: 68px; min-width: 68px; height: 32px; white-space: nowrap !important; font-size: 12px;" title="View &amp; Print PO">
                                            <i class="fa-solid fa-eye"></i> View
                                        </a>

                                        @if (normalizedStatus == "PENDING" || normalizedStatus == "PENDING_APPROVAL")
                                        {
                                            @if (canApprove)
                                            {
                                                <!-- Approve Action (Authorized Roles) -->
                                                <form asp-controller="Procurement" asp-action="ApprovePo" asp-route-id="@po.Id" method="post" class="d-inline m-0 flex-shrink-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success shadow-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap" style="min-width: 84px; height: 32px; white-space: nowrap !important; font-size: 12px;" title="Approve this Purchase Order">
                                                        <i class="fa-solid fa-check"></i> Approve
                                                    </button>
                                                </form>

                                                <!-- Reject Action (Opens Modal) -->
                                                <button type="button" class="btn btn-sm btn-outline-danger shadow-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap flex-shrink-0" style="min-width: 76px; height: 32px; white-space: nowrap !important; font-size: 12px;" data-bs-toggle="modal" data-bs-target="#rejectPoModal" data-poid="@po.Id" data-ponumber="@po.PoNumber" title="Reject this Purchase Order">
                                                    <i class="fa-solid fa-xmark"></i> Reject
                                                </button>
                                            }
                                            else
                                            {
                                                <!-- Non-approver view: Sent for Managerial / Approver Review -->
                                                <span class="badge border d-inline-flex align-items-center gap-1 text-muted shadow-sm flex-shrink-0" style="height: 32px; font-size: 11px; background: #F8FAFC; border-color: #CBD5E1; padding: 0 10px; font-weight: 500; white-space: nowrap !important;" title="@(isAboveOneLakh ? "Exceeds &#8377;1 Lakh threshold: Sent for Managerial Approval (Requires Project Manager or Admin)" : (isCreator ? "Created by you: Maker cannot self-approve (Awaiting reviewer)" : "Sent for Approval: Requires higher authorization"))">
                                                    <i class="fa-solid fa-paper-plane text-warning"></i> Sent for Approval
                                                </span>
                                            }
                                        }
                                        else if (normalizedStatus == "APPROVED")
                                        {
                                            <!-- Mark For Payment Action with attached split dropdown -->
                                            <form id="markPaymentForm_@po.Id" asp-controller="Procurement" asp-action="MarkForPayment" asp-route-id="@po.Id" method="post" class="d-none">
                                                @Html.AntiForgeryToken()
                                            </form>
                                            <div class="btn-group btn-group-sm shadow-sm flex-shrink-0" role="group">
                                                <button type="submit" form="markPaymentForm_@po.Id" class="btn btn-sm btn-primary d-inline-flex align-items-center justify-content-center gap-1 text-nowrap flex-shrink-0" style="background: #4F46E5; border-color: #4F46E5; height: 32px; white-space: nowrap !important; font-size: 12px; font-weight: 500; padding: 0 10px;" title="Mark this PO for payment processing &amp; generate PO Bill">
                                                    <i class="fa-solid fa-credit-card me-1"></i>Mark for Payment
                                                </button>
                                                <button type="button" class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split flex-shrink-0" style="background: #4338CA; border-color: #4338CA; height: 32px; padding: 0 8px;" data-bs-toggle="dropdown" aria-expanded="false" title="More options">
                                                    <span class="visually-hidden">Toggle Dropdown</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 12.5px;">
                                                    <li>
                                                        <button type="button" class="dropdown-item text-danger d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#rejectPoModal" data-poid="@po.Id" data-ponumber="@po.PoNumber">
                                                            <i class="fa-solid fa-xmark text-danger"></i> Reject PO
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <form asp-controller="Procurement" asp-action="SetPoStatus" asp-route-id="@po.Id" asp-route-status="PENDING_APPROVAL" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-warning d-flex align-items-center gap-2">
                                                                <i class="fa-solid fa-clock-rotate-left text-warning"></i> Revert to Pending
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                        else if (normalizedStatus == "MARKED_FOR_PAYMENT")
                                        {
                                            <!-- Direct action to Mark as Paid with attached split dropdown -->
                                            <form id="markPaidForm_@po.Id" asp-controller="Procurement" asp-action="SetPoStatus" asp-route-id="@po.Id" asp-route-status="PAID" method="post" class="d-none">
                                                @Html.AntiForgeryToken()
                                            </form>
                                            <div class="btn-group btn-group-sm shadow-sm flex-shrink-0" role="group">
                                                <button type="submit" form="markPaidForm_@po.Id" class="btn btn-sm btn-outline-success d-inline-flex align-items-center justify-content-center gap-1 text-nowrap flex-shrink-0" style="height: 32px; white-space: nowrap !important; font-size: 12px; font-weight: 500; padding: 0 10px;" title="Mark as Fully Paid">
                                                    <i class="fa-solid fa-receipt me-1"></i>Mark Paid
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle dropdown-toggle-split flex-shrink-0" style="height: 32px; padding: 0 8px;" data-bs-toggle="dropdown" aria-expanded="false" title="More options">
                                                    <span class="visually-hidden">Toggle Dropdown</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 12.5px;">
                                                    <li>
                                                        <form asp-controller="Procurement" asp-action="SetPoStatus" asp-route-id="@po.Id" asp-route-status="APPROVED" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-secondary d-flex align-items-center gap-2">
                                                                <i class="fa-solid fa-arrow-rotate-left"></i> Revert to Approved
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                        else if (normalizedStatus == "REJECTED")
                                        {
                                            <!-- Re-submit Action -->
                                            <form asp-controller="Procurement" asp-action="SetPoStatus" asp-route-id="@po.Id" asp-route-status="PENDING_APPROVAL" method="post" class="d-inline m-0 flex-shrink-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning shadow-sm d-inline-flex align-items-center justify-content-center gap-1 text-nowrap flex-shrink-0" style="min-width: 96px; height: 32px; white-space: nowrap !important; font-size: 12px;" title="Re-submit this PO for Managerial Approval">
                                                    <i class="fa-solid fa-arrow-rotate-left"></i> Re-submit
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <i class="fa-solid fa-cart-shopping mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                <h6 class="fw-bold text-secondary mb-1">No Purchase Orders in Database</h6>
                                <p class="text-muted mb-3" style="font-size: 12.5px;">No purchase orders or vendor bills have been registered yet.</p>
                                <a asp-controller="Procurement" asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--erp-primary);">
                                    <i class="fa-solid fa-plus me-1"></i> Add First Procurement Order
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- REJECT PURCHASE ORDER MODAL -->
<!-- ========================================================================= -->
<div class="modal fade" id="rejectPoModal" tabindex="-1" aria-labelledby="rejectPoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Procurement" asp-action="RejectPo">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectPoId" value="" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="rejectPoModalLabel" style="font-size: 15px;">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>Reject Purchase Order
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3 text-dark" style="font-size: 13.5px;">
                        Are you sure you want to reject PO <strong id="rejectPoNumber" class="text-danger"></strong>?
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 12.5px;">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea name="reason" id="rejectReasonInput" class="form-control" rows="3" placeholder="Enter reason (e.g. Budget exceeded, incorrect vendor quotation, quantity discrepancy)..." required></textarea>
                    </div>
                    <div class="p-2 rounded bg-light border text-muted" style="font-size: 11.5px;">
                        <i class="fa-solid fa-circle-info text-primary me-1"></i>
                        The initiator will be able to review this reason and revise or re-submit the order if permitted.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4">
                        <i class="fa-solid fa-xmark me-1"></i> Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- ISSUE PURCHASE ORDER MODAL (INTERACTIVE FORM) -->
<!-- ========================================================================= -->
<div class="modal fade" id="createPoModal" tabindex="-1" aria-labelledby="createPoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Procurement" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="createPoModalLabel" style="color: var(--erp-primary); font-size: 16px;">
                        <i class="fa-solid fa-file-signature me-2"></i>Issue Commercial Purchase Order
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">PO Number <span class="text-danger">*</span></label>
                            <input type="text" name="poNumber" class="form-control" value="PO/@DateTime.Now.ToString("yy-MM")/@DateTime.Now.ToString("HHmmss")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Initiator / Raised By Role <span class="text-danger">*</span></label>
                            <select name="raisedByRole" id="modalRaisedByRole" class="form-select">
                                <option value="ACCOUNTANT" selected>Accounts Department (Accountant)</option>
                                <option value="SUBORDINATE">Subordinate Staff (Procurement Officer / Team)</option>
                                <option value="ADMIN">Administrator / Top Management</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Supplier / Vendor <span class="text-danger">*</span></label>
                            <select name="vendorId" class="form-select" required>
                                <option value="">-- Select Vendor --</option>
                                @foreach (var v in vendors)
                                {
                                    <option value="@v.Id">@v.VendorName (@v.VendorCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Link to Project</label>
                            <select name="projectId" class="form-select">
                                <option value="">-- Optional (Direct Procurement) --</option>
                                @foreach (var p in projects)
                                {
                                    <option value="@p.Id">@p.ProjectCode - @p.ProjectName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">PO Date <span class="text-danger">*</span></label>
                            <input type="date" name="poDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">PO Type</label>
                            <select name="poType" class="form-select">
                                <option value="Standard Purchase Order" selected>Standard Purchase Order</option>
                                <option value="Work Order">Work Order</option>
                                <option value="Service PO">Service PO</option>
                                <option value="Direct Purchase">Direct Purchase</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Taxable Value (&#8377;) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" name="taxableAmount" id="poTaxableAmount" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Input GST Amount (&#8377;)</label>
                            <input type="number" step="0.01" min="0" name="gstAmount" id="poGstAmount" class="form-control" placeholder="0.00" />
                        </div>

                        <!-- Dynamic Workflow Preview Alert in Modal -->
                        <div class="col-12">
                            <div id="modalWorkflowNotice" class="p-2 rounded border" style="font-size: 12px; background: #F8FAFC; border-color: #E2E8F0;">
                                <i class="fa-solid fa-circle-info text-primary me-1"></i>
                                Enter amounts to calculate total value and determine the workflow routing.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="modalSubmitBtn" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-paper-plane me-1"></i> Issue Purchase Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // -------------------------------------------------------------
        // 1. Table Filter Pills (All / Pending / Approved / For Payment / Rejected)
        // -------------------------------------------------------------
        const filterBtns = document.querySelectorAll('.po-filter-btn');
        const poRows = document.querySelectorAll('.po-row');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                filterBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');
                poRows.forEach(row => {
                    const rowStatus = row.getAttribute('data-status');
                    if (filter === 'ALL') {
                        row.style.display = '';
                    } else if (filter === 'PENDING') {
                        row.style.display = (rowStatus === 'PENDING' || rowStatus === 'PENDING_APPROVAL') ? '' : 'none';
                    } else {
                        row.style.display = (rowStatus === filter) ? '' : 'none';
                    }
                });
            });
        });

        // -------------------------------------------------------------
        // 2. Reject Modal Handler (Populate PO Id and PO Number)
        // -------------------------------------------------------------
        const rejectModal = document.getElementById('rejectPoModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                const poId = button.getAttribute('data-poid');
                const poNumber = button.getAttribute('data-ponumber');

                document.getElementById('rejectPoId').value = poId || '';
                document.getElementById('rejectPoNumber').textContent = poNumber || '';
                document.getElementById('rejectReasonInput').value = '';
            });
        }

        // -------------------------------------------------------------
        // 3. Modal Real-time Tax and Threshold Calculation
        // -------------------------------------------------------------
        const taxableInput = document.getElementById('poTaxableAmount');
        const gstInput = document.getElementById('poGstAmount');
        const raisedBySelect = document.getElementById('modalRaisedByRole');
        const workflowNotice = document.getElementById('modalWorkflowNotice');
        const submitBtn = document.getElementById('modalSubmitBtn');

        function updateModalWorkflowPreview() {
            if (!taxableInput || !workflowNotice) return;

            const taxable = parseFloat(taxableInput.value) || 0;
            const gst = parseFloat(gstInput ? gstInput.value : 0) || 0;
            const total = taxable + gst;
            const role = raisedBySelect ? raisedBySelect.value : 'ACCOUNTANT';

            if (total <= 0) {
                workflowNotice.className = "p-2 rounded border bg-light text-muted";
                workflowNotice.innerHTML = '<i class="fa-solid fa-circle-info text-primary me-1"></i> Enter amounts to calculate total value and determine the approval routing.';
                return;
            }

            if (role === 'SUBORDINATE') {
                workflowNotice.className = "p-2 rounded border text-warning-emphasis";
                workflowNotice.style.background = "#FEF3C7";
                workflowNotice.style.borderColor = "#FDE68A";
                workflowNotice.innerHTML = `<strong><i class="fa-solid fa-clock-rotate-left me-1"></i> ROUTED FOR APPROVAL (Total: ₹${total.toLocaleString('en-IN', {minimumFractionDigits: 2})}):</strong> Orders raised by subordinate staff always require managerial approval.`;
                if (submitBtn) submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Submit for Managerial Approval';
            } else if (role === 'ACCOUNTANT') {
                if (total <= 100000) {
                    workflowNotice.className = "p-2 rounded border text-success-emphasis";
                    workflowNotice.style.background = "#D1FAE5";
                    workflowNotice.style.borderColor = "#A7F3D0";
                    workflowNotice.innerHTML = `<strong><i class="fa-solid fa-circle-check me-1"></i> DIRECT PO BILL CREATION (Total: ₹${total.toLocaleString('en-IN', {minimumFractionDigits: 2})}):</strong> Within the ₹1,00,000 (1 Lakh) threshold. Direct approval & PO Bill creation permitted for Accounts.`;
                    if (submitBtn) submitBtn.innerHTML = '<i class="fa-solid fa-file-circle-check me-1"></i> Issue &amp; Direct Approve';
                } else {
                    workflowNotice.className = "p-2 rounded border text-danger-emphasis";
                    workflowNotice.style.background = "#FEE2E2";
                    workflowNotice.style.borderColor = "#FECACA";
                    workflowNotice.innerHTML = `<strong><i class="fa-solid fa-triangle-exclamation me-1"></i> APPROVAL REQUIRED (Total: ₹${total.toLocaleString('en-IN', {minimumFractionDigits: 2})}):</strong> Exceeds ₹1,00,000 (1 Lakh). Accounts requires managerial approval before PO Bill issuance.`;
                    if (submitBtn) submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Submit for Managerial Approval';
                }
            } else {
                // ADMIN
                workflowNotice.className = "p-2 rounded border text-success-emphasis";
                workflowNotice.style.background = "#D1FAE5";
                workflowNotice.style.borderColor = "#A7F3D0";
                workflowNotice.innerHTML = `<strong><i class="fa-solid fa-crown me-1"></i> DIRECT APPROVAL (Total: ₹${total.toLocaleString('en-IN', {minimumFractionDigits: 2})}):</strong> Top management / Administrator authority applies. Direct approval granted.`;
                if (submitBtn) submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Issue &amp; Approve Purchase Order';
            }
        }

        if (taxableInput && gstInput) {
            taxableInput.addEventListener('input', function () {
                const val = parseFloat(this.value);
                if (!isNaN(val) && val > 0) {
                    gstInput.value = (val * 0.18).toFixed(2);
                } else {
                    gstInput.value = '';
                }
                updateModalWorkflowPreview();
            });
            gstInput.addEventListener('input', updateModalWorkflowPreview);
        }

        if (raisedBySelect) {
            raisedBySelect.addEventListener('change', updateModalWorkflowPreview);
        }
    });
</script>
}
