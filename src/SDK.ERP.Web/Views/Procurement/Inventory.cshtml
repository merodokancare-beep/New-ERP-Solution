@model IEnumerable<SDK.ERP.Domain.Entities.MasterData.Item>
@{
    ViewData["Title"] = "Office & Materials Inventory";
    ViewData["ActiveMenu"] = "Procurement";
    var items = Model ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.Item>();
    var totalItems = items.Count();
    var totalStockUnits = items.Sum(i => i.CurrentStockQty);
    var totalValuation = items.Sum(i => i.CurrentStockQty * i.UnitCost);
    var lowStockCount = items.Count(i => i.CurrentStockQty <= i.ReorderLevelQty);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 style="font-weight: 700; color: var(--erp-primary); margin-bottom: 4px;">
            <i class="fa-solid fa-boxes-stacked me-2"></i>Office &amp; Materials Inventory
        </h3>
        <p style="color: var(--erp-text-muted); margin: 0; font-size: 13.5px;">
            Stock Inward Receipts &bull; Reorder Level Monitoring &bull; Multi-Category Valuation &bull; Real-Time Inventory Control
        </p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm px-3 shadow-sm" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> Print Stock Sheet
        </button>
        <button class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createItemModal">
            <i class="fa-solid fa-plus me-1"></i> Add Inventory Item
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
        <div>@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
        <div>@Html.Raw(TempData["ErrorMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Metric Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <small class="text-muted fw-bold" style="font-size: 11px;">CATALOG ITEMS</small>
                <span class="badge bg-primary-subtle text-primary"><i class="fa-solid fa-tags"></i></span>
            </div>
            <div class="fs-4 fw-bold text-dark">@totalItems</div>
            <small class="text-muted" style="font-size: 11.5px;">Registered Stock SKUs</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <small class="text-muted fw-bold" style="font-size: 11px;">TOTAL UNITS IN HAND</small>
                <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-cubes"></i></span>
            </div>
            <div class="fs-4 fw-bold text-success">@totalStockUnits.ToString("N0")</div>
            <small class="text-muted" style="font-size: 11.5px;">Physical Stock Count</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <small class="text-muted fw-bold" style="font-size: 11px;">TOTAL STOCK VALUATION</small>
                <span class="badge bg-info-subtle text-info"><i class="fa-solid fa-indian-rupee-sign"></i></span>
            </div>
            <div class="fs-4 fw-bold text-primary">&#8377; @totalValuation.ToString("N2")</div>
            <small class="text-muted" style="font-size: 11.5px;">At Weighted Unit Cost</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <small class="text-muted fw-bold" style="font-size: 11px;">REORDER ALERTS</small>
                <span class="badge bg-warning-subtle text-warning"><i class="fa-solid fa-triangle-exclamation"></i></span>
            </div>
            <div class="fs-4 fw-bold @(lowStockCount > 0 ? "text-danger" : "text-success")">@lowStockCount</div>
            <small class="text-muted" style="font-size: 11.5px;">Items At/Below Reorder Level</small>
        </div>
    </div>
</div>

<!-- Stock Items Table -->
<div class="erp-card shadow-sm border">
    <div class="erp-card-header d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 bg-white border-bottom">
        <h5 class="erp-card-title m-0 fw-bold text-dark">
            <i class="fa-solid fa-warehouse me-2 text-primary"></i>Stock Items Register &amp; Levels
        </h5>
        <div class="d-flex align-items-center gap-2">
            <input type="text" id="inventorySearch" class="form-control form-control-sm" placeholder="Filter by code or name..." style="max-width: 220px;" />
        </div>
    </div>
    <div class="erp-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="inventoryTable" style="font-size: 13px;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Item Code</th>
                        <th>Item Description</th>
                        <th>Category</th>
                        <th>UOM</th>
                        <th class="text-end">Current Stock</th>
                        <th class="text-end">Reorder Point</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Valuation</th>
                        <th class="text-center pe-4">Stock Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        @foreach (var itm in items)
                        {
                            var isLow = itm.CurrentStockQty <= itm.ReorderLevelQty;
                            var val = itm.CurrentStockQty * itm.UnitCost;
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@itm.ItemCode</td>
                                <td>
                                    <div class="fw-semibold text-dark">@itm.ItemName</div>
                                    @if (!string.IsNullOrEmpty(itm.HsnSacCode))
                                    {
                                        <small class="text-muted">HSN/SAC: <code>@itm.HsnSacCode</code></small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@(itm.Category?.CategoryName ?? "General")</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@(itm.Unit?.UnitName ?? "NOS")</span></td>
                                <td class="text-end fw-bold @(isLow ? "text-danger" : "text-dark")">@itm.CurrentStockQty.ToString("N0")</td>
                                <td class="text-end text-muted">@itm.ReorderLevelQty.ToString("N0")</td>
                                <td class="text-end">&#8377; @itm.UnitCost.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">&#8377; @val.ToString("N2")</td>
                                <td class="text-center pe-4">
                                    @if (itm.CurrentStockQty == 0)
                                    {
                                        <span class="badge bg-danger">OUT OF STOCK</span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i>REORDER NEEDED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>OPTIMAL</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-boxes-stacked mb-2" style="font-size: 32px; color: #CBD5E1;"></i>
                                <h6 class="fw-bold text-secondary mb-1">No Inventory Items in Current Organization</h6>
                                <p class="mb-0" style="font-size: 12.5px;">Add inventory items or receive goods to build your real-time stock register.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Inventory Item -->
<div class="modal fade" id="createItemModal" tabindex="-1" aria-labelledby="createItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #0284C7, #0EA5E9);">
                <h5 class="modal-title fw-bold" id="createItemModalLabel"><i class="fa-solid fa-box-open me-2"></i>Add Inventory Item</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-controller="Masters" asp-action="CreateItem">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item / SKU Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control text-uppercase" name="itemCode" placeholder="e.g. ITM-RAW-001" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item Name &amp; Description <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="itemName" placeholder="e.g. Fiber Optic Transceiver Module" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Standard Unit Cost (&#8377;) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" name="unitCost" placeholder="0.00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Reorder Alert Level Qty <span class="text-danger">*</span></label>
                            <input type="number" step="1" min="0" class="form-control" name="reorderLevelQty" placeholder="0" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save to Inventory
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('inventorySearch');
        const table = document.getElementById('inventoryTable');
        if (searchInput && table) {
            searchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase();
                const rows = table.querySelectorAll('tbody tr');
                rows.forEach(r => {
                    r.style.display = r.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        }
    });
</script>
}
