@model SDK.ERP.Application.ViewModels.MastersViewModel
@{
    ViewData["Title"] = "Masters & System Configuration";
    ViewData["ActiveMenu"] = "Masters";
    var clients = Model?.Clients ?? new();
    var vendors = Model?.Vendors ?? new();
    var items = Model?.Items ?? new();
    var taxRates = Model?.TaxRates ?? new();
    var accountGroups = Model?.AccountGroups ?? new();
    var projectTypes = Model?.ProjectTypes ?? new();
    var expenseTypes = Model?.ExpenseTypes ?? new();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 style="font-weight: 700; color: var(--erp-primary); margin-bottom: 4px;">Masters &amp; Configuration</h3>
        <p style="color: var(--erp-text-muted); margin: 0; font-size: 13.5px;">Centralized Master Repository &bull; Zero Data Duplication Architecture</p>
    </div>
    <div class="d-flex gap-2">
        <button id="btnGlobalAddRecord" class="btn btn-primary btn-sm px-3 shadow-sm d-inline-flex align-items-center" style="background: var(--erp-primary); border-color: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createClientModal">
            <i class="fa-solid fa-plus me-1"></i> <span id="btnGlobalAddRecordText">Add Client</span>
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
        <div>@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Nav Tabs for Masters (Dynamic Counts) -->
<ul class="nav nav-pills mb-4 gap-2" id="masterTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="clients-tab" data-bs-toggle="pill" data-bs-target="#clients" type="button" role="tab">
            <i class="fa-solid fa-user-tie me-2"></i>Clients (@clients.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="vendors-tab" data-bs-toggle="pill" data-bs-target="#vendors" type="button" role="tab">
            <i class="fa-solid fa-truck-field me-2"></i>Vendors (@vendors.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="items-tab" data-bs-toggle="pill" data-bs-target="#items" type="button" role="tab">
            <i class="fa-solid fa-box-archive me-2"></i>Consumable Items (@items.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="tax-tab" data-bs-toggle="pill" data-bs-target="#tax" type="button" role="tab">
            <i class="fa-solid fa-percent me-2"></i>GST Tax Slabs (@taxRates.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="coa-tab" data-bs-toggle="pill" data-bs-target="#coa" type="button" role="tab">
            <i class="fa-solid fa-sitemap me-2"></i>Chart of Accounts (@accountGroups.Count Groups)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="projecttypes-tab" data-bs-toggle="pill" data-bs-target="#projecttypes" type="button" role="tab">
            <i class="fa-solid fa-diagram-project me-2"></i>Project Types (@projectTypes.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="expensetypes-tab" data-bs-toggle="pill" data-bs-target="#expensetypes" type="button" role="tab">
            <i class="fa-solid fa-receipt me-2"></i>Expense Types (@expenseTypes.Count)
        </button>
    </li>
</ul>

<div class="tab-content" id="masterTabsContent">
    <!-- 1. Clients Tab -->
    <div class="tab-pane fade show active" id="clients" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header d-flex justify-content-between align-items-center">
                <h5 class="erp-card-title"><i class="fa-solid fa-users me-2"></i>Client Master Directory</h5>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createClientModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Client
                </button>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4">Client Code</th>
                                <th>Client Name</th>
                                <th>GSTIN</th>
                                <th>State</th>
                                <th>Credit Terms</th>
                                <th>Credit Limit</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @if (clients.Any())
                            {
                                @foreach (var c in clients)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@c.ClientCode</td>
                                        <td><strong>@c.ClientName</strong><br><small class="text-muted">@(c.Email ?? c.ContactPerson ?? "N/A")</small></td>
                                        <td><code>@(c.Gstin ?? "Unregistered")</code></td>
                                        <td><span class="badge bg-light text-dark border">@c.StateCode</span></td>
                                        <td>@c.CreditDays Days</td>
                                        <td>&#8377; @c.CreditLimit.ToString("N2")</td>
                                        <td><span class="badge bg-success">Active</span></td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary" title="Edit Client Details" data-bs-toggle="modal" data-bs-target="#editClientModal_@c.Id">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Edit Client Modal -->
                                    <div class="modal fade" id="editClientModal_@c.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-lg">
                                            <div class="modal-content border-0 shadow">
                                                <form method="post" asp-controller="Masters" asp-action="EditClient">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@c.Id" />
                                                    <div class="modal-header bg-light">
                                                        <h5 class="modal-title fw-bold" style="color: var(--erp-primary); font-size: 16px;">
                                                            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Client Details: @c.ClientCode
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Client Code</label>
                                                                <input type="text" class="form-control bg-light" value="@c.ClientCode" readonly />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Client / Company Name <span class="text-danger">*</span></label>
                                                                <input type="text" name="clientName" class="form-control" value="@c.ClientName" required />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">GSTIN</label>
                                                                <input type="text" name="gstin" class="form-control" value="@c.Gstin" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">PAN</label>
                                                                <input type="text" name="pan" class="form-control" value="@c.Pan" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Contact Person</label>
                                                                <input type="text" name="contactPerson" class="form-control" value="@c.ContactPerson" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Phone / Mobile</label>
                                                                <input type="text" name="phone" class="form-control" value="@c.Phone" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Email</label>
                                                                <input type="email" name="email" class="form-control" value="@c.Email" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Credit Limit (&#8377;)</label>
                                                                <input type="number" step="0.01" name="creditLimit" class="form-control" value="@c.CreditLimit" />
                                                            </div>
                                                            <div class="col-12">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Billing Address <span class="text-danger">*</span></label>
                                                                <textarea name="billingAddress" class="form-control" rows="2" required>@c.BillingAddress</textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                                                            <i class="fa-solid fa-save me-1"></i> Update Client Details
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <i class="fa-solid fa-user-tie mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                        <h6 class="fw-bold text-secondary mb-1">No Clients in Database</h6>
                                        <p class="text-muted mb-3" style="font-size: 12.5px;">Register your enterprise clients to issue project quotations and tax invoices.</p>
                                        <button class="btn btn-primary btn-sm px-3" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createClientModal">
                                            <i class="fa-solid fa-plus me-1"></i> Register First Client
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Vendors Tab -->
    <div class="tab-pane fade" id="vendors" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header d-flex justify-content-between align-items-center">
                <h5 class="erp-card-title"><i class="fa-solid fa-truck-field me-2"></i>Vendor Directory</h5>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createVendorModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Vendor
                </button>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4">Vendor Code</th>
                                <th>Vendor Name</th>
                                <th>Category</th>
                                <th>GSTIN</th>
                                <th>PAN</th>
                                <th>MSME Type</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @if (vendors.Any())
                            {
                                @foreach (var v in vendors)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@v.VendorCode</td>
                                        <td><strong>@v.VendorName</strong></td>
                                        <td><span class="badge bg-light text-dark border">@v.VendorCategory</span></td>
                                        <td><code>@(v.Gstin ?? "N/A")</code></td>
                                        <td>@v.Pan</td>
                                        <td><span class="badge @(v.MsmeType != null ? "bg-info" : "bg-light text-muted border")">@(v.MsmeType ?? "Non-MSME")</span></td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editVendorModal_@v.Id">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Edit Vendor Modal -->
                                    <div class="modal fade" id="editVendorModal_@v.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-lg">
                                            <div class="modal-content border-0 shadow">
                                                <form method="post" asp-controller="Masters" asp-action="EditVendor">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@v.Id" />
                                                    <div class="modal-header bg-light">
                                                        <h5 class="modal-title fw-bold" style="color: var(--erp-primary); font-size: 16px;">
                                                            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Vendor: @v.VendorCode
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Vendor Code</label>
                                                                <input type="text" class="form-control bg-light" value="@v.VendorCode" readonly />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Vendor Name <span class="text-danger">*</span></label>
                                                                <input type="text" name="vendorName" class="form-control" value="@v.VendorName" required />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">GSTIN</label>
                                                                <input type="text" name="gstin" class="form-control" value="@v.Gstin" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">PAN</label>
                                                                <input type="text" name="pan" class="form-control" value="@v.Pan" />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Category</label>
                                                                <select name="vendorCategory" class="form-select">
                                                                    <option value="HARDWARE" selected="@(v.VendorCategory == "HARDWARE")">Hardware &amp; Equipment</option>
                                                                    <option value="SERVICES" selected="@(v.VendorCategory == "SERVICES")">Services &amp; Subcontractors</option>
                                                                    <option value="GENERAL" selected="@(v.VendorCategory == "GENERAL")">General Consumables</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">MSME Classification</label>
                                                                <select name="msmeType" class="form-select">
                                                                    <option value="" selected="@(string.IsNullOrEmpty(v.MsmeType))">Non-MSME (Standard 30 Days)</option>
                                                                    <option value="MICRO" selected="@(v.MsmeType == "MICRO")">Micro Enterprise (45-Day Rule)</option>
                                                                    <option value="SMALL" selected="@(v.MsmeType == "SMALL")">Small Enterprise (45-Day Rule)</option>
                                                                    <option value="MEDIUM" selected="@(v.MsmeType == "MEDIUM")">Medium Enterprise</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                                                            <i class="fa-solid fa-save me-1"></i> Update Vendor
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="fa-solid fa-truck-field mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                        <h6 class="fw-bold text-secondary mb-1">No Vendors in Database</h6>
                                        <p class="text-muted mb-3" style="font-size: 12.5px;">Register suppliers and contractors to issue purchase orders and bills.</p>
                                        <button class="btn btn-primary btn-sm px-3" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createVendorModal">
                                            <i class="fa-solid fa-plus me-1"></i> Register First Vendor
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Consumable Items Tab -->
    <div class="tab-pane fade" id="items" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header d-flex justify-content-between align-items-center">
                <h5 class="erp-card-title"><i class="fa-solid fa-box-archive me-2"></i>Item Master &amp; Office Consumables</h5>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createItemModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Item
                </button>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4">Item Code</th>
                                <th>Item Name</th>
                                <th>Category</th>
                                <th>Unit Cost</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @if (items.Any())
                            {
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@item.ItemCode</td>
                                        <td><strong>@item.ItemName</strong></td>
                                        <td>@(item.Category?.CategoryName ?? "General")</td>
                                        <td>&#8377; @item.UnitCost.ToString("N2")</td>
                                        <td class="fw-bold @(item.CurrentStockQty <= item.ReorderLevelQty ? "text-danger" : "text-success")">
                                            @item.CurrentStockQty @(item.Unit?.UnitCode ?? "NOS")
                                        </td>
                                        <td>@item.ReorderLevelQty @(item.Unit?.UnitCode ?? "NOS")</td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editItemModal_@item.Id">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Edit Item Modal -->
                                    <div class="modal fade" id="editItemModal_@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-lg">
                                            <div class="modal-content border-0 shadow">
                                                <form method="post" asp-controller="Masters" asp-action="EditItem">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <div class="modal-header bg-light">
                                                        <h5 class="modal-title fw-bold" style="color: var(--erp-primary); font-size: 16px;">
                                                            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Item: @item.ItemCode
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Item Code</label>
                                                                <input type="text" class="form-control bg-light" value="@item.ItemCode" readonly />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Item Name <span class="text-danger">*</span></label>
                                                                <input type="text" name="itemName" class="form-control" value="@item.ItemName" required />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Unit Cost (&#8377;) <span class="text-danger">*</span></label>
                                                                <input type="number" step="0.01" name="unitCost" class="form-control" value="@item.UnitCost" required />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-semibold" style="font-size: 12.5px;">Minimum Reorder Level Qty</label>
                                                                <input type="number" step="1" name="reorderLevelQty" class="form-control" value="@item.ReorderLevelQty" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                                                            <i class="fa-solid fa-save me-1"></i> Update Item
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="fa-solid fa-box-archive mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                        <h6 class="fw-bold text-secondary mb-1">No Items in Catalog</h6>
                                        <p class="text-muted mb-3" style="font-size: 12.5px;">Add office consumable items and materials to track inventory levels.</p>
                                        <button class="btn btn-primary btn-sm px-3" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createItemModal">
                                            <i class="fa-solid fa-plus me-1"></i> Add First Item
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. GST Tax Slabs Tab (Seeded Data) -->
    <div class="tab-pane fade" id="tax" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header">
                <h5 class="erp-card-title"><i class="fa-solid fa-percent me-2"></i>Statutory Indian GST Tax Slabs</h5>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4">Tax Name</th>
                                <th>Total GST %</th>
                                <th>CGST Rate</th>
                                <th>SGST Rate</th>
                                <th>IGST Rate</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @foreach (var rate in taxRates)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@rate.TaxName</td>
                                    <td class="fw-bold">@rate.RatePercentage.ToString("0.##")%</td>
                                    <td>@rate.CgstPercentage.ToString("0.##")%</td>
                                    <td>@rate.SgstPercentage.ToString("0.##")%</td>
                                    <td>@rate.IgstPercentage.ToString("0.##")%</td>
                                    <td><span class="badge bg-success">Active Slab</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Chart of Accounts Tab (Seeded Data) -->
    <div class="tab-pane fade" id="coa" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header">
                <h5 class="erp-card-title"><i class="fa-solid fa-sitemap me-2"></i>Double-Entry Chart of Accounts Architecture</h5>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4">Group Code</th>
                                <th>Account Group Name</th>
                                <th>Accounting Category</th>
                                <th>Sub-Accounts</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @foreach (var g in accountGroups)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@g.GroupCode</td>
                                    <td><strong>@g.GroupName</strong></td>
                                    <td><span class="badge bg-light text-dark border">@g.AccountCategory</span></td>
                                    <td>@g.Accounts.Count Active Ledgers</td>
                                    <td><span class="badge bg-success">System Group</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Project Types Tab -->
    <div class="tab-pane fade" id="projecttypes" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header d-flex justify-content-between align-items-center">
                <h5 class="erp-card-title"><i class="fa-solid fa-diagram-project me-2"></i>Project Types Master Directory</h5>
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createProjectTypeModal">
                    <i class="fa-solid fa-plus me-1"></i> Add Project Type
                </button>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4">Code</th>
                                <th>Project Type Name</th>
                                <th>Description / Scope</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @if (projectTypes.Any())
                            {
                                @foreach (var pt in projectTypes)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@pt.Code</td>
                                        <td><strong>@pt.Name</strong></td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(pt.Description) ? "Standard contract classification" : pt.Description)</td>
                                        <td>
                                            @if (pt.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">ACTIVE</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">INACTIVE</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <form method="post" asp-controller="Masters" asp-action="ToggleProjectType" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@pt.Id" />
                                                <button type="submit" class="btn btn-sm @(pt.IsActive ? "btn-outline-danger" : "btn-outline-success") px-2 py-1" style="font-size: 11.5px;">
                                                    <i class="fa-solid @(pt.IsActive ? "fa-ban" : "fa-check") me-1"></i> @(pt.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <i class="fa-solid fa-diagram-project mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                        <h6 class="fw-bold text-secondary mb-1">No Project Types Configured</h6>
                                        <p class="text-muted mb-3" style="font-size: 12.5px;">Add custom project contract classifications for your enterprise.</p>
                                        <button class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createProjectTypeModal">
                                            <i class="fa-solid fa-plus me-1"></i> Add First Project Type
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. Expense Types Tab -->
    <div class="tab-pane fade" id="expensetypes" role="tabpanel">
        <div class="erp-card">
            <div class="erp-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="erp-card-title mb-0"><i class="fa-solid fa-receipt me-2"></i>Expense Types Master Directory</h5>
                    <small class="text-muted" style="font-size: 11.5px;">Manage accounting expense heads, direct payment categories, and project associations</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="width: 240px;">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted" style="font-size: 11px;"></i></span>
                        <input type="text" id="expenseTypeSearchInput" class="form-control border-start-0" placeholder="Filter expense types..." style="font-size: 12.5px;" />
                    </div>
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createExpenseTypeModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Expense Type
                    </button>
                </div>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="expenseTypesTable">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase;">
                                <th class="ps-4" style="width: 26%;">Expense Type Name</th>
                                <th style="width: 24%;">Classification / Scope</th>
                                <th style="width: 25%;">Description</th>
                                <th class="text-center" style="width: 13%;">Opening Amount</th>
                                <th class="text-center" style="width: 12%;">Status</th>
                                <th class="text-end pe-4" style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 13.5px;">
                            @if (expenseTypes.Any())
                            {
                                @foreach (var exp in expenseTypes)
                                {
                                    <tr class="expense-type-row" data-name="@exp.Name.ToLower()" data-desc="@(exp.Description?.ToLower() ?? "")">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@exp.Name</div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1" style="font-size: 12px;">
                                                <div>
                                                    <span class="text-muted me-1">Project Related:</span>
                                                    @if (exp.IsProjectRelated)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border px-2 py-0">No</span>
                                                    }
                                                </div>
                                                <div>
                                                    <span class="text-muted me-1">Direct Receipts:</span>
                                                    @if (exp.ReceiveDirectPayments)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border px-2 py-0">No</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted" style="font-size: 12.5px;">
                                            @(string.IsNullOrWhiteSpace(exp.Description) ? "—" : exp.Description)
                                        </td>
                                        <td class="text-center">
                                            @if (exp.OpeningAmount.HasValue && exp.OpeningAmount.Value > 0)
                                            {
                                                <span class="fw-bold text-dark">&#8377; @exp.OpeningAmount.Value.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">N/A</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (exp.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">ACTIVE</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">INACTIVE</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-inline-flex gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1 edit-exp-btn" title="Edit Expense Type"
                                                        data-id="@exp.Id"
                                                        data-name="@exp.Name"
                                                        data-desc="@(exp.Description ?? "")"
                                                        data-isproject="@exp.IsProjectRelated.ToString().ToLower()"
                                                        data-isdirect="@exp.ReceiveDirectPayments.ToString().ToLower()"
                                                        data-opening="@(exp.OpeningAmount?.ToString() ?? "")">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <form method="post" asp-controller="Masters" asp-action="ToggleExpenseType" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@exp.Id" />
                                                    <button type="submit" class="btn btn-sm @(exp.IsActive ? "btn-outline-warning" : "btn-outline-success") px-2 py-1" title="@(exp.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="fa-solid @(exp.IsActive ? "fa-ban" : "fa-check")"></i>
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1 delete-exp-btn" title="Delete Expense Type"
                                                        data-id="@exp.Id"
                                                        data-name="@exp.Name">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <i class="fa-solid fa-receipt mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                        <h6 class="fw-bold text-secondary mb-1">No Expense Types Configured</h6>
                                        <p class="text-muted mb-3" style="font-size: 12.5px;">Configure expense and direct payment heads for your company.</p>
                                        <button class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createExpenseTypeModal">
                                            <i class="fa-solid fa-plus me-1"></i> Add First Expense Type
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

