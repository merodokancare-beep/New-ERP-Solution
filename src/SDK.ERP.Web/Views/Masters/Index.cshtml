<div class="modal fade" id="createClientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Masters" asp-action="CreateClient">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" style="color: var(--erp-primary); font-size: 16px;">
                        <i class="fa-solid fa-user-tie me-2"></i>Register Enterprise Client
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Client Code <span class="text-danger">*</span></label>
                            <input type="text" name="clientCode" class="form-control" value="CL-@DateTime.Now.ToString("MMddHHmm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Client / Company Name <span class="text-danger">*</span></label>
                            <input type="text" name="clientName" id="createClientName" class="form-control" placeholder="e.g. Reliance Infra Ltd" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold d-flex justify-content-between align-items-center" style="font-size: 12.5px;">
                                <span>GSTIN</span>
                                <span class="text-muted" style="font-size: 11px;"><i class="fa-solid fa-bolt text-warning me-1"></i>Auto-fills PAN &amp; Details</span>
                            </label>
                            <div class="input-group">
                                <input type="text" name="gstin" id="createClientGstin" class="form-control text-uppercase gstin-lookup-input" placeholder="e.g. 07AAAAA0000A1Z5" maxlength="15" autocomplete="off" />
                                <button class="btn btn-outline-primary" type="button" id="btnFetchClientGstin" title="Auto-Fetch Client details from GSTIN">
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Auto-Fetch
                                </button>
                            </div>
                            <div id="clientGstinFeedback" class="mt-1" style="font-size: 11.5px; display: none;"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">PAN</label>
                            <input type="text" name="pan" id="createClientPan" class="form-control text-uppercase" placeholder="e.g. AAAAA0000A" maxlength="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Contact Person</label>
                            <input type="text" name="contactPerson" id="createClientContactPerson" class="form-control" placeholder="e.g. Procurement Lead" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Phone / Mobile</label>
                            <input type="text" name="phone" id="createClientPhone" class="form-control" placeholder="e.g. +91 98765 43210" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Billing Address <span class="text-danger">*</span></label>
                            <textarea name="billingAddress" id="createClientAddress" class="form-control" rows="2" placeholder="Complete statutory billing address..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-check me-1"></i> Save Client
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- CREATE VENDOR MODAL -->
<!-- ========================================================================= -->
<div class="modal fade" id="createVendorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Masters" asp-action="CreateVendor">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" style="color: var(--erp-primary); font-size: 16px;">
                        <i class="fa-solid fa-truck-field me-2"></i>Register Supplier / Vendor
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Vendor Code <span class="text-danger">*</span></label>
                            <input type="text" name="vendorCode" class="form-control" value="VEN-@DateTime.Now.ToString("MMddHHmm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Vendor Name <span class="text-danger">*</span></label>
                            <input type="text" name="vendorName" id="createVendorName" class="form-control" placeholder="e.g. Apex Hardware Supplies" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold d-flex justify-content-between align-items-center" style="font-size: 12.5px;">
                                <span>GSTIN</span>
                                <span class="text-muted" style="font-size: 11px;"><i class="fa-solid fa-bolt text-warning me-1"></i>Auto-fills PAN &amp; Details</span>
                            </label>
                            <div class="input-group">
                                <input type="text" name="gstin" id="createVendorGstin" class="form-control text-uppercase gstin-lookup-input" placeholder="e.g. 07AAAAA0000A1Z5" maxlength="15" autocomplete="off" />
                                <button class="btn btn-outline-primary" type="button" id="btnFetchVendorGstin" title="Auto-Fetch Vendor details from GSTIN">
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Auto-Fetch
                                </button>
                            </div>
                            <div id="vendorGstinFeedback" class="mt-1" style="font-size: 11.5px; display: none;"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">PAN</label>
                            <input type="text" name="pan" id="createVendorPan" class="form-control text-uppercase" placeholder="e.g. AAAAA0000A" maxlength="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Category</label>
                            <select name="vendorCategory" id="createVendorCategory" class="form-select">
                                <option value="HARDWARE" selected>Hardware &amp; Equipment</option>
                                <option value="SERVICES">Services &amp; Subcontractors</option>
                                <option value="GENERAL">General Consumables</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">MSME Classification</label>
                            <select name="msmeType" id="createVendorMsmeType" class="form-select">
                                <option value="">Non-MSME (Standard 30 Days)</option>
                                <option value="MICRO">Micro Enterprise (45-Day Rule)</option>
                                <option value="SMALL">Small Enterprise (45-Day Rule)</option>
                                <option value="MEDIUM">Medium Enterprise</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-check me-1"></i> Save Vendor
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- CREATE ITEM MODAL -->
<!-- ========================================================================= -->
<div class="modal fade" id="createItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Masters" asp-action="CreateItem">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" style="color: var(--erp-primary); font-size: 16px;">
                        <i class="fa-solid fa-box-archive me-2"></i>Add Consumable Item
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Item Code <span class="text-danger">*</span></label>
                            <input type="text" name="itemCode" class="form-control" value="ITM-@DateTime.Now.ToString("MMddHHmm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Item Name <span class="text-danger">*</span></label>
                            <input type="text" name="itemName" class="form-control" placeholder="e.g. Cat6 Ethernet Cable (305m Roll)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Unit Cost (&#8377;) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" name="unitCost" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Minimum Reorder Level Qty</label>
                            <input type="number" step="1" min="0" name="reorderLevelQty" class="form-control" placeholder="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-check me-1"></i> Save Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        // Highlight animation helper
        function flashField(el) {
            if (!el) return;
            el.style.transition = 'all 0.35s ease';
            el.style.backgroundColor = '#EFF6FF';
            el.style.borderColor = '#3B82F6';
            setTimeout(() => {
                el.style.backgroundColor = '';
                el.style.borderColor = '';
            }, 1200);
        }

        // Generic GSTIN Auto-fetch function
        async function lookupGstin(gstinVal, targetType) {
            const cleanGstin = (gstinVal || '').trim().toUpperCase();
            const feedbackEl = document.getElementById(targetType === 'vendor' ? 'vendorGstinFeedback' : 'clientGstinFeedback');
            const nameEl = document.getElementById(targetType === 'vendor' ? 'createVendorName' : 'createClientName');
            const panEl = document.getElementById(targetType === 'vendor' ? 'createVendorPan' : 'createClientPan');
            const categoryEl = targetType === 'vendor' ? document.getElementById('createVendorCategory') : null;
            const msmeEl = targetType === 'vendor' ? document.getElementById('createVendorMsmeType') : null;
            const addrEl = targetType === 'client' ? document.getElementById('createClientAddress') : null;
            const contactEl = targetType === 'client' ? document.getElementById('createClientContactPerson') : null;
            const phoneEl = targetType === 'client' ? document.getElementById('createClientPhone') : null;

            if (!cleanGstin || cleanGstin.length !== 15) {
                if (feedbackEl) {
                    feedbackEl.style.display = 'block';
                    feedbackEl.innerHTML = '<span class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i> GSTIN must be exactly 15 alphanumeric characters.</span>';
                }
                return;
            }

            // Immediately derive 10-digit PAN from characters 3-12
            const derivedPan = cleanGstin.substring(2, 12);
            if (panEl && (!panEl.value || panEl.value.length !== 10)) {
                panEl.value = derivedPan;
                flashField(panEl);
            }

            if (feedbackEl) {
                feedbackEl.style.display = 'block';
                feedbackEl.innerHTML = '<span class="text-primary"><i class="fa-solid fa-spinner fa-spin me-1"></i> Verifying GSTIN &amp; fetching taxpayer details...</span>';
            }

            try {
                const response = await fetch(`/Masters/LookupGstin?gstin=${encodeURIComponent(cleanGstin)}`);
                if (!response.ok) throw new Error('Lookup failed');
                const data = await response.json();

                if (data && data.success) {
                    if (nameEl && data.tradeName) {
                        nameEl.value = data.tradeName;
                        flashField(nameEl);
                    }
                    if (panEl && data.pan) {
                        panEl.value = data.pan;
                        flashField(panEl);
                    }
                    if (categoryEl && data.category) {
                        categoryEl.value = data.category;
                        flashField(categoryEl);
                    }
                    if (msmeEl && data.msmeType !== undefined) {
                        msmeEl.value = data.msmeType;
                        flashField(msmeEl);
                    }
                    if (addrEl && data.address) {
                        addrEl.value = data.address;
                        flashField(addrEl);
                    }
                    if (contactEl && data.contactPerson) {
                        contactEl.value = data.contactPerson;
                        flashField(contactEl);
                    }
                    if (phoneEl && data.phone) {
                        phoneEl.value = data.phone;
                        flashField(phoneEl);
                    }

                    if (feedbackEl) {
                        if (data.isKnown && data.tradeName) {
                            feedbackEl.innerHTML = `
                                <div class="alert alert-success py-1 px-2 mb-0 d-flex align-items-center gap-2 border-0 shadow-sm" style="font-size: 11px; background: #ECFDF5; color: #065F46;">
                                    <i class="fa-solid fa-circle-check fs-6 text-success"></i>
                                    <div>
                                        <strong>GSTIN Verified: Active</strong> &bull; ${data.stateName} (${data.stateCode})<br>
                                        <span style="font-size: 10px; color: #047857;">Constitution: ${data.constitution}</span>
                                    </div>
                                </div>`;
                        } else {
                            if (nameEl && !nameEl.value) {
                                nameEl.focus();
                            }
                            feedbackEl.innerHTML = `
                                <div class="alert alert-info py-1 px-2 mb-0 d-flex align-items-center gap-2 border-0 shadow-sm" style="font-size: 11px; background: #EFF6FF; color: #1E40AF;">
                                    <i class="fa-solid fa-circle-check fs-6 text-primary"></i>
                                    <div>
                                        <strong>GSTIN &amp; PAN (${data.pan}) Verified</strong> &bull; ${data.stateName} (${data.stateCode})<br>
                                        <span style="font-size: 10px; color: #2563EB;">Type: <strong>${data.constitution}</strong> &bull; Please enter the Trade / Company Name.</span>
                                    </div>
                                </div>`;
                        }
                    }
                } else {
                    if (feedbackEl) {
                        feedbackEl.innerHTML = `<span class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i> ${data.message || 'Unable to retrieve details for this GSTIN.'}</span>`;
                    }
                }
            } catch (err) {
                console.error(err);
                if (feedbackEl) {
                    feedbackEl.innerHTML = `<span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Network error connecting to GSTIN verification service.</span>`;
                }
            }
        }

        // Setup Vendor GSTIN handlers
        const vendorGstinInput = document.getElementById('createVendorGstin');
        const vendorPanInput = document.getElementById('createVendorPan');
        const btnFetchVendor = document.getElementById('btnFetchVendorGstin');

        if (vendorGstinInput) {
            vendorGstinInput.addEventListener('input', function (e) {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                if (this.value.length >= 12 && vendorPanInput) {
                    vendorPanInput.value = this.value.substring(2, 12);
                }
                if (this.value.length === 15) {
                    lookupGstin(this.value, 'vendor');
                }
            });

            vendorGstinInput.addEventListener('paste', function () {
                setTimeout(() => {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                    if (this.value.length === 15) lookupGstin(this.value, 'vendor');
                }, 50);
            });
        }

        if (btnFetchVendor && vendorGstinInput) {
            btnFetchVendor.addEventListener('click', function () {
                lookupGstin(vendorGstinInput.value, 'vendor');
            });
        }

        // Setup Client GSTIN handlers
        const clientGstinInput = document.getElementById('createClientGstin');
        const clientPanInput = document.getElementById('createClientPan');
        const btnFetchClient = document.getElementById('btnFetchClientGstin');

        if (clientGstinInput) {
            clientGstinInput.addEventListener('input', function (e) {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                if (this.value.length >= 12 && clientPanInput) {
                    clientPanInput.value = this.value.substring(2, 12);
                }
                if (this.value.length === 15) {
                    lookupGstin(this.value, 'client');
                }
            });

            clientGstinInput.addEventListener('paste', function () {
                setTimeout(() => {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                    if (this.value.length === 15) lookupGstin(this.value, 'client');
                }, 50);
            });
        }

        if (btnFetchClient && clientGstinInput) {
            btnFetchClient.addEventListener('click', function () {
                lookupGstin(clientGstinInput.value, 'client');
            });
        }

        // Support for edit vendor & client modals (auto-extract PAN)
        document.querySelectorAll('input[name="gstin"]').forEach(input => {
            if (input.id !== 'createVendorGstin' && input.id !== 'createClientGstin') {
                input.addEventListener('input', function () {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                    const row = this.closest('.row');
                    if (row && this.value.length >= 12) {
                        const panField = row.querySelector('input[name="pan"]');
                        if (panField && (!panField.value || panField.value.length !== 10)) {
                            panField.value = this.value.substring(2, 12);
                            flashField(panField);
                        }
                    }
                });
            }
        });

        // Dynamic Global Add Record Button behavior based on active tab
        const globalAddBtn = document.getElementById('btnGlobalAddRecord');
        const globalAddBtnText = document.getElementById('btnGlobalAddRecordText');

        const tabConfig = {
            '#clients': { modal: '#createClientModal', label: 'Add Client' },
            '#vendors': { modal: '#createVendorModal', label: 'Add Vendor' },
            '#items': { modal: '#createItemModal', label: 'Add Item' },
            '#projecttypes': { modal: '#createProjectTypeModal', label: 'Add Project Type' },
            '#expensetypes': { modal: '#createExpenseTypeModal', label: 'Add Expense Type' },
            '#tax': { modal: '', label: 'Add Record', hide: true },
            '#coa': { modal: '', label: 'Add Record', hide: true }
        };

        // Expense Types client-side search filter
        const expSearchInput = document.getElementById('expenseTypeSearchInput');
        if (expSearchInput) {
            expSearchInput.addEventListener('input', function () {
                const term = this.value.toLowerCase().trim();
                const rows = document.querySelectorAll('#expenseTypesTable tbody tr.expense-type-row');
                rows.forEach(row => {
                    const name = row.getAttribute('data-name') || '';
                    const desc = row.getAttribute('data-desc') || '';
                    if (!term || name.includes(term) || desc.includes(term)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }

        // Expense Types edit & delete modal bindings
        document.querySelectorAll('.edit-exp-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('editExpenseTypeId').value = this.getAttribute('data-id');
                document.getElementById('editExpenseTypeName').value = this.getAttribute('data-name');
                document.getElementById('editDescription').value = this.getAttribute('data-desc');
                document.getElementById('editIsProjectRelated').checked = this.getAttribute('data-isproject') === 'true';
                document.getElementById('editReceiveDirectPayments').checked = this.getAttribute('data-isdirect') === 'true';
                document.getElementById('editOpeningAmount').value = this.getAttribute('data-opening') || '';

                const modal = new bootstrap.Modal(document.getElementById('editExpenseTypeModal'));
                modal.show();
            });
        });

        document.querySelectorAll('.delete-exp-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                document.getElementById('deleteExpenseTypeId').value = id;
                document.getElementById('deleteExpenseTypeMessage').innerText = 'Are you sure you want to delete or deactivate "' + name + '"?';

                const modal = new bootstrap.Modal(document.getElementById('deleteExpenseTypeModal'));
                modal.show();
            });
        });

        function updateGlobalAddButton(targetId) {
            if (!globalAddBtn) return;
            const config = tabConfig[targetId] || { modal: '#createClientModal', label: 'Add Record' };
            if (config.hide) {
                globalAddBtn.style.display = 'none';
            } else {
                globalAddBtn.style.display = 'inline-flex';
                globalAddBtn.setAttribute('data-bs-target', config.modal);
                if (globalAddBtnText) globalAddBtnText.textContent = config.label;
            }
        }

        // Listen for tab switch
        const tabTriggerList = document.querySelectorAll('#masterTabs button[data-bs-toggle="pill"]');
        tabTriggerList.forEach(triggerEl => {
            triggerEl.addEventListener('shown.bs.tab', event => {
                const targetId = event.target.getAttribute('data-bs-target');
                updateGlobalAddButton(targetId);
                if (history.replaceState) {
                    history.replaceState(null, null, targetId);
                }
            });
        });

        // Handle URL hash or ?tab= query parameter on page load
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab') || window.location.hash.replace('#', '');
        if (tabParam) {
            const tabBtn = document.getElementById(tabParam + '-tab');
            if (tabBtn) {
                const bsTab = new bootstrap.Tab(tabBtn);
                bsTab.show();
                updateGlobalAddButton('#' + tabParam);
            }
        } else {
            const activeTab = document.querySelector('#masterTabs .nav-link.active');
            if (activeTab) {
                updateGlobalAddButton(activeTab.getAttribute('data-bs-target'));
            }
        }
    })();
</script>
}
