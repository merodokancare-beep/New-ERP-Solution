@model SDK.ERP.Application.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Organization & Profile Settings";
    ViewData["ActiveMenu"] = "Admin";
    var c = Model.Company;
    var u = Model.User;
}

<!-- Page Header Banner -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="brand-preview-avatar">
            <span class="preview-logo-box" id="headerPreviewBadge">@(string.IsNullOrEmpty(c.BrandShortName) ? "ERP" : c.BrandShortName)</span>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0 text-dark" id="headerCompanyName">@(string.IsNullOrEmpty(c.CompanyName) ? "My Enterprise ERP" : c.CompanyName)</h3>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 11px;">Active Workspace</span>
            </div>
            <p class="text-muted mb-0" style="font-size: 13.5px;">
                <span id="headerTagline">@(string.IsNullOrEmpty(c.Tagline) ? "SOLUTIONS ERP" : c.Tagline)</span> &bull; 
                GSTIN: <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(c.Gstin) ? "Not Configured" : c.Gstin)</span> &bull; 
                PAN: <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(c.Pan) ? "N/A" : c.Pan)</span>
            </p>
        </div>
    </div>
    
    <div class="d-flex gap-2">
        @if (Model.AllCompanies.Count > 1)
        {
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle px-3 shadow-sm" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-building me-1"></i> Switch Organization (@Model.AllCompanies.Count)
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li class="dropdown-header">Select Active Organization</li>
                    @foreach (var comp in Model.AllCompanies)
                    {
                        <li>
                            <form asp-controller="Profile" asp-action="SwitchCompany" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@comp.Id" />
                                <button type="submit" class="dropdown-item @(comp.Id == c.Id ? "active fw-bold" : "")">
                                    <span class="badge bg-secondary me-1">@(string.IsNullOrEmpty(comp.BrandShortName) ? "ERP" : comp.BrandShortName)</span>
                                    @comp.CompanyName
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }
        <button class="btn btn-outline-primary btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#newCompanyModal">
            <i class="fa-solid fa-plus me-1"></i> Add Organization
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
        <div>@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
        <div>@Html.Raw(TempData["ErrorMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Settings Navigation Tabs -->
<div class="erp-card mb-4">
    <div class="erp-card-header border-bottom p-2 bg-white">
        <ul class="nav nav-pills gap-2" id="profileTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="branding-tab" data-bs-toggle="pill" data-bs-target="#tab-branding" type="button" role="tab">
                    <i class="fa-solid fa-palette me-1 text-primary"></i> 1. Identity &amp; Branding
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="statutory-tab" data-bs-toggle="pill" data-bs-target="#tab-statutory" type="button" role="tab">
                    <i class="fa-solid fa-file-shield me-1 text-info"></i> 2. Statutory &amp; GST Compliance
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="banking-tab" data-bs-toggle="pill" data-bs-target="#tab-banking" type="button" role="tab">
                    <i class="fa-solid fa-building-columns me-1 text-success"></i> 3. Bank &amp; Invoice Coordinates
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="user-tab" data-bs-toggle="pill" data-bs-target="#tab-user" type="button" role="tab">
                    <i class="fa-solid fa-user-gear me-1 text-purple"></i> 4. My User Profile
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="team-tab" data-bs-toggle="pill" data-bs-target="#tab-team" type="button" role="tab">
                    <i class="fa-solid fa-users me-1 text-primary"></i> 5. Team &amp; Users (@Model.OrganizationUsers.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tenants-tab" data-bs-toggle="pill" data-bs-target="#tab-tenants" type="button" role="tab">
                    <i class="fa-solid fa-network-wired me-1 text-warning"></i> 6. Multi-Company Hub (@Model.AllCompanies.Count)
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content p-4">
        <!-- ================================================================= -->
        <!-- TAB 1: BRANDING & IDENTITY -->
        <!-- ================================================================= -->
        <div class="tab-pane fade show active" id="tab-branding" role="tabpanel">
            <form asp-controller="Profile" asp-action="UpdateCompany" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@c.Id" />
                <input type="hidden" name="CompanyCode" value="@c.CompanyCode" />
                <input type="hidden" name="Gstin" value="@c.Gstin" />
                <input type="hidden" name="Pan" value="@c.Pan" />
                <input type="hidden" name="Tan" value="@c.Tan" />
                <input type="hidden" name="Cin" value="@c.Cin" />
                <input type="hidden" name="MsmeUdyamNo" value="@c.MsmeUdyamNo" />
                <input type="hidden" name="AddressLine1" value="@c.AddressLine1" />
                <input type="hidden" name="AddressLine2" value="@c.AddressLine2" />
                <input type="hidden" name="City" value="@c.City" />
                <input type="hidden" name="State" value="@c.State" />
                <input type="hidden" name="StateCode" value="@c.StateCode" />
                <input type="hidden" name="Pincode" value="@c.Pincode" />
                <input type="hidden" name="BankName" value="@c.BankName" />
                <input type="hidden" name="BankAccountNumber" value="@c.BankAccountNumber" />
                <input type="hidden" name="BankIfsc" value="@c.BankIfsc" />
                <input type="hidden" name="BankBranch" value="@c.BankBranch" />
                <input type="hidden" name="UpiId" value="@c.UpiId" />
                <input type="hidden" name="AuthorizedSignatoryName" value="@c.AuthorizedSignatoryName" />
                <input type="hidden" name="AuthorizedSignatoryDesignation" value="@c.AuthorizedSignatoryDesignation" />
                <input type="hidden" name="TermsAndConditions" value="@c.TermsAndConditions" />

                <!-- Corporate Logo Upload & Storage Partition -->
                <div class="card border mb-4 bg-light-subtle shadow-sm" style="border-radius: 12px;">
                    <div class="card-body p-3">
                        <div class="row align-items-center g-3">
                            <div class="col-auto">
                                <div id="logoPreviewBox" class="border rounded-3 p-2 bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 140px; height: 75px;">
                                    @if (!string.IsNullOrEmpty(c.LogoUrl))
                                    {
                                        <img src="@c.LogoUrl" id="companyLogoImg" alt="Company Logo" style="max-height: 60px; max-width: 125px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <div id="companyLogoFallback" class="text-center">
                                            <span class="badge bg-primary px-3 py-1 fs-6">@(string.IsNullOrEmpty(c.BrandShortName) ? "ERP" : c.BrandShortName)</span>
                                            <div class="text-muted" style="font-size: 10px; margin-top: 2px;">No Logo Uploaded</div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col">
                                <label class="form-label fw-bold mb-1 text-dark"><i class="fa-solid fa-cloud-arrow-up me-1 text-primary"></i> Upload Corporate Brand Logo</label>
                                <p class="text-muted small mb-2">Upload your high-resolution company emblem (PNG, JPG, SVG, WebP, max 5 MB). This logo is dynamically rendered on your invoices, purchase orders, delivery challans, and sidebar header.</p>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <input type="file" name="logoFile" id="logoFileInput" class="form-control form-control-sm" style="max-width: 320px;" accept=".png,.jpg,.jpeg,.svg,.webp" />
                                    @if (!string.IsNullOrEmpty(c.LogoUrl))
                                    {
                                        <button type="submit" name="removeLogo" value="true" class="btn btn-outline-danger btn-sm">
                                            <i class="fa-solid fa-trash me-1"></i> Remove Logo
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live Preview Widget -->
                <div class="p-3 mb-4 rounded-3 border bg-light-subtle d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="fw-bold fs-6 text-primary"><i class="fa-solid fa-eye me-2"></i>Live Sidebar &amp; Header Preview</div>
                        <small class="text-muted">This preview shows exactly how your company logo and brand title will appear across the entire ERP navigation and invoice headers.</small>
                    </div>
                    <div class="sidebar-brand-preview border rounded-3 p-2 px-3 bg-white shadow-sm d-flex align-items-center gap-2">
                        <span class="logo-box" id="previewBadge" style="background: linear-gradient(135deg, #0284C7, #0EA5E9); color: #FFF; padding: 4px 8px; border-radius: 6px; font-size: 14px; font-weight: 800;">
                            @(string.IsNullOrEmpty(c.BrandShortName) ? "ERP" : c.BrandShortName)
                        </span>
                        <span id="previewText" style="font-size: 15px; color: #0284C7; font-weight: 800; letter-spacing: -0.5px;">
                            @(string.IsNullOrEmpty(c.Tagline) ? "SOLUTIONS ERP" : c.Tagline)
                        </span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Company / Organization Trade Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="CompanyName" id="inputCompanyName" value="@c.CompanyName" required placeholder="e.g. Acme Technologies Private Limited" />
                        <small class="text-muted">Displayed as the primary enterprise business name.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Legal / Registered Entity Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="LegalName" value="@c.LegalName" required placeholder="Full registered company name" />
                        <small class="text-muted">Appears in legal contracts, statutory tax filings, and audit books.</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Logo Badge Text / Brand Acronym <span class="text-danger">*</span></label>
                        <input type="text" class="form-control text-uppercase fw-bold" name="BrandShortName" id="inputBrandBadge" value="@c.BrandShortName" maxlength="6" required placeholder="e.g. ACME" />
                        <small class="text-muted">2 to 5 character acronym for the top left logo box.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Header Tagline / Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control text-uppercase" name="Tagline" id="inputTagline" value="@c.Tagline" maxlength="30" required placeholder="e.g. SOLUTIONS ERP" />
                        <small class="text-muted">Displayed next to the logo box in the navigation bar.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Industry / Operating Domain</label>
                        <select class="form-select" name="Industry">
                            <option value="IT Services &amp; Consulting" selected="@(c.Industry == "IT Services & Consulting")">IT Services &amp; Consulting</option>
                            <option value="Software &amp; Digital Solutions" selected="@(c.Industry == "Software & Digital Solutions")">Software &amp; Digital Solutions</option>
                            <option value="Manufacturing &amp; Industrial" selected="@(c.Industry == "Manufacturing & Industrial")">Manufacturing &amp; Industrial</option>
                            <option value="Trading, Wholesale &amp; Distribution" selected="@(c.Industry == "Trading, Wholesale & Distribution")">Trading, Wholesale &amp; Distribution</option>
                            <option value="Engineering &amp; Construction" selected="@(c.Industry == "Engineering & Construction")">Engineering &amp; Construction</option>
                            <option value="Contracting &amp; Project Delivery" selected="@(c.Industry == "Contracting & Project Delivery")">Contracting &amp; Project Delivery</option>
                            <option value="Professional &amp; Financial Services" selected="@(c.Industry == "Professional & Financial Services")">Professional &amp; Financial Services</option>
                            <option value="Retail &amp; Consumer Goods" selected="@(c.Industry == "Retail & Consumer Goods")">Retail &amp; Consumer Goods</option>
                            <option value="Healthcare &amp; Pharmaceuticals" selected="@(c.Industry == "Healthcare & Pharmaceuticals")">Healthcare &amp; Pharmaceuticals</option>
                            <option value="General Commercial Enterprise" selected="@(c.Industry == "General Commercial Enterprise")">General Commercial Enterprise</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Base Operating Currency</label>
                        <select class="form-select" name="BaseCurrency">
                            <option value="INR" selected="@(c.BaseCurrency == "INR")">INR - Indian Rupee (&#8377;)</option>
                            <option value="USD" selected="@(c.BaseCurrency == "USD")">USD - US Dollar ($)</option>
                            <option value="EUR" selected="@(c.BaseCurrency == "EUR")">EUR - Euro (&euro;)</option>
                            <option value="GBP" selected="@(c.BaseCurrency == "GBP")">GBP - British Pound (&pound;)</option>
                            <option value="AED" selected="@(c.BaseCurrency == "AED")">AED - UAE Dirham (AED)</option>
                            <option value="SGD" selected="@(c.BaseCurrency == "SGD")">SGD - Singapore Dollar (S$)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Official Business Email</label>
                        <input type="email" class="form-control" name="Email" value="@c.Email" placeholder="billing@company.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Primary Contact Phone</label>
                        <input type="tel" class="form-control" name="Phone" value="@c.Phone" placeholder="+91 98765 43210" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Website / Portal URL</label>
                        <input type="url" class="form-control" name="Website" value="@c.Website" placeholder="https://www.yourcompany.com" />
                    </div>
                </div>

                <div class="text-end border-top pt-3">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Identity &amp; Branding
                    </button>
                </div>
            </form>
        </div>

        <!-- ================================================================= -->
        <!-- TAB 2: STATUTORY & GST COMPLIANCE -->
        <!-- ================================================================= -->
        <div class="tab-pane fade" id="tab-statutory" role="tabpanel">
            <form asp-controller="Profile" asp-action="UpdateCompany" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@c.Id" />
                <input type="hidden" name="CompanyCode" value="@c.CompanyCode" />
                <input type="hidden" name="CompanyName" value="@c.CompanyName" />
                <input type="hidden" name="LegalName" value="@c.LegalName" />
                <input type="hidden" name="BrandShortName" value="@c.BrandShortName" />
                <input type="hidden" name="Tagline" value="@c.Tagline" />
                <input type="hidden" name="Industry" value="@c.Industry" />
                <input type="hidden" name="BaseCurrency" value="@c.BaseCurrency" />
                <input type="hidden" name="Email" value="@c.Email" />
                <input type="hidden" name="Phone" value="@c.Phone" />
                <input type="hidden" name="Website" value="@c.Website" />
                <input type="hidden" name="BankName" value="@c.BankName" />
                <input type="hidden" name="BankAccountNumber" value="@c.BankAccountNumber" />
                <input type="hidden" name="BankIfsc" value="@c.BankIfsc" />
                <input type="hidden" name="BankBranch" value="@c.BankBranch" />
                <input type="hidden" name="UpiId" value="@c.UpiId" />
                <input type="hidden" name="AuthorizedSignatoryName" value="@c.AuthorizedSignatoryName" />
                <input type="hidden" name="AuthorizedSignatoryDesignation" value="@c.AuthorizedSignatoryDesignation" />
                <input type="hidden" name="TermsAndConditions" value="@c.TermsAndConditions" />

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Goods &amp; Services Tax Identification (GSTIN)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-file-shield"></i></span>
                            <input type="text" class="form-control text-uppercase fw-bold" name="Gstin" id="inputGstin" value="@c.Gstin" maxlength="15" placeholder="07AAAAA0000A1Z5" />
                        </div>
                        <small class="text-muted">15-character statutory GSTIN number.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Permanent Account Number (PAN) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-id-card"></i></span>
                            <input type="text" class="form-control text-uppercase fw-bold" name="Pan" id="inputPan" value="@c.Pan" maxlength="10" required placeholder="AAAAA0000A" />
                        </div>
                        <small class="text-muted">10-character PAN of entity or proprietor.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Tax Deduction Account Number (TAN)</label>
                        <input type="text" class="form-control text-uppercase" name="Tan" value="@c.Tan" maxlength="10" placeholder="DELA12345B" />
                        <small class="text-muted">Used for TDS returns and deduction certificates.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Corporate Identification Number (CIN)</label>
                        <input type="text" class="form-control text-uppercase" name="Cin" value="@c.Cin" placeholder="U72200DL2026PTC123456" />
                        <small class="text-muted">21-digit MCA registration number for Companies.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">MSME / Udyam Registration Number</label>
                        <input type="text" class="form-control text-uppercase" name="MsmeUdyamNo" value="@c.MsmeUdyamNo" placeholder="UDYAM-DL-01-0012345" />
                        <small class="text-muted">Printed on invoices for statutory MSME compliance.</small>
                    </div>

                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-12"><h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-location-dot me-2 text-danger"></i>Registered Office &amp; Principal Place of Business</h6></div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Address Line 1 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="AddressLine1" value="@c.AddressLine1" placeholder="Building, Suite, Street" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Address Line 2</label>
                        <input type="text" class="form-control" name="AddressLine2" value="@c.AddressLine2" placeholder="Area, Landmark" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">City / District <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="City" value="@c.City" placeholder="City" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">State / UT <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="State" id="inputState" value="@c.State" placeholder="e.g. Delhi, Maharashtra" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">GST State Code (2-Digits) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control fw-bold" name="StateCode" id="inputStateCode" value="@c.StateCode" maxlength="2" placeholder="07" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Postal PIN Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Pincode" value="@c.Pincode" maxlength="10" placeholder="110001" required />
                    </div>
                </div>

                <div class="text-end border-top pt-3">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Statutory &amp; GST Details
                    </button>
                </div>
            </form>
        </div>

        <!-- ================================================================= -->
        <!-- TAB 3: BANK & INVOICE COORDINATES -->
        <!-- ================================================================= -->
        <div class="tab-pane fade" id="tab-banking" role="tabpanel">
            <form asp-controller="Profile" asp-action="UpdateCompany" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@c.Id" />
                <input type="hidden" name="CompanyCode" value="@c.CompanyCode" />
                <input type="hidden" name="CompanyName" value="@c.CompanyName" />
                <input type="hidden" name="LegalName" value="@c.LegalName" />
                <input type="hidden" name="BrandShortName" value="@c.BrandShortName" />
                <input type="hidden" name="Tagline" value="@c.Tagline" />
                <input type="hidden" name="Industry" value="@c.Industry" />
                <input type="hidden" name="BaseCurrency" value="@c.BaseCurrency" />
                <input type="hidden" name="Email" value="@c.Email" />
                <input type="hidden" name="Phone" value="@c.Phone" />
                <input type="hidden" name="Website" value="@c.Website" />
                <input type="hidden" name="Gstin" value="@c.Gstin" />
                <input type="hidden" name="Pan" value="@c.Pan" />
                <input type="hidden" name="Tan" value="@c.Tan" />
                <input type="hidden" name="Cin" value="@c.Cin" />
                <input type="hidden" name="MsmeUdyamNo" value="@c.MsmeUdyamNo" />
                <input type="hidden" name="AddressLine1" value="@c.AddressLine1" />
                <input type="hidden" name="AddressLine2" value="@c.AddressLine2" />
                <input type="hidden" name="City" value="@c.City" />
                <input type="hidden" name="State" value="@c.State" />
                <input type="hidden" name="StateCode" value="@c.StateCode" />
                <input type="hidden" name="Pincode" value="@c.Pincode" />

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="alert alert-info py-2 px-3 d-flex align-items-center mb-2" style="font-size: 13px;">
                            <i class="fa-solid fa-circle-info me-2 fs-5"></i>
                            <div>These banking coordinates and authorized signatures will automatically print at the bottom of all generated <strong>Tax Invoices, Quotations, and Payment Receipts</strong>.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Primary Operating Bank Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="BankName" value="@c.BankName" placeholder="e.g. HDFC Bank Ltd / ICICI Bank" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Bank Account Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control fw-bold" name="BankAccountNumber" value="@c.BankAccountNumber" placeholder="e.g. 50200084920194" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">IFSC Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control text-uppercase fw-bold" name="BankIfsc" value="@c.BankIfsc" maxlength="11" placeholder="e.g. HDFC0000123" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Bank Branch Name</label>
                        <input type="text" class="form-control" name="BankBranch" value="@c.BankBranch" placeholder="e.g. Connaught Place, New Delhi" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">UPI ID (For Quick QR Payments)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-qrcode"></i></span>
                            <input type="text" class="form-control" name="UpiId" value="@c.UpiId" placeholder="company@okaxis" />
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-12"><h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-signature me-2 text-primary"></i>Invoice Execution &amp; Authorized Signatory</h6></div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Authorized Signatory Name</label>
                        <input type="text" class="form-control" name="AuthorizedSignatoryName" value="@c.AuthorizedSignatoryName" placeholder="e.g. Managing Director / Partner" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Signatory Title / Designation</label>
                        <input type="text" class="form-control" name="AuthorizedSignatoryDesignation" value="@c.AuthorizedSignatoryDesignation" placeholder="e.g. Authorized Signatory" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Standard Invoice Terms &amp; Conditions / Notes</label>
                        <textarea class="form-control font-monospace" name="TermsAndConditions" rows="4" style="font-size: 13px;" placeholder="1. Goods once sold will not be taken back.&#10;2. Payment is due within 30 days.">@c.TermsAndConditions</textarea>
                    </div>
                </div>

                <div class="text-end border-top pt-3">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Banking &amp; Invoicing Setup
                    </button>
                </div>
            </form>
        </div>

        <!-- ================================================================= -->
        <!-- TAB 4: MY USER PROFILE -->
        <!-- ================================================================= -->
        <div class="tab-pane fade" id="tab-user" role="tabpanel">
            <form asp-controller="Profile" asp-action="UpdateUser" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@u.Id" />

                <div class="row g-4 mb-4">
                    <div class="col-md-4 text-center border-end pe-4">
                        <div class="user-avatar-large mx-auto mb-3 shadow-sm" style="overflow: hidden; border: 3px solid #E0F2FE;">
                            @if (!string.IsNullOrEmpty(u.AvatarUrl))
                            {
                                <img src="@u.AvatarUrl" id="userAvatarImg" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="fa-solid fa-user-tie fs-1" id="userAvatarIcon"></i>
                            }
                        </div>
                        <div class="mb-3 px-3">
                            <label class="form-label small fw-semibold text-muted mb-1"><i class="fa-solid fa-camera me-1"></i> Update Avatar Photo</label>
                            <input type="file" name="avatarFile" id="avatarFileInput" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp" />
                            @if (!string.IsNullOrEmpty(u.AvatarUrl))
                            {
                                <button type="submit" name="removeAvatar" value="true" class="btn btn-outline-danger btn-sm mt-2">
                                    <i class="fa-solid fa-trash me-1"></i> Remove Avatar
                                </button>
                            }
                        </div>
                        <h5 class="fw-bold mb-1 text-dark">@(string.IsNullOrEmpty(u.FullName) ? "Admin User" : u.FullName)</h5>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 mb-2">@(string.IsNullOrEmpty(u.Designation) ? "Administrator" : u.Designation)</span>
                        <div class="text-muted small">Username: <strong class="text-dark">@u.Username</strong></div>
                        <div class="text-muted small">Role: <strong class="text-dark">@(u.Role?.RoleName ?? "SUPER_ADMIN")</strong></div>
                    </div>

                    <div class="col-md-8">
                        <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-id-badge me-2 text-primary"></i>Personal Information &amp; Header Identity</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Your Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="FullName" value="@u.FullName" required placeholder="e.g. Bhawani Prasad" />
                                <small class="text-muted">Displayed in the top-right header and audit logs.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Job Title / Designation <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Designation" value="@u.Designation" required placeholder="e.g. Managing Director &amp; CEO" />
                                <small class="text-muted">Displayed below your name in the topbar header.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" name="Email" value="@u.Email" required placeholder="user@company.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone / Mobile Number</label>
                                <input type="tel" class="form-control" name="PhoneNumber" value="@u.PhoneNumber" placeholder="+91 98765 43210" />
                            </div>
                        </div>

                        <div class="text-end border-top pt-3 mt-4">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: var(--erp-primary);">
                                <i class="fa-solid fa-user-check me-1"></i> Update Personal Profile
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- ================================================================= -->
        <!-- TAB 5: ORGANIZATION TEAM & USERS -->
        <!-- ================================================================= -->
        <div class="tab-pane fade" id="tab-team" role="tabpanel">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <h5 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-users me-2 text-primary"></i>Organization Team &amp; User Accounts</h5>
                    <p class="text-muted small mb-0">Manage user credentials and access permissions for <strong>@c.CompanyName</strong>. Users have strict tenant isolation.</p>
                </div>
                <button class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#addTeamMemberModal">
                    <i class="fa-solid fa-user-plus me-1"></i> Add Team Member
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle border mb-0" style="font-size: 13px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Team Member</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Branch</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrganizationUsers != null && Model.OrganizationUsers.Any())
                        {
                            @foreach (var usr in Model.OrganizationUsers)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(usr.AvatarUrl))
                                            {
                                                <img src="@usr.AvatarUrl" alt="@usr.FullName" class="rounded-circle" style="width: 34px; height: 34px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 12px;">
                                                    @(!string.IsNullOrEmpty(usr.FullName) ? usr.FullName.Substring(0, 1).ToUpper() : "U")
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-bold text-dark">@usr.FullName</div>
                                                <div class="text-muted small">@usr.Designation</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code>@usr.Username</code></td>
                                    <td>@usr.Email</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            @(usr.Role?.RoleName ?? "USER")
                                        </span>
                                    </td>
                                    <td>@(usr.Branch?.BranchName ?? "Head Office")</td>
                                    <td>
                                        @if (usr.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="fa-solid fa-circle-xmark me-1"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (usr.Id != u.Id)
                                        {
                                            <form asp-controller="Profile" asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@usr.Id" />
                                                <button type="submit" class="btn btn-sm @(usr.IsActive ? "btn-outline-danger" : "btn-outline-success")" style="font-size: 11.5px;">
                                                    <i class="fa-solid @(usr.IsActive ? "fa-user-slash" : "fa-user-check") me-1"></i>
                                                    @(usr.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Logged In User</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-users fs-3 d-block mb-2 text-secondary"></i>
                                    No other users registered in this organization. Click <strong>Add Team Member</strong> above to create users.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================================================================= -->
        <!-- TAB 6: MULTI-COMPANY HUB -->
        <!-- ================================================================= -->
        <div class="tab-pane fade" id="tab-tenants" role="tabpanel">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-buildings me-2 text-warning"></i>Registered Organizations &amp; Sister Entities</h5>
                    <p class="text-muted small mb-0">Switch your active working workspace or register subsidiary companies.</p>
                </div>
                <button class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#newCompanyModal">
                    <i class="fa-solid fa-plus me-1"></i> Register New Organization
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle border mb-0" style="font-size: 13px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Brand Badge</th>
                            <th>Company Name</th>
                            <th>GSTIN</th>
                            <th>Currency</th>
                            <th>City / State</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in Model.AllCompanies)
                        {
                            <tr class="@(comp.Id == c.Id ? "table-primary-subtle" : "")">
                                <td class="ps-3">
                                    <span class="badge bg-primary px-2 py-1 fs-6">@(string.IsNullOrEmpty(comp.BrandShortName) ? "ERP" : comp.BrandShortName)</span>
                                </td>
                                <td>
                                    <strong>@comp.CompanyName</strong>
                                    <div class="text-muted small">@comp.Tagline</div>
                                </td>
                                <td>@(string.IsNullOrEmpty(comp.Gstin) ? "Not Configured" : comp.Gstin)</td>
                                <td><span class="badge bg-light text-dark border">@comp.BaseCurrency</span></td>
                                <td>@(string.IsNullOrEmpty(comp.City) ? "-" : $"{comp.City}, {comp.State}")</td>
                                <td>
                                    @if (comp.Id == c.Id)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Available</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (comp.Id != c.Id)
                                    {
                                        <form asp-controller="Profile" asp-action="SwitchCompany" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="companyId" value="@comp.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Switch to this Org
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-semibold">Current Workspace</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add New Organization -->
<div class="modal fade" id="newCompanyModal" tabindex="-1" aria-labelledby="newCompanyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #0284C7, #0EA5E9);">
                <h5 class="modal-title fw-bold" id="newCompanyModalLabel"><i class="fa-solid fa-building-circle-plus me-2"></i>Register New Enterprise Organization</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Profile" asp-action="CreateCompany" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">Register an additional company, subsidiary, or sister business unit. Once registered, you can toggle between entities anytime.</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="CompanyName" required placeholder="e.g. Apex Global Logistics" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Legal Entity Name</label>
                            <input type="text" class="form-control" name="LegalName" placeholder="Full registered name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Brand Acronym / Logo Text <span class="text-danger">*</span></label>
                            <input type="text" class="form-control text-uppercase fw-bold" name="BrandShortName" maxlength="6" required placeholder="e.g. APEX" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Header Tagline</label>
                            <input type="text" class="form-control text-uppercase" name="Tagline" value="ENTERPRISE ERP" placeholder="ENTERPRISE ERP" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Base Currency</label>
                            <select class="form-select" name="BaseCurrency">
                                <option value="INR" selected>INR - Indian Rupee (&#8377;)</option>
                                <option value="USD">USD - US Dollar ($)</option>
                                <option value="EUR">EUR - Euro (&euro;)</option>
                                <option value="AED">AED - UAE Dirham (AED)</option>
