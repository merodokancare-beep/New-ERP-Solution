                            <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="fullName" required placeholder="e.g. Ramesh Sharma" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="username" required placeholder="e.g. ramesh.sharma" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" name="email" required placeholder="ramesh@company.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone / Mobile</label>
                            <input type="tel" class="form-control" name="phoneNumber" placeholder="+91 98765 43210" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Designation / Job Title</label>
                            <input type="text" class="form-control" name="designation" placeholder="e.g. Senior Accountant / Project Manager" />
                        </div>
                        <div class="col-md-3">
