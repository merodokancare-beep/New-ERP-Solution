                                    {
                                        <option value="@r.Id">@r.RoleName</option>
                                    }
                                }
                                else
                                {
                                    <option value="1">ADMIN</option>
                                    <option value="2">ACCOUNTANT</option>
                                    <option value="3">PROJECT_LEAD</option>
                                    <option value="4">AUDITOR</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Branch Office</label>
                            <select class="form-select" name="branchId">
                                @if (Model.Branches != null && Model.Branches.Any())
                                {
                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.Id">@b.BranchName</option>
                                    }
                                }
                                else
                                {
                                    <option value="1">Head Office</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Initial Temporary Password</label>
                            <input type="text" class="form-control font-monospace" name="temporaryPassword" value="Erp@2026!" />
                            <small class="text-muted">The user can change this password after their initial login.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-check me-1"></i> Create User Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Auto-switch tabs based on URL hash (e.g. #user, #statutory, #banking, #team, #tenants)
        if (window.location.hash) {
            const hash = window.location.hash.replace('#', '');
            const tabBtn = document.getElementById(hash + '-tab');
            if (tabBtn && typeof bootstrap !== 'undefined') {
                bootstrap.Tab.getOrCreateInstance(tabBtn).show();
            }
        }

        // Live Logo Image Preview
        const logoFileInput = document.getElementById('logoFileInput');
        const companyLogoImg = document.getElementById('companyLogoImg');
        const logoPreviewBox = document.getElementById('logoPreviewBox');

        if (logoFileInput) {
            logoFileInput.addEventListener('change', function () {
                const file = this.files && this.files[0];
                if (file) {
                    const previewUrl = URL.createObjectURL(file);
                    if (companyLogoImg) {
                        companyLogoImg.src = previewUrl;
                    } else if (logoPreviewBox) {
                        logoPreviewBox.innerHTML = `<img src="${previewUrl}" id="companyLogoImg" alt="Logo Preview" style="max-height: 60px; max-width: 125px; object-fit: contain;" />`;
                    }
                }
            });
        }

        // Live User Avatar Preview
        const avatarFileInput = document.getElementById('avatarFileInput');
        const userAvatarImg = document.getElementById('userAvatarImg');
        const userAvatarIcon = document.getElementById('userAvatarIcon');

        if (avatarFileInput) {
            avatarFileInput.addEventListener('change', function () {
                const file = this.files && this.files[0];
                if (file) {
                    const previewUrl = URL.createObjectURL(file);
                    if (userAvatarImg) {
                        userAvatarImg.src = previewUrl;
                    } else if (userAvatarIcon && userAvatarIcon.parentElement) {
                        userAvatarIcon.parentElement.innerHTML = `<img src="${previewUrl}" id="userAvatarImg" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />`;
                    }
                }
            });
        }

        // Live Preview Binding for Branding Tab
        const inputBrandBadge = document.getElementById('inputBrandBadge');
        const inputTagline = document.getElementById('inputTagline');
        const previewBadge = document.getElementById('previewBadge');
        const previewText = document.getElementById('previewText');
        const headerPreviewBadge = document.getElementById('headerPreviewBadge');
        const headerTagline = document.getElementById('headerTagline');
        const inputCompanyName = document.getElementById('inputCompanyName');
        const headerCompanyName = document.getElementById('headerCompanyName');

        if (inputBrandBadge && previewBadge) {
            inputBrandBadge.addEventListener('input', function () {
                const val = (this.value || 'ERP').trim().toUpperCase();
                previewBadge.textContent = val;
                if (headerPreviewBadge) headerPreviewBadge.textContent = val;
            });
        }

        if (inputTagline && previewText) {
            inputTagline.addEventListener('input', function () {
                const val = (this.value || 'SOLUTIONS ERP').trim().toUpperCase();
                previewText.textContent = val;
                if (headerTagline) headerTagline.textContent = val;
            });
        }

        if (inputCompanyName && headerCompanyName) {
            inputCompanyName.addEventListener('input', function () {
                headerCompanyName.textContent = this.value || 'My Enterprise ERP';
            });
        }

        // Auto-fill state code from GSTIN
        const inputGstin = document.getElementById('inputGstin');
        const inputStateCode = document.getElementById('inputStateCode');
        const inputPan = document.getElementById('inputPan');

        if (inputGstin) {
            inputGstin.addEventListener('input', function () {
                const gstin = this.value.trim().toUpperCase();
                if (gstin.length >= 2 && inputStateCode && !inputStateCode.value) {
                    inputStateCode.value = gstin.substring(0, 2);
                }
                if (gstin.length >= 12 && inputPan && !inputPan.value) {
                    inputPan.value = gstin.substring(2, 12);
                }
            });
        }
    });
</script>
