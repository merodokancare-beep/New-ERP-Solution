                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">GSTIN</label>
                            <input type="text" class="form-control text-uppercase" name="Gstin" placeholder="Optional for now" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">City &amp; State</label>
                            <input type="text" class="form-control" name="City" placeholder="City, State" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-plus me-1"></i> Register &amp; Activate Org
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add New Team Member -->
<div class="modal fade" id="addTeamMemberModal" tabindex="-1" aria-labelledby="addTeamMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #0284C7, #0EA5E9);">
                <h5 class="modal-title fw-bold" id="addTeamMemberModalLabel"><i class="fa-solid fa-user-plus me-2"></i>Add Team Member to @c.CompanyName</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Profile" asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
