                    Cancel
                </button>
                <button type="button" class="btn btn-primary px-4 py-1.5 rounded-pill fw-semibold shadow-sm" id="btnSaveQuickClient" onclick="saveQuickClient()" style="font-size: 13px; background: #4F46E5; border-color: #4F46E5;">
                    <i class="fa-solid fa-check me-1"></i> Save &amp; Select Client
                </button>
