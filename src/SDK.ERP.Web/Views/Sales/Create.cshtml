                <div class="modal-body p-4" style="background: #F8FAFC;">
                    <div id="quickClientError" class="alert alert-danger d-none mb-3 py-2 px-3" style="font-size: 12.5px; border-radius: 8px;"></div>

                    <div class="card border-0 shadow-sm p-3 mb-0 bg-white" style="border-radius: 10px;">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="inv-label" style="font-size: 12px;">Client Code <span class="text-danger">*</span></label>
                                <input type="text" id="quickClientCode" name="clientCode" class="form-control form-control-sm inv-input bg-light" value="CL-@DateTime.Now.ToString("MMddHHmm")" required />
                            </div>
                            <div class="col-md-7">
                                <label class="inv-label" style="font-size: 12px;">Client / Company Name <span class="text-danger">*</span></label>
