                <div class="modal-footer bg-white px-4 py-3 border-top">
                    <button type="button" class="btn btn-light btn-sm px-3 fw-semibold border" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveQuickClient" class="btn btn-primary btn-sm px-4 fw-semibold shadow-sm" style="background: #4F46E5; border-color: #4F46E5;" onclick="saveQuickClient()">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save to Master &amp; Select
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const COMPANY_STATE_CODE = "@companyState";

    function toggleInvoiceAgainst() {
        const isProject = document.getElementById("radioTypeProject").checked;
        const projectContainer = document.getElementById("projectSelectContainer");
        const clientContainer = document.getElementById("clientSelectContainer");
        const projectSelect = document.getElementById("projectSelect");
        const clientSelect = document.getElementById("clientSelect");
        const clientIdHidden = document.getElementById("clientIdHidden");
        const labelProject = document.getElementById("labelTypeProject");
        const labelClient = document.getElementById("labelTypeClient");

        if (isProject) {
            // Radio Pill Styling
            labelProject.style.borderColor = "#6366F1";
            labelProject.style.background = "#EEF2FF";
            labelProject.style.color = "#4338CA";

            labelClient.style.borderColor = "#CBD5E1";
            labelClient.style.background = "#FFFFFF";
            labelClient.style.color = "#475569";

            // Containers
            projectContainer.classList.remove("d-none");
            clientContainer.classList.add("d-none");

            // Form inputs
            projectSelect.disabled = false;
            projectSelect.required = true;

            clientIdHidden.disabled = false;
            clientIdHidden.setAttribute("name", "clientId");

            clientSelect.disabled = true;
            clientSelect.required = false;
            clientSelect.removeAttribute("name");
            clientSelect.value = "";

            document.getElementById("clientDetailsBox").classList.add("d-none");
            onProjectChange();
        } else {
            // Radio Pill Styling
            labelClient.style.borderColor = "#10B981";
            labelClient.style.background = "#ECFDF5";
            labelClient.style.color = "#047857";

            labelProject.style.borderColor = "#CBD5E1";
            labelProject.style.background = "#FFFFFF";
            labelProject.style.color = "#475569";

            // Containers
            projectContainer.classList.add("d-none");
            clientContainer.classList.remove("d-none");

            // Form inputs
            projectSelect.disabled = true;
            projectSelect.required = false;
            projectSelect.value = "";

            clientIdHidden.disabled = true;
            clientIdHidden.removeAttribute("name");
            clientIdHidden.value = "";

            clientSelect.disabled = false;
            clientSelect.required = true;
            clientSelect.setAttribute("name", "clientId");

            document.getElementById("projectDetailsBox").classList.add("d-none");
            onClientChange();
        }
    }

    function onProjectChange() {
        const select = document.getElementById("projectSelect");
        const selectedOpt = select.options[select.selectedIndex];
        const detailsBox = document.getElementById("projectDetailsBox");

        if (!selectedOpt || !selectedOpt.value) {
            if (detailsBox) detailsBox.classList.add("d-none");
            const clHidden = document.getElementById("clientIdHidden");
            if (clHidden) clHidden.value = "";
            return;
        }

        const clientId = selectedOpt.getAttribute("data-client-id");
        const contact = selectedOpt.getAttribute("data-contact");
        const clientName = selectedOpt.getAttribute("data-client-name");
        const state = selectedOpt.getAttribute("data-state") || "07";
        const gstin = selectedOpt.getAttribute("data-gstin") || "Unregistered / N/A";
        const poNum = selectedOpt.getAttribute("data-po-num") || "";
        const poDate = selectedOpt.getAttribute("data-po-date") || "";
        const projectName = selectedOpt.getAttribute("data-project-name") || "";
        const projectCode = selectedOpt.getAttribute("data-project-code") || "";
        const scope = selectedOpt.getAttribute("data-scope") || "";
        const rate = parseFloat(selectedOpt.getAttribute("data-rate")) || 0;

        document.getElementById("clientIdHidden").value = clientId || "";
        document.getElementById("billingAttentionInput").value = contact || clientName || "";

        // Preview Details Box
        if (detailsBox) {
            document.getElementById("pjClientName").innerText = clientName || "N/A";
            document.getElementById("pjGstin").innerText = gstin;
            document.getElementById("pjState").innerText = state;
            detailsBox.classList.remove("d-none");
        }

        // Auto-fill Work Order / PO No.
        const workOrderInput = document.getElementById("workOrderNoInput");
        if (workOrderInput) {
            workOrderInput.value = poNum || (projectCode ? `WO-${projectCode}` : "");
        }

        // Auto-fill Work Order Date
        const workOrderDateInput = document.getElementById("workOrderDateInput");
        if (workOrderDateInput && poDate) {
            workOrderDateInput.value = poDate;
        }

        // Auto-fill First Item Description & Rate if empty or auto-filled
        const firstRow = document.querySelector(".item-row");
        if (firstRow) {
            const descInput = firstRow.querySelector(".item-desc");
            if (descInput && (!descInput.value.trim() || descInput.dataset.autoFilled === "true")) {
                let descText = projectName;
                if (scope && scope !== projectName) {
                    descText += `\n${scope}`;
                }
                if (poNum) {
                    descText += ` (Ref: PO No. ${poNum})`;
                }
                descInput.value = descText;
                descInput.dataset.autoFilled = "true";
            }

            const rateInput = firstRow.querySelector(".item-rate");
            if (rateInput && ((parseFloat(rateInput.value) || 0) === 0 || rateInput.dataset.autoFilled === "true") && rate > 0) {
                rateInput.value = rate.toFixed(2);
                rateInput.dataset.autoFilled = "true";
                recalcRow(rateInput);
            }
        }

        // Recheck interstate / intrastate split for existing rows
        recheckGstTaxes();
    }

    function onClientChange() {
        const select = document.getElementById("clientSelect");
        const selectedOpt = select.options[select.selectedIndex];
        const detailsBox = document.getElementById("clientDetailsBox");

        if (!selectedOpt || !selectedOpt.value) {
            if (detailsBox) detailsBox.classList.add("d-none");
            return;
        }

        const clientName = selectedOpt.getAttribute("data-client-name") || "";
        const contact = selectedOpt.getAttribute("data-contact") || "";
        const state = selectedOpt.getAttribute("data-state") || "07";
        const gstin = selectedOpt.getAttribute("data-gstin") || "Unregistered / N/A";
        const address = selectedOpt.getAttribute("data-address") || "";

        document.getElementById("billingAttentionInput").value = contact || clientName || "";

        // Preview Details Box
        if (detailsBox) {
            document.getElementById("clClientName").innerText = clientName;
            document.getElementById("clGstin").innerText = gstin;
            document.getElementById("clState").innerText = state;
            if (address) {
                document.getElementById("clAddress").innerText = address;
                document.getElementById("clAddressRow").classList.remove("d-none");
            } else {
                document.getElementById("clAddressRow").classList.add("d-none");
            }
            detailsBox.classList.remove("d-none");
        }

        // Clear Work Order if it was previously auto-filled from a project
        const workOrderInput = document.getElementById("workOrderNoInput");
        if (workOrderInput && workOrderInput.value.startsWith("WO-PRJ-")) {
            workOrderInput.value = "";
        }

        // Auto-fill First Item Description if empty or auto-filled
        const firstRow = document.querySelector(".item-row");
        if (firstRow) {
            const descInput = firstRow.querySelector(".item-desc");
            if (descInput && (!descInput.value.trim() || descInput.dataset.autoFilled === "true")) {
                descInput.value = `Professional & Consultancy Services - ${clientName}`;
                descInput.dataset.autoFilled = "true";
            }
        }

        // Recheck interstate / intrastate split for existing rows
        recheckGstTaxes();
    }

    function isInterStateSelected() {
        const isProjectMode = document.getElementById("radioTypeProject")?.checked ?? true;
        let state = "";
        if (isProjectMode) {
            const select = document.getElementById("projectSelect");
            if (select && select.selectedIndex > 0) {
                const opt = select.options[select.selectedIndex];
                state = opt.getAttribute("data-state") || "";
            }
        } else {
            const select = document.getElementById("clientSelect");
            if (select && select.selectedIndex > 0) {
                const opt = select.options[select.selectedIndex];
                state = opt.getAttribute("data-state") || "";
            }
        }
        return state && COMPANY_STATE_CODE && state !== COMPANY_STATE_CODE;
    }

    function recheckGstTaxes() {
        const rows = document.querySelectorAll(".item-row");
        rows.forEach(row => {
            const gstInput = row.querySelector(".item-gst");
            if (gstInput) onGstChange(gstInput);
        });
        recalcAll();
    }

    function onGstChange(gstInput) {
        const row = gstInput.closest(".item-row");
        const gstVal = parseFloat(gstInput.value) || 0;
        const igstInput = row.querySelector(".item-igst");
        const cgstInput = row.querySelector(".item-cgst");
        const sgstInput = row.querySelector(".item-sgst");

        if (isInterStateSelected()) {
            igstInput.value = gstVal.toFixed(2);
            cgstInput.value = (0).toFixed(2);
            sgstInput.value = (0).toFixed(2);
        } else {
            igstInput.value = (0).toFixed(2);
            const half = gstVal / 2;
            cgstInput.value = half.toFixed(2);
            sgstInput.value = half.toFixed(2);
        }
        recalcRow(gstInput);
    }

    function recalcRow(inputElem) {
        const row = inputElem.closest(".item-row");
        const qty = parseFloat(row.querySelector(".item-qty").value) || 0;
        const rate = parseFloat(row.querySelector(".item-rate").value) || 0;
        const amount = qty * rate;

        row.querySelector(".item-amount").value = amount.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        recalcAll();
    }

    function recalcAll() {
        let subtotal = 0;
        let totalIgst = 0;
        let totalCgst = 0;
        let totalSgst = 0;

        const rows = document.querySelectorAll(".item-row");
        rows.forEach(row => {
            const qty = parseFloat(row.querySelector(".item-qty").value) || 0;
            const rate = parseFloat(row.querySelector(".item-rate").value) || 0;
            const lineAmt = qty * rate;

            const igstRate = parseFloat(row.querySelector(".item-igst").value) || 0;
            const cgstRate = parseFloat(row.querySelector(".item-cgst").value) || 0;
            const sgstRate = parseFloat(row.querySelector(".item-sgst").value) || 0;

            const lineIgst = lineAmt * (igstRate / 100);
            const lineCgst = lineAmt * (cgstRate / 100);
            const lineSgst = lineAmt * (sgstRate / 100);

            subtotal += lineAmt;
            totalIgst += lineIgst;
            totalCgst += lineCgst;
            totalSgst += lineSgst;
        });

        const gross = subtotal + totalIgst + totalCgst + totalSgst;
        const deduction = parseFloat(document.getElementById("deductionAmountInput").value) || 0;
        const netPayable = Math.max(0, gross - deduction);

        const formatInr = num => num.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        document.getElementById("lblSubtotal").innerText = formatInr(subtotal);
        document.getElementById("lblIgst").innerText = formatInr(totalIgst);
        document.getElementById("lblCgst").innerText = formatInr(totalCgst);
        document.getElementById("lblSgst").innerText = formatInr(totalSgst);
        document.getElementById("lblGross").innerText = formatInr(gross);
        document.getElementById("lblNetPayable").innerText = formatInr(netPayable);
    }

    function addRow() {
        const tbody = document.getElementById("itemsTableBody");
        const currentCount = tbody.querySelectorAll(".item-row").length + 1;

        const isInter = isInterStateSelected();
        const defaultGst = 18;
        const defIgst = isInter ? defaultGst : 0;
        const defCgst = isInter ? 0 : 9;
        const defSgst = isInter ? 0 : 9;

        const tr = document.createElement("tr");
        tr.className = "item-row";
        tr.dataset.rowIdx = currentCount;
        tr.innerHTML = `
            <td class="text-center fw-semibold text-secondary row-num">${currentCount}</td>
            <td>
                <textarea name="itemDescription[]" class="form-control inv-input item-desc" rows="2" placeholder="Item Name &amp; Description" required></textarea>
            </td>
            <td>
                <input type="text" name="itemHsn[]" class="form-control inv-input item-hsn" placeholder="HSN Code" value="998313" />
            </td>
            <td>
                <input type="number" step="0.01" name="itemGst[]" class="form-control inv-input item-gst" placeholder="GST %" value="${defaultGst}" oninput="onGstChange(this)" />
            </td>
            <td>
                <input type="number" step="0.01" name="itemIgst[]" class="form-control inv-input item-igst" placeholder="IGST %" value="${defIgst}" oninput="recalcRow(this)" />
            </td>
            <td>
                <input type="number" step="0.01" name="itemCgst[]" class="form-control inv-input item-cgst" placeholder="CGST %" value="${defCgst}" oninput="recalcRow(this)" />
            </td>
            <td>
                <input type="number" step="0.01" name="itemSgst[]" class="form-control inv-input item-sgst" placeholder="SGST %" value="${defSgst}" oninput="recalcRow(this)" />
            </td>
            <td>
                <input type="number" step="0.01" name="itemQty[]" class="form-control inv-input item-qty" placeholder="Qty" value="1" min="0.01" oninput="recalcRow(this)" required />
            </td>
            <td>
                <input type="number" step="0.01" name="itemRate[]" class="form-control inv-input item-rate text-end" placeholder="0.00" value="0.00" min="0" oninput="recalcRow(this)" required />
            </td>
            <td>
                <input type="text" class="form-control inv-input item-amount text-end bg-light fw-semibold" placeholder="0.00" value="0.00" readonly />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm text-danger rounded-3" style="background: #FEE2E2; width: 32px; height: 32px; padding: 0;" title="Delete Row" onclick="deleteRow(this)">
                    <i class="fa-solid fa-trash-can" style="font-size: 13px;"></i>
                </button>
            </td>
        `;

        tbody.appendChild(tr);
        reindexRows();
        recalcAll();
    }

    function deleteRow(btn) {
        const tbody = document.getElementById("itemsTableBody");
        const rows = tbody.querySelectorAll(".item-row");
        if (rows.length <= 1) {
            alert("An invoice requires at least one line item.");
            return;
        }
        btn.closest(".item-row").remove();
        reindexRows();
        recalcAll();
    }

    function reindexRows() {
        const rows = document.querySelectorAll(".item-row");
        rows.forEach((row, idx) => {
            const num = idx + 1;
            row.dataset.rowIdx = num;
            const numCell = row.querySelector(".row-num");
            if (numCell) numCell.innerText = num;
        });
    }

    // =========================================================================
    // Quick Add Client from Modal -> Persist in Master & Auto-select
    // =========================================================================
    async function quickFetchGstin() {
        const input = document.getElementById('quickClientGstin');
        const feedback = document.getElementById('quickGstinFeedback');
        const nameEl = document.getElementById('quickClientName');
        const panEl = document.getElementById('quickClientPan');
        const stateEl = document.getElementById('quickClientState');
        const addrEl = document.getElementById('quickClientAddress');

        if (!input) return;
        const cleanGstin = input.value.trim().toUpperCase();

        if (cleanGstin.length !== 15) {
            if (feedback) {
                feedback.style.display = 'block';
                feedback.innerHTML = '<span class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i> GSTIN must be exactly 15 alphanumeric characters.</span>';
            }
            return;
        }

        // Auto-extract PAN & State Code
        if (panEl) panEl.value = cleanGstin.substring(2, 12);
        if (stateEl) stateEl.value = cleanGstin.substring(0, 2);

        if (feedback) {
            feedback.style.display = 'block';
            feedback.innerHTML = '<span class="text-primary"><i class="fa-solid fa-spinner fa-spin me-1"></i> Verifying GSTIN &amp; fetching taxpayer details...</span>';
        }

        try {
            const resp = await fetch(`/Masters/LookupGstin?gstin=${encodeURIComponent(cleanGstin)}`);
            if (resp.ok) {
                const data = await resp.json();
                if (data && data.success) {
                    if (nameEl && data.tradeName) nameEl.value = data.tradeName;
                    if (panEl && data.pan) panEl.value = data.pan;
                    if (stateEl && data.stateCode) stateEl.value = data.stateCode;
                    if (addrEl && data.address) addrEl.value = data.address;

                    if (feedback) {
                        feedback.innerHTML = `<span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i> GSTIN Verified: ${data.stateName || ''} (${data.stateCode || ''})</span>`;
                    }
                } else if (feedback) {
                    feedback.innerHTML = `<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> ${data.message || 'Auto-fetch returned no records. Check manually.'}</span>`;
                }
            }
        } catch (e) {
            if (feedback) {
                feedback.innerHTML = '<span class="text-muted"><i class="fa-solid fa-info-circle me-1"></i> Offline verification: State and PAN extracted.</span>';
            }
        }
    }

    async function saveQuickClient() {
        const errEl = document.getElementById('quickClientError');
        const btnSave = document.getElementById('btnSaveQuickClient');
        const nameEl = document.getElementById('quickClientName');
        const codeEl = document.getElementById('quickClientCode');
        const addrEl = document.getElementById('quickClientAddress');
        const gstinEl = document.getElementById('quickClientGstin');
        const panEl = document.getElementById('quickClientPan');
        const stateEl = document.getElementById('quickClientState');
        const contactEl = document.getElementById('quickClientContact');
        const phoneEl = document.getElementById('quickClientPhone');
        const emailEl = document.getElementById('quickClientEmail');

        if (errEl) errEl.classList.add('d-none');

        const clientName = (nameEl?.value || '').trim();
        if (!clientName) {
            if (errEl) {
                errEl.innerText = 'Please enter the Client / Company Name.';
                errEl.classList.remove('d-none');
            }
            nameEl?.focus();
            return;
        }

        const billingAddr = (addrEl?.value || '').trim();
        if (!billingAddr) {
            if (errEl) {
                errEl.innerText = 'Please enter a Billing Address.';
                errEl.classList.remove('d-none');
            }
            addrEl?.focus();
            return;
        }

        const originalBtnHtml = btnSave ? btnSave.innerHTML : '';
        if (btnSave) {
            btnSave.disabled = true;
            btnSave.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving to Master...';
        }

        try {
            const formData = new FormData();
            formData.append('clientCode', codeEl?.value || '');
            formData.append('clientName', clientName);
            formData.append('billingAddress', billingAddr);
            formData.append('gstin', gstinEl?.value || '');
            formData.append('pan', panEl?.value || '');
            formData.append('stateCode', stateEl?.value || '07');
            formData.append('contactPerson', contactEl?.value || '');
            formData.append('phone', phoneEl?.value || '');
            formData.append('email', emailEl?.value || '');

            const token = document.querySelector('#quickClientForm input[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('form input[name="__RequestVerificationToken"]')?.value;
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            const response = await fetch('/Sales/QuickCreateClient', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result && result.success && result.client) {
                const c = result.client;
                const clientSelect = document.getElementById('clientSelect');

                if (clientSelect) {
                    const newOpt = document.createElement('option');
                    newOpt.value = c.id;
                    newOpt.text = c.displayText;
                    newOpt.setAttribute('data-client-id', c.id);
                    newOpt.setAttribute('data-client-name', c.clientName);
                    newOpt.setAttribute('data-contact', c.contactPerson || c.clientName);
                    newOpt.setAttribute('data-state', c.stateCode || '07');
                    newOpt.setAttribute('data-gstin', c.gstin || '');
                    newOpt.setAttribute('data-address', c.billingAddress || '');
                    clientSelect.appendChild(newOpt);

                    // Ensure Client radio is selected
                    const radioClient = document.getElementById('radioTypeClient');
                    if (radioClient && !radioClient.checked) {
                        radioClient.checked = true;
                        toggleInvoiceAgainst();
                    }

                    clientSelect.value = c.id;
                    onClientChange();
                }

                // Close modal
                const modalEl = document.getElementById('quickAddClientModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                }

                // Reset modal form
                document.getElementById('quickClientForm')?.reset();
                if (codeEl) {
                    const now = new Date();
                    const mm = String(now.getMonth() + 1).padStart(2, '0');
                    const dd = String(now.getDate()).padStart(2, '0');
                    const hh = String(now.getHours()).padStart(2, '0');
                    const min = String(now.getMinutes()).padStart(2, '0');
                    codeEl.value = `CL-${mm}${dd}${hh}${min}`;
                }
                const feedbackEl = document.getElementById('quickGstinFeedback');
                if (feedbackEl) feedbackEl.style.display = 'none';

            } else {
                if (errEl) {
                    errEl.innerText = result?.message || 'Failed to register client. Please check details.';
                    errEl.classList.remove('d-none');
                }
            }
        } catch (err) {
            console.error('Error saving client:', err);
            if (errEl) {
                errEl.innerText = 'Network or server error while registering client.';
                errEl.classList.remove('d-none');
            }
        } finally {
            if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = originalBtnHtml;
            }
        }
    }

    // Initial setup
    document.addEventListener("DOMContentLoaded", function () {
        // Quick Client Modal GSTIN listeners
        const quickGstin = document.getElementById('quickClientGstin');
        const quickPan = document.getElementById('quickClientPan');
        const quickState = document.getElementById('quickClientState');

        if (quickGstin) {
            quickGstin.addEventListener('input', function() {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                if (this.value.length >= 2 && quickState) {
                    const st = this.value.substring(0, 2);
                    if (quickState.querySelector(`option[value="${st}"]`)) {
                        quickState.value = st;
                    }
                }
                if (this.value.length >= 12 && quickPan) {
                    quickPan.value = this.value.substring(2, 12);
                }
                if (this.value.length === 15) {
                    quickFetchGstin();
                }
            });

            quickGstin.addEventListener('paste', function() {
                setTimeout(() => {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                    if (this.value.length >= 12 && quickPan) {
                        quickPan.value = this.value.substring(2, 12);
                    }
                    if (this.value.length === 15) {
                        quickFetchGstin();
                    }
                }, 50);
            });
        }
        toggleInvoiceAgainst();
        recalcAll();
    });
</script>
