                            <div class="col-md-7">
                                <label class="inv-label d-flex justify-content-between align-items-center" style="font-size: 12px;">
                                    <span>GSTIN <span class="text-muted fw-normal">(Optional)</span></span>
                                    <span class="text-muted" style="font-size: 11px;"><i class="fa-solid fa-bolt text-warning me-1"></i>Auto-fills PAN &amp; State</span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="quickClientGstin" name="gstin" class="form-control text-uppercase font-monospace" placeholder="e.g. 07AAAAA0000A1Z5" maxlength="15" autocomplete="off" />
                                    <button class="btn btn-outline-primary" type="button" id="btnQuickFetchGstin" onclick="quickFetchGstin()" title="Auto-Fetch Client details from GSTIN">
                                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Auto-Fetch
                                    </button>
                                </div>
                                <div id="quickGstinFeedback" class="mt-1" style="font-size: 11.5px; display: none;"></div>
                            </div>
                            <div class="col-md-5">
                                <label class="inv-label" style="font-size: 12px;">PAN <span class="text-muted fw-normal">(Auto / 10-Char)</span></label>
                                <input type="text" id="quickClientPan" name="pan" class="form-control form-control-sm text-uppercase font-monospace inv-input" placeholder="e.g. AAAAA0000A" maxlength="10" />
