                                            ("24", "24 - Gujarat"),
                                            ("26", "26 - Dadra & Nagar Haveli and Daman & Diu"),
                                            ("27", "27 - Maharashtra"),
                                            ("29", "29 - Karnataka"),
                                            ("30", "30 - Goa"),
                                            ("31", "31 - Lakshadweep"),
                                            ("32", "32 - Kerala"),
                                            ("33", "33 - Tamil Nadu"),
                                            ("34", "34 - Puducherry"),
                                            ("35", "35 - Andaman & Nicobar Islands"),
                                            ("36", "36 - Telangana"),
                                            ("37", "37 - Andhra Pradesh"),
                                            ("38", "38 - Ladakh")
                                        };
                                        foreach (var s in stateList)
                                        {
                                            <option value="@s.Code" selected="@(s.Code == compState ? "selected" : null)">@s.Name</option>
