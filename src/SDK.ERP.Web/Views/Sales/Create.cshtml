                            <div class="col-md-6">
                                <label class="inv-label" style="font-size: 12px;">Contact Person</label>
                                <input type="text" id="quickClientContact" name="contactPerson" class="form-control form-control-sm inv-input" placeholder="e.g. Accounts / Finance Head" />
