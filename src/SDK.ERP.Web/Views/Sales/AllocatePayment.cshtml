@model IEnumerable<SDK.ERP.Domain.Entities.Sales.SalesInvoice>
@{
    ViewData["Title"] = "Customer Payment Allocation";
    ViewData["ActiveMenu"] = "Sales";
    var invoiceList = Model ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Sales.SalesInvoice>();
    var clients = ViewBag.Clients as IEnumerable<SDK.ERP.Domain.Entities.MasterData.Client> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.Client>();
    var bankAccounts = ViewBag.BankAccounts as IEnumerable<SDK.ERP.Domain.Entities.Banking.BankAccount> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Banking.BankAccount>();
    var recentReceipts = ViewBag.RecentReceipts as IEnumerable<SDK.ERP.Domain.Entities.Sales.CustomerReceipt> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Sales.CustomerReceipt>();
    var receiptDocs = ViewBag.ReceiptDocs as Dictionary<long, SDK.ERP.Domain.Entities.Admin.DocumentAttachment> ?? new Dictionary<long, SDK.ERP.Domain.Entities.Admin.DocumentAttachment>();
    var selectedClientId = ViewBag.SelectedClientId != null ? (long?)ViewBag.SelectedClientId : null;
    var totalOutstanding = invoiceList.Sum(i => i.OutstandingBalance);
}

<style>
    .voucher-dropzone {
        border: 2px dashed #CBD5E1;
        border-radius: 12px;
        background-color: #F8FAFC;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        position: relative;
    }
    .voucher-dropzone:hover {
        border-color: #7C3AED;
        background-color: #F5F3FF;
    }
    .voucher-dropzone.dragover {
        border-color: #7C3AED;
        background-color: #EDE9FE;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
    }
    .voucher-dropzone.has-error {
        border-color: #EF4444;
        background-color: #FEF2F2;
    }
    .voucher-icon-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #EDE9FE;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .voucher-preview-box {
        border: 1px solid #A7F3D0;
        background-color: #ECFDF5;
        border-radius: 10px;
    }
</style>

<div class="mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size: 12.5px;">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">
                    <i class="fa-solid fa-house me-1 text-primary"></i> Home
                </a>
            </li>
            <li class="breadcrumb-item text-muted">Sales &amp; Receivables</li>
            <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">Multi-Invoice Allocation</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-1 fw-bold" style="color: #0F172A; font-size: 21px; letter-spacing: -0.3px;">Receipts &amp; Payment Allocation</h4>
            <p style="color: var(--erp-text-muted); margin: 0; font-size: 13px;">Split single remittance voucher across multiple outstanding client invoices</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center gap-1 bg-white p-1 rounded-pill border shadow-sm me-2">
                <a asp-controller="Sales" asp-action="AllocatePayment" class="btn btn-sm text-white px-3 py-1 rounded-pill fw-semibold shadow-sm" style="background: #7C3AED; font-size: 13px;">
                    <i class="fa-solid fa-coins me-1"></i> Multi-Invoice Allocation
                </a>
                <a asp-controller="Sales" asp-action="ProjectPayment" class="btn btn-sm btn-light px-3 py-1 rounded-pill fw-semibold text-secondary" style="font-size: 13px;">
                    <i class="fa-solid fa-diagram-project me-1"></i> Project Payment Received
                </a>
                <a asp-controller="Sales" asp-action="DirectPayment" class="btn btn-sm btn-light px-3 py-1 rounded-pill fw-semibold text-secondary" style="font-size: 13px;">
                    <i class="fa-solid fa-hand-holding-dollar me-1"></i> Direct Payment Receive
                </a>
            </div>
            <a asp-controller="Sales" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fa-solid fa-arrow-left me-1"></i> Invoices</a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert" style="border-radius: 10px;">
        <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
        <div>@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert" style="border-radius: 10px;">
        <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
        <div>@Html.Raw(TempData["ErrorMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-action="AllocatePayment" enctype="multipart/form-data" id="paymentAllocationForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Receipt Header Column -->
        <div class="col-md-4">
            <div class="erp-card shadow-sm border">
                <div class="erp-card-header bg-white border-bottom py-3">
                    <h5 class="erp-card-title fw-bold text-dark mb-0">
                        <i class="fa-solid fa-receipt me-2 text-primary"></i>Receipt Header
                    </h5>
                </div>
                <div class="erp-card-body p-4">
                    <!-- Client Selector -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 12.5px;">Select Client</label>
                        <select name="clientId" id="clientSelect" class="form-select" onchange="filterInvoicesByClient(this.value)">
                            <option value="">-- Choose Client --</option>
                            @foreach (var c in clients)
                            {
                                <option value="@c.Id" selected="@(selectedClientId == c.Id ? "selected" : null)">@c.ClientName (@c.ClientCode)</option>
                            }
                        </select>
                    </div>

                    <!-- Amount Received -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 12.5px;">
                            Amount Received (&#8377;) <span class="text-danger">*</span>
                        </label>
                        <input type="number" step="0.01" min="0.01" name="amountReceived" id="txtAmountReceived" class="form-control fw-bold fs-5 text-success" placeholder="0.00" required oninput="onAmountReceivedChange()" />
                        <small class="text-muted" style="font-size: 11px;">Enter total remittance credited to the bank.</small>
                    </div>

                    <!-- Is Advance Payment Checkbox -->
                    <div class="mb-3">
                        <div class="advance-checkbox-card p-3 rounded-3 border" id="advanceCardBox" style="background: #F8FAFC; border-color: #E2E8F0; transition: all 0.25s ease;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="form-check d-flex align-items-center gap-2 mb-0">
                                    <input type="checkbox" name="isAdvance" value="true" id="chkIsAdvance" class="form-check-input mt-0" style="width: 20px; height: 20px; cursor: pointer;" onchange="onAdvanceCheckboxToggle(this.checked)" />
                                    <label for="chkIsAdvance" class="form-check-label fw-bold mb-0 text-dark" style="font-size: 13.5px; cursor: pointer; user-select: none;">
                                        Is this amount an Advance?
                                    </label>
                                </div>
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary border px-2.5 py-1" id="advanceBadge" style="font-size: 10.5px; font-weight: 600;">
                                    Regular Payment
                                </span>
                            </div>
                            <div class="text-muted mt-2 pt-1 border-top" id="advanceHelpText" style="font-size: 11.5px; line-height: 1.4;">
                                <i class="fa-solid fa-circle-info text-primary me-1"></i> Check this box if this payment is an advance from the client; uncheck to allocate against open invoices.
                            </div>
                        </div>
                    </div>

                    <!-- Bank Account -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 12.5px;">Deposit Bank Account</label>
                        <select name="bankAccountId" class="form-select">
                            <option value="">-- Choose Bank Account --</option>
                            @if (bankAccounts.Any())
                            {
                                @foreach (var b in bankAccounts)
                                {
                                    <option value="@b.Id">@b.BankName - @b.AccountNumber</option>
                                }
                            }
                            else
                            {
                                <option value="1">HDFC Bank Ltd - 50200084920194 (Corporate Main)</option>
                            }
                        </select>
                    </div>

                    <!-- Payment Mode & Reference -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 12.5px;">Payment Mode &amp; Reference (UTR)</label>
                        <input type="text" name="paymentRef" class="form-control" placeholder="e.g. NEFT / UTR-00998822" />
                    </div>

                    <!-- MANDATORY Bank Receipt / Voucher Upload -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center justify-content-between mb-1.5">
                            <label class="form-label fw-semibold mb-0" style="font-size: 12.5px;">
                                Bank Receipt / Voucher <span class="text-danger">*</span>
                            </label>
                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5" style="font-size: 10px; font-weight: 700; letter-spacing: 0.3px;">
                                MANDATORY
                            </span>
                        </div>

                        <!-- Hidden File Input -->
                        <input type="file" name="receiptVoucher" id="receiptVoucher" class="d-none" accept=".pdf,.png,.jpg,.jpeg,.webp" required onchange="handleFileChange(this)" />

                        <!-- Interactive Drag & Drop Box -->
                        <div class="voucher-dropzone p-3 text-center" id="voucherDropZone" onclick="document.getElementById('receiptVoucher').click()">
                            <div id="dropzonePrompt">
                                <div class="voucher-icon-circle mx-auto mb-2">
                                    <i class="fa-solid fa-cloud-arrow-up text-primary fs-5"></i>
                                </div>
                                <div class="fw-bold text-dark" style="font-size: 13px;">Upload Bank Receipt or Voucher</div>
                                <div class="text-muted mt-1" style="font-size: 11.5px;">Drag &amp; drop file here, or click to browse</div>
                                <div class="badge bg-white text-secondary border mt-2 px-2.5 py-1" style="font-size: 10.5px;">
                                    PDF, JPG, PNG, WEBP (Max: 15MB)
                                </div>
                            </div>

                            <!-- Selected File Details Preview -->
                            <div id="filePreviewContainer" class="voucher-preview-box p-3 d-none text-start">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                                        <div class="rounded-circle p-2 bg-white text-success shadow-sm">
                                            <i class="fa-solid fa-file-circle-check fs-5"></i>
                                        </div>
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate" id="previewFileName" style="font-size: 12.5px;">voucher.pdf</div>
                                            <div class="text-muted" id="previewFileSize" style="font-size: 11px;">250 KB</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle" onclick="removeVoucherFile(event)" title="Remove and choose another file">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Validation Error Display -->
                        <div class="text-danger mt-1 fw-semibold d-none" id="voucherErrorMsg" style="font-size: 11.5px;">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Bank receipt or remittance voucher is required.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoices Allocation Grid Column -->
        <div class="col-md-8">
            <div class="erp-card shadow-sm border">
                <div class="erp-card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="erp-card-title fw-bold text-dark mb-0">
                            <i class="fa-solid fa-list-check me-2 text-primary"></i>Outstanding Invoices Allocation Grid
                        </h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (invoiceList.Any())
                        {
                            <button type="button" id="btnAutoAllocate" class="btn btn-xs btn-outline-primary rounded-pill px-3 py-1" style="font-size: 11.5px;" onclick="autoAllocate()">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Auto-Allocate Amount
                            </button>
                        }
                        <span class="badge bg-primary px-3 py-1.5" style="font-size: 12px;">Total Outstanding: &#8377; @totalOutstanding.ToString("N2")</span>
                    </div>
                </div>

                <!-- Advance Mode Active Callout Banner -->
                <div id="advanceModeBanner" class="p-3 bg-info-subtle border-bottom d-none">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2 text-info-emphasis">
                            <i class="fa-solid fa-hand-holding-dollar fs-4 text-info"></i>
                            <div>
                                <div class="fw-bold" style="font-size: 13.5px;">Advance Payment Mode Active</div>
                                <div style="font-size: 11.5px;">This entire payment will be recorded directly into the customer's advance ledger without adjusting against open invoices.</div>
                            </div>
                        </div>
                        <span class="badge bg-info text-white px-3 py-1.5 fw-semibold" style="font-size: 12px;">
                            Advance: <span id="advanceBannerAmount">&#8377; 0.00</span>
                        </span>
                    </div>
                </div>

                <div class="erp-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0" id="invoicesTable" style="font-size: 13px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Invoice Number</th>
                                    <th>Client</th>
                                    <th>Total Bill</th>
                                    <th>Outstanding</th>
                                    <th style="width: 190px;">Allocate Amount (&#8377;)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (invoiceList.Any())
                                {
                                    @foreach (var inv in invoiceList)
                                    {
                                        <tr class="invoice-row" data-client-id="@inv.ClientId" data-outstanding="@inv.OutstandingBalance">
                                            <td class="ps-3 fw-bold text-primary">
                                                <i class="fa-solid fa-file-invoice text-muted me-1"></i> @inv.InvoiceNumber
                                            </td>
                                            <td>@(inv.Client?.ClientName ?? "N/A")</td>
                                            <td>&#8377; @inv.TotalInvoiceValue.ToString("N2")</td>
                                            <td class="text-danger fw-bold">&#8377; @inv.OutstandingBalance.ToString("N2")</td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">&#8377;</span>
                                                    <input type="number" step="0.01" min="0" max="@inv.OutstandingBalance" name="alloc_@inv.Id" class="form-control text-end fw-bold invoice-alloc-input" placeholder="0.00" oninput="updateAllocationSummary()" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr id="noInvoicesRow">
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <div class="d-inline-flex p-3 rounded-circle bg-success-subtle text-success mb-2">
                                                <i class="fa-solid fa-circle-check fs-3"></i>
                                            </div>
                                            <div class="fw-semibold text-dark fs-6">No unpaid or outstanding invoices in the database.</div>
                                            <div class="text-muted mt-1" style="font-size: 12.5px;" id="noInvoicesPrompt">
                                                Please check the <strong>"Is this amount an Advance?"</strong> box above to record this payment as a <strong>Customer Advance</strong>.
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer Summary and Action Buttons -->
                <div class="erp-card-body border-top bg-light p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div style="font-size: 12.5px;">
                            <span class="text-muted">Total Allocated:</span>
                            <span class="fw-bold text-dark ms-1" id="lblTotalAllocated">&#8377; 0.00</span>
                        </div>
                        <div class="vr"></div>
                        <div style="font-size: 12.5px;">
                            <span class="text-muted">Unallocated / Advance:</span>
                            <span class="fw-bold text-success ms-1" id="lblUnallocated">&#8377; 0.00</span>
                        </div>
                    </div>

                    <div>
                        <button type="submit" class="btn @(invoiceList.Any() ? "btn-success" : "btn-primary") px-4 fw-bold shadow-sm" id="btnSubmitPayment">
                            @if (invoiceList.Any())
                            {
                                <i class="fa-solid fa-check me-1"></i> <span>Commit Payment Allocation</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-hand-holding-dollar me-1"></i> <span>Record Customer Advance &amp; Voucher</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Recent Receipts & Vouchers Audit Grid -->
@if (recentReceipts.Any())
{
    <div class="erp-card shadow-sm border mt-4">
        <div class="erp-card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="erp-card-title fw-bold text-dark mb-0">
                <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Recent Payment Receipts &amp; Bank Vouchers
            </h5>
            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fw-semibold">
                General Ledger Auto-Posted
            </span>
        </div>
        <div class="erp-card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Receipt No</th>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Payment Mode / Ref</th>
                            <th class="text-end">Amount Received</th>
                            <th class="text-end">Unallocated / Advance</th>
                            <th class="text-center">Attached Bank Receipt</th>
                            <th class="text-center pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in recentReceipts)
                        {
                            var hasDoc = r.ReceiptDocId.HasValue && receiptDocs.ContainsKey(r.ReceiptDocId.Value);
                            var doc = hasDoc ? receiptDocs[r.ReceiptDocId!.Value] : null;

                            <tr>
                                <td class="ps-3 fw-bold text-primary">
                                    <div>@r.ReceiptNumber</div>
                                    @if (r.IsAdvance || (r.UnallocatedAmount > 0 && r.UnallocatedAmount == r.AmountReceived))
                                    {
                                        <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle mt-1" style="font-size: 10px; font-weight: 600;">
                                            <i class="fa-solid fa-coins me-1"></i>Advance Receipt
                                        </span>
                                    }
                                </td>
                                <td>@r.ReceiptDate.ToString("dd MMM yyyy")</td>
                                <td>@(r.Client?.ClientName ?? "N/A")</td>
                                <td>
                                    <strong>@r.PaymentMode</strong>
                                    @if (!string.IsNullOrEmpty(r.TransactionRefNo))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 180px;">@r.TransactionRefNo</small>
                                    }
                                </td>
                                <td class="text-end fw-bold text-success">&#8377; @r.AmountReceived.ToString("N2")</td>
                                <td class="text-end fw-semibold text-secondary">&#8377; @r.UnallocatedAmount.ToString("N2")</td>
                                <td class="text-center">
                                    @if (doc != null)
                                    {
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-primary py-0.5 px-2.5 rounded-pill fw-semibold" style="font-size: 11.5px;" title="View uploaded bank voucher">
                                            <i class="fa-solid fa-paperclip me-1 text-danger"></i> View Voucher
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size: 11px;">No voucher</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                        <i class="fa-solid fa-circle-check me-1"></i> Posted
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<script>
    // Drag & Drop File Upload Logic
    const dropZone = document.getElementById('voucherDropZone');
    const fileInput = document.getElementById('receiptVoucher');
    const promptContainer = document.getElementById('dropzonePrompt');
    const previewContainer = document.getElementById('filePreviewContainer');
    const previewFileName = document.getElementById('previewFileName');
    const previewFileSize = document.getElementById('previewFileSize');
    const errorMsg = document.getElementById('voucherErrorMsg');

    ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.add('dragover');
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('dragover');
        }, false);
    });

    dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
            fileInput.files = files;
            handleFileSelection(files[0]);
        }
    });

    function handleFileChange(input) {
        if (input.files && input.files[0]) {
            handleFileSelection(input.files[0]);
        }
    }

    function handleFileSelection(file) {
        const allowedExts = ['.pdf', '.png', '.jpg', '.jpeg', '.webp'];
        const fileName = file.name;
        const ext = '.' + fileName.split('.').pop().toLowerCase();

        if (!allowedExts.includes(ext)) {
            alert('Invalid file format. Please upload a valid document (PDF, PNG, JPG, WEBP).');
            removeVoucherFile();
            return;
        }

        if (file.size > 15 * 1024 * 1024) {
            alert('File exceeds the 15 MB size limit.');
            removeVoucherFile();
            return;
        }

        dropZone.classList.remove('has-error');
        errorMsg.classList.add('d-none');

        previewFileName.innerText = fileName;
        previewFileSize.innerText = formatFileSize(file.size);

        promptContainer.classList.add('d-none');
        previewContainer.classList.remove('d-none');
    }

    function removeVoucherFile(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        fileInput.value = '';
        promptContainer.classList.remove('d-none');
        previewContainer.classList.add('d-none');
    }

    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    // Form Validation on Submit
    document.getElementById('paymentAllocationForm').addEventListener('submit', function (e) {
        const amount = parseFloat(document.getElementById('txtAmountReceived').value) || 0;
        if (amount <= 0) {
            e.preventDefault();
            alert('Please enter a valid amount received greater than 0.');
            document.getElementById('txtAmountReceived').focus();
            return false;
        }

        if (!fileInput.files || fileInput.files.length === 0) {
            e.preventDefault();
            dropZone.classList.add('has-error');
            errorMsg.classList.remove('d-none');
            dropZone.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }

        const isAdvance = document.getElementById('chkIsAdvance').checked;
        const invoiceRows = document.querySelectorAll('.invoice-row');
        const hasInvoices = invoiceRows.length > 0;

        // If client has NO open invoices and isAdvance is NOT checked:
        if (!hasInvoices && !isAdvance) {
            e.preventDefault();
            const shouldCheck = confirm('There are no outstanding invoices for this client.\n\nIs this amount an Advance? Click OK to mark it as an Advance and proceed, or Cancel to review.');
            if (shouldCheck) {
                document.getElementById('chkIsAdvance').checked = true;
                onAdvanceCheckboxToggle(true);
                // Resubmit after setting advance
                setTimeout(() => document.getElementById('paymentAllocationForm').submit(), 100);
            } else {
                document.getElementById('chkIsAdvance').focus();
            }
            return false;
        }

        // If there ARE open invoices, but user allocated 0.00 and did NOT check advance:
        if (hasInvoices && !isAdvance) {
            let totalAlloc = 0;
            document.querySelectorAll('.invoice-alloc-input').forEach(i => totalAlloc += (parseFloat(i.value) || 0));
            if (totalAlloc <= 0) {
                e.preventDefault();
                const confirmAdvance = confirm('You have not allocated any amount to the outstanding invoices.\n\nDid you intend to record this entire amount as an Advance? Click OK to mark as Advance and continue, or Cancel to allocate against invoices.');
                if (confirmAdvance) {
                    document.getElementById('chkIsAdvance').checked = true;
                    onAdvanceCheckboxToggle(true);
                    setTimeout(() => document.getElementById('paymentAllocationForm').submit(), 100);
                }
                return false;
            }
        }
    });

    // Advance Mode Checkbox Toggle Handler
    function onAdvanceCheckboxToggle(isChecked) {
        const advanceCard = document.getElementById('advanceCardBox');
        const advanceBadge = document.getElementById('advanceBadge');
        const advanceHelp = document.getElementById('advanceHelpText');
        const advanceBanner = document.getElementById('advanceModeBanner');
        const btnSubmit = document.getElementById('btnSubmitPayment');
        const autoAllocBtn = document.getElementById('btnAutoAllocate');
        const hasInvoices = document.querySelectorAll('.invoice-row').length > 0;

        if (isChecked) {
            if (advanceCard) {
                advanceCard.style.backgroundColor = '#EFF6FF';
                advanceCard.style.borderColor = '#93C5FD';
            }
            if (advanceBadge) {
                advanceBadge.className = 'badge rounded-pill bg-primary text-white px-2.5 py-1';
                advanceBadge.innerHTML = '<i class="fa-solid fa-check me-1"></i>Advance Mode Active';
            }
            if (advanceHelp) {
                advanceHelp.innerHTML = '<i class="fa-solid fa-circle-check text-success me-1"></i> <strong>Marked as Customer Advance:</strong> Amount will be credited to advance ledger without invoice deductions.';
            }
            if (advanceBanner) {
                advanceBanner.classList.remove('d-none');
            }
            if (autoAllocBtn) {
                autoAllocBtn.classList.add('disabled');
            }

            // Disable all invoice inputs and clear values
            document.querySelectorAll('.invoice-alloc-input').forEach(input => {
                input.value = '0.00';
                input.disabled = true;
            });

            if (btnSubmit) {
                btnSubmit.className = 'btn btn-primary px-4 fw-bold shadow-sm';
                btnSubmit.innerHTML = '<i class="fa-solid fa-hand-holding-dollar me-1"></i> Record Customer Advance &amp; Voucher';
            }
        } else {
            if (advanceCard) {
                advanceCard.style.backgroundColor = '#F8FAFC';
                advanceCard.style.borderColor = '#E2E8F0';
            }
            if (advanceBadge) {
                advanceBadge.className = 'badge rounded-pill bg-secondary-subtle text-secondary border px-2.5 py-1';
                advanceBadge.innerHTML = 'Regular Payment';
            }
            if (advanceHelp) {
                advanceHelp.innerHTML = '<i class="fa-solid fa-circle-info text-primary me-1"></i> Check this box if this payment is an advance from the client; uncheck to allocate against open invoices.';
            }
            if (advanceBanner) {
                advanceBanner.classList.add('d-none');
            }
            if (autoAllocBtn) {
                autoAllocBtn.classList.remove('disabled');
            }

            // Re-enable invoice inputs
            document.querySelectorAll('.invoice-alloc-input').forEach(input => {
                input.disabled = false;
            });

            if (btnSubmit) {
                if (hasInvoices) {
                    btnSubmit.className = 'btn btn-success px-4 fw-bold shadow-sm';
                    btnSubmit.innerHTML = '<i class="fa-solid fa-check me-1"></i> Commit Payment Allocation';
                } else {
                    btnSubmit.className = 'btn btn-outline-secondary px-4 fw-bold shadow-sm';
                    btnSubmit.innerHTML = '<i class="fa-solid fa-circle-exclamation me-1"></i> Advance Check Required';
                }
            }
        }

        updateAllocationSummary();
    }

    // Real-time Calculation of Allocations
    function onAmountReceivedChange() {
        updateAllocationSummary();
    }

    function updateAllocationSummary() {
        const amountReceived = parseFloat(document.getElementById('txtAmountReceived').value) || 0;
        const isAdvance = document.getElementById('chkIsAdvance') ? document.getElementById('chkIsAdvance').checked : false;
        let totalAlloc = 0;

        if (isAdvance) {
            totalAlloc = 0;
        } else {
            document.querySelectorAll('.invoice-alloc-input').forEach(input => {
                const val = parseFloat(input.value) || 0;
                totalAlloc += val;
            });
        }

        const unallocated = Math.max(0, amountReceived - totalAlloc);
        document.getElementById('lblTotalAllocated').innerHTML = '&#8377; ' + totalAlloc.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('lblUnallocated').innerHTML = '&#8377; ' + (isAdvance ? amountReceived : unallocated).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        const bannerAmt = document.getElementById('advanceBannerAmount');
        if (bannerAmt) {
            bannerAmt.innerHTML = '&#8377; ' + (isAdvance ? amountReceived : unallocated).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    }

    // Auto-allocate helper: sequentially fills unpaid invoices up to amount received
    function autoAllocate() {
        const isAdvance = document.getElementById('chkIsAdvance') && document.getElementById('chkIsAdvance').checked;
        if (isAdvance) {
            alert('Cannot auto-allocate while "Is this amount an Advance?" is checked. Uncheck the box first if you wish to allocate to invoices.');
            return;
        }

        let remaining = parseFloat(document.getElementById('txtAmountReceived').value) || 0;
        if (remaining <= 0) {
            alert('Please enter the Amount Received before auto-allocating.');
            document.getElementById('txtAmountReceived').focus();
            return;
        }

        document.querySelectorAll('.invoice-row').forEach(row => {
            if (row.style.display === 'none') return;
            const outstanding = parseFloat(row.getAttribute('data-outstanding')) || 0;
            const input = row.querySelector('.invoice-alloc-input');
            if (remaining > 0) {
                const alloc = Math.min(remaining, outstanding);
                input.value = alloc.toFixed(2);
                remaining -= alloc;
            } else {
                input.value = '0.00';
            }
        });

        updateAllocationSummary();
    }

    function filterInvoicesByClient(clientId) {
        if (!clientId) {
            window.location.href = '@Url.Action("AllocatePayment", "Sales")';
        } else {
            window.location.href = '@Url.Action("AllocatePayment", "Sales")?clientId=' + clientId;
        }
    }

    // On page load: If client has 0 invoices, guide user regarding Advance mode
    document.addEventListener('DOMContentLoaded', function () {
        const hasInvoices = document.querySelectorAll('.invoice-row').length > 0;
        const clientSelect = document.getElementById('clientSelect');
        if (!hasInvoices && clientSelect && clientSelect.value) {
            // Suggest or pre-check advance when client has no invoices
            const chk = document.getElementById('chkIsAdvance');
            if (chk) {
                chk.checked = true;
                onAdvanceCheckboxToggle(true);
            }
        }
    });
</script>

