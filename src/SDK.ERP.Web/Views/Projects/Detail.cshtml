<!-- MODAL: ADD SITE EXPENSE -->
<!-- ========================================================================= -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Projects" asp-action="AddExpense" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model?.Id" />
                <div class="modal-header bg-light">
                    <h6 class="modal-title fw-bold" id="addExpenseModalLabel">
                        <i class="fa-solid fa-money-bill-transfer text-primary me-2"></i>Add Project Site Expense
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" style="font-size: 13px;">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 12px;">Expense Date <span class="text-danger">*</span></label>
                            <input type="date" name="expenseDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 12px;">Amount (&#8377;) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="1" name="amount" class="form-control fw-bold text-danger" placeholder="0.00" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold" style="font-size: 12px;">Expense Description <span class="text-danger">*</span></label>
                            <input type="text" name="description" class="form-control" placeholder="e.g. Local transport, materials loading, site labour" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold" style="font-size: 12px;">Upload Receipt (Optional)</label>
                            <input type="file" name="receiptFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: ADD DELIVERY CHALLAN -->
<!-- ========================================================================= -->
<div class="modal fade" id="addDeliveryModal" tabindex="-1" aria-labelledby="addDeliveryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Projects" asp-action="CreateDelivery" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model?.Id" />
                <div class="modal-header bg-light">
                    <h6 class="modal-title fw-bold" id="addDeliveryModalLabel">
                        <i class="fa-solid fa-truck text-info me-2"></i>Issue Material Delivery Challan
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" style="font-size: 13px;">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 12px;">Challan No.</label>
                            <input type="text" name="dcNumber" class="form-control" value="DC-@DateTime.Now.ToString("yyyyMMdd-HHmm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 12px;">Delivery Date</label>
                            <input type="date" name="deliveryDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 12px;">Dispatch Mode</label>
                            <input type="text" name="dispatchMode" class="form-control" value="Company Vehicle" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 12px;">Recipient / Site Contact</label>
                            <input type="text" name="recipientName" class="form-control" value="@(Model?.Client?.ClientName ?? "Site Incharge")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" style="font-size: 12px;">Materials Dispatched Summary</label>
                            <textarea name="materialSummary" class="form-control" rows="2" placeholder="List dispatched items or bundles..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white btn-sm px-4 fw-bold">Dispatch Challan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function saveReminder() {
        const date = document.getElementById("reminderDateInput").value;
        const note = document.getElementById("reminderNoteInput").value.trim();
        if (!note) {
            alert("Please enter a reminder note.");
            return;
        }

        const container = document.getElementById("remindersContainer");
        const entry = document.createElement("div");
        entry.className = "d-flex align-items-center justify-content-between p-2 mb-1 border rounded bg-light";
        entry.style.fontSize = "12px";
        entry.innerHTML = `
            <div>
                <strong class="text-danger d-block">${date}</strong>
                <span>${note}</span>
            </div>
            <button type="button" class="btn btn-link btn-sm text-danger p-0" onclick="this.parentElement.remove();"><i class="fa-solid fa-xmark"></i></button>
        `;

        if (container.innerText.includes("No reminders added")) {
            container.innerHTML = "";
        }
        container.appendChild(entry);

        const modal = bootstrap.Modal.getInstance(document.getElementById("addReminderModal"));
        modal.hide();
    }

    function copyDescPath(el) {
        const text = el.getAttribute("data-path");
        if (!text) return;
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
                alert("File path copied to clipboard:\n" + text);
            }).catch(function () {
                prompt("Copy path below:", text);
            });
        } else {
            prompt("Copy path below:", text);
        }
    }
</script>
