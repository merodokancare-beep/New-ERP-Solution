<!-- MODAL: ADD REMINDER -->
<!-- ========================================================================= -->
<div class="modal fade" id="addReminderModal" tabindex="-1" aria-labelledby="addReminderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 bg-light">
                <h6 class="modal-title fw-bold" id="addReminderModalLabel" style="font-size: 13.5px;">
                    <i class="fa-solid fa-bell text-danger me-1"></i> Add Project Reminder
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3" style="font-size: 12.5px;">
                <div class="mb-2">
                    <label class="form-label fw-bold mb-1">Reminder Date</label>
                    <input type="date" id="reminderDateInput" class="form-control form-control-sm" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
