<!-- ========================================================================= -->
<!-- MODAL: VIEW PROJECT EXPENSES BREAKDOWN -->
<!-- ========================================================================= -->
<div class="modal fade" id="expenseBreakdownModal" tabindex="-1" aria-labelledby="expenseBreakdownModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom">
                <div>
                    <h6 class="modal-title fw-bold text-dark mb-0" id="expenseBreakdownModalLabel">
                        <i class="fa-solid fa-receipt text-danger me-2"></i>Project Expense Breakdown
                    </h6>
                    <small class="text-muted" style="font-size: 12px;">Detailed ledger of vendor procurement POs &amp; field site expenses billed against this project</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Summary KPI Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Total Project Expenses</span>
                            <h4 class="fw-bold text-danger my-1">&#8377; @totalExpenses.ToString("N2")</h4>
                            <span class="text-secondary" style="font-size: 11.5px;">All procurement POs + field expenses</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Procurement Purchase Orders</span>
                            <h4 class="fw-bold text-primary my-1">&#8377; @procurementPos.Sum(p => p.TaxableAmount).ToString("N2")</h4>
                            <span class="text-secondary" style="font-size: 11.5px;">@procurementPos.Count() Vendor PO(s) linked</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Direct Site Expenses</span>
                            <h4 class="fw-bold text-success my-1">&#8377; @expenses.Sum(e => e.Amount).ToString("N2")</h4>
                            <span class="text-secondary" style="font-size: 11.5px;">@expenses.Count() Direct expense entry(s)</span>
                        </div>
                    </div>
                </div>

                <!-- Nav Tabs for Breakdown -->
                <ul class="nav nav-tabs mb-3" id="expenseTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-dark" id="pos-tab" data-bs-toggle="tab" data-bs-target="#posTabPane" type="button" role="tab" style="font-size: 13px;">
                            <i class="fa-solid fa-cart-shopping text-primary me-1"></i> Vendor Purchase Orders (@procurementPos.Count())
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark" id="site-tab" data-bs-toggle="tab" data-bs-target="#siteTabPane" type="button" role="tab" style="font-size: 13px;">
                            <i class="fa-solid fa-money-bill-wave text-success me-1"></i> Direct Site Expenses (@expenses.Count())
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="expenseTabsContent">
                    <!-- Tab 1: Procurement POs -->
                    <div class="tab-pane fade show active" id="posTabPane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th>PO Number</th>
                                        <th>Date</th>
                                        <th>Vendor</th>
                                        <th class="text-end">Taxable Amount</th>
                                        <th class="text-end">GST Amount</th>
                                        <th class="text-end">Total PO Value</th>
                                        <th>Approval Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (procurementPos.Any())
                                    {
                                        @foreach (var po in procurementPos)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@po.PoNumber</td>
                                                <td>@po.PoDate.ToString("dd MMM yyyy")</td>
                                                <td>@(po.Vendor?.VendorName ?? "N/A")</td>
                                                <td class="text-end fw-bold text-dark">&#8377; @po.TaxableAmount.ToString("N2")</td>
                                                <td class="text-end text-muted">&#8377; @po.GstAmount.ToString("N2")</td>
                                                <td class="text-end fw-bold text-danger">&#8377; @po.TotalPoValue.ToString("N2")</td>
                                                <td>
                                                    <span class="badge @(po.ApprovalStatus == "APPROVED" ? "bg-success" : (po.ApprovalStatus == "REJECTED" ? "bg-danger" : "bg-warning text-dark"))">
                                                        @(string.IsNullOrWhiteSpace(po.ApprovalStatus) ? "DRAFT" : po.ApprovalStatus)
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                No procurement purchase orders linked to this project.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                @if (procurementPos.Any())
                                {
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="3" class="text-end">Total PO Expenses:</td>
                                            <td class="text-end text-dark">&#8377; @procurementPos.Sum(p => p.TaxableAmount).ToString("N2")</td>
                                            <td class="text-end text-muted">&#8377; @procurementPos.Sum(p => p.GstAmount).ToString("N2")</td>
                                            <td class="text-end text-danger">&#8377; @procurementPos.Sum(p => p.TotalPoValue).ToString("N2")</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>

                    <!-- Tab 2: Direct Site Expenses -->
                    <div class="tab-pane fade" id="siteTabPane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Description</th>
                                        <th>Incurred By</th>
                                        <th>Payment Mode</th>
                                        <th class="text-end">Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (expenses.Any())
                                    {
                                        @foreach (var exp in expenses)
                                        {
                                            <tr>
                                                <td>@exp.ExpenseDate.ToString("dd MMM yyyy")</td>
                                                <td class="fw-semibold">@(exp.Description ?? "Site Expense")</td>
                                                <td>@(exp.IncurredByUser?.FullName ?? exp.IncurredByUser?.Username ?? "N/A")</td>
                                                <td><span class="badge bg-light text-dark border">@exp.PaymentMode</span></td>
                                                <td class="text-end fw-bold text-danger">&#8377; @exp.Amount.ToString("N2")</td>
                                                <td>
                                                    <span class="badge @(exp.Status == "APPROVED" ? "bg-success" : (exp.Status == "REJECTED" ? "bg-danger" : "bg-info text-dark"))">
                                                        @(string.IsNullOrWhiteSpace(exp.Status) ? "SUBMITTED" : exp.Status)
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                No direct site expenses logged for this project yet.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                @if (expenses.Any())
                                {
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="4" class="text-end">Total Direct Expenses:</td>
                                            <td class="text-end text-danger">&#8377; @expenses.Sum(e => e.Amount).ToString("N2")</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: VIEW WORK ORDER -->
<!-- ========================================================================= -->
<div class="modal fade" id="viewWorkOrderModal" tabindex="-1" aria-labelledby="viewWorkOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold" id="viewWorkOrderModalLabel">
                    <i class="fa-solid fa-file-contract text-primary me-2"></i>Client Work Order Details
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="font-size: 13px;">
                <div class="mb-3">
                    <span class="text-muted d-block" style="font-size: 11px;">WORK ORDER / PO REF NO.</span>
                    <strong class="fs-6 text-primary">@(firstPo?.ClientPoNumber ?? $"WO-{Model?.ProjectCode}")</strong>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <span class="text-muted d-block" style="font-size: 11px;">ORDER DATE</span>
                        <strong>@((firstPo?.PoDate ?? Model?.StartDate ?? DateTime.Today).ToString("dd MMM yyyy"))</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block" style="font-size: 11px;">CONTRACT VALUE</span>
                        <strong class="text-success">&#8377; @(projectVal.ToString("N2"))</strong>
                    </div>
                </div>
                <div class="mb-3">
                    <span class="text-muted d-block" style="font-size: 11px;">SCOPE OF WORK / CLASSIFICATION</span>
                    <div>@(firstPo?.ScopeOfWork ?? "Client Work Order / Turnkey Contract Agreement")</div>
                </div>

                @if (firstPo?.Attachment != null || documents.Any(d => d.EntityType == "Project"))
                {
                    var doc = firstPo?.Attachment ?? documents.FirstOrDefault(d => d.EntityType == "Project");
                    if (doc != null)
                    {
                        <div class="p-3 border rounded bg-light d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa-solid fa-file-pdf text-danger fs-4 me-2"></i>
                                <strong>@doc.FileName</strong>
                                <small class="text-muted d-block">Uploaded on @doc.UploadedAt.ToString("dd MMM yyyy")</small>
                            </div>
                            <a href="@doc.FilePath" download="@doc.FileName" class="btn btn-outline-primary btn-sm">
                                <i class="fa-solid fa-download me-1"></i> Download
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="p-3 border rounded bg-light text-center text-muted">
                        <i class="fa-solid fa-file-circle-xmark fs-4 mb-2 d-block text-secondary"></i>
                        No physical work order file uploaded yet.
                    </div>
                }
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: UPLOAD COMPLETION CERTIFICATE / CLOSURE -->
<!-- ========================================================================= -->
<div class="modal fade" id="uploadCertificateModal" tabindex="-1" aria-labelledby="uploadCertificateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Projects" asp-action="CloseProject" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model?.Id" />
                <div class="modal-header bg-light">
                    <h6 class="modal-title fw-bold" id="uploadCertificateModalLabel">
                        <i class="fa-solid fa-award text-success me-2"></i>Upload Completion Certificate &amp; Close Project
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" style="font-size: 13px;">
                    <div class="alert alert-info py-2 px-3 mb-3" style="font-size: 12px;">
                        <i class="fa-solid fa-info-circle me-1"></i> Uploading the client-signed project completion certificate will archive the project and record final closure.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px;">Completion Certificate File <span class="text-danger">*</span></label>
                        <input type="file" name="closureDocument" class="form-control" accept=".pdf,.docx,.jpg,.png,.zip" required />
                        <small class="text-muted" style="font-size: 11px;">Accepted formats: PDF, Word, Scanned Images (Max 10 MB).</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px;">Closure Notes / Handover Remarks</label>
                        <textarea name="closureNotes" class="form-control" rows="3" placeholder="Project deliverables completed, hand-over sign-off acquired."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-4 fw-bold">
                        <i class="fa-solid fa-upload me-1"></i> Upload &amp; Close
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

