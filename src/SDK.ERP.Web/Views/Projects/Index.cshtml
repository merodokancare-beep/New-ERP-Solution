@model IEnumerable<SDK.ERP.Domain.Entities.Projects.Project>
@{
    ViewData["Title"] = "Projects Management Hub";
    ViewData["ActiveMenu"] = "Projects";
    var projectList = Model ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Projects.Project>();
    var totalContract = projectList.Sum(p => p.ContractValue);
    var activeCount = projectList.Count(p => p.Status == "ACTIVE" || p.Status == "PLANNING");
    var clients = ViewBag.Clients as IEnumerable<SDK.ERP.Domain.Entities.MasterData.Client> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.Client>();
    var projectTypes = ViewBag.ProjectTypes as IEnumerable<SDK.ERP.Domain.Entities.MasterData.ProjectType> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.ProjectType>();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 style="font-weight: 700; color: var(--erp-primary); margin-bottom: 4px;">Projects Management Hub</h3>
        <p style="color: var(--erp-text-muted); margin: 0; font-size: 13.5px;">Project-Centric Operating Paradigm &bull; Lifecycle, Invoicing, Procurement &amp; Real-Time Margins</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--erp-primary); border-color: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createProjectModal">
            <i class="fa-solid fa-plus me-1"></i> Create Project
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
        <div>@Html.Raw(TempData["SuccessMessage"])</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Project Health Cards (Dynamic Data) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="p-3 bg-white border rounded shadow-sm">
            <small class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Active Projects</small>
            <div class="fs-4 fw-bold text-primary">@activeCount</div>
            <small class="text-muted">Total Registered in System</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-white border rounded shadow-sm">
            <small class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Total Contract Value</small>
            <div class="fs-4 fw-bold text-success">&#8377; @totalContract.ToString("N2")</div>
            <small class="text-muted">Aggregated PO / Agreement Values</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-white border rounded shadow-sm">
            <small class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Workspace Capabilities</small>
            <div class="fs-4 fw-bold text-info">11 Tabs</div>
            <small class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Deliveries, POs, Expenses &amp; Invoices</small>
        </div>
    </div>
</div>

<!-- Projects Table -->
<div class="erp-card">
    <div class="erp-card-header d-flex justify-content-between align-items-center">
        <h5 class="erp-card-title"><i class="fa-solid fa-diagram-project me-2"></i>Active Project Register</h5>
    </div>
    <div class="erp-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                <thead class="table-light" style="font-size: 12px; text-transform: uppercase;">
                    <tr>
                        <th class="ps-4">Project Code</th>
                        <th>Project Name</th>
                        <th>Client</th>
                        <th>Type</th>
                        <th>Contract Value</th>
                        <th>Start Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (projectList.Any())
                    {
                        @foreach (var p in projectList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@p.ProjectCode</td>
                                <td><strong>@p.ProjectName</strong></td>
                                <td>@(p.Client?.ClientName ?? "N/A")</td>
                                <td><span class="badge bg-light text-dark border">@p.ProjectType</span></td>
                                <td class="fw-bold text-success">&#8377; @p.ContractValue.ToString("N2")</td>
                                <td>@p.StartDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-success">@p.Status</span></td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Projects" asp-action="Detail" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-folder-open me-1"></i> Open Workspace
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="fa-solid fa-diagram-project mb-3" style="font-size: 40px; color: #CBD5E1;"></i>
                                <h6 class="fw-bold text-secondary mb-1">No Projects in Database</h6>
                                <p class="text-muted mb-3" style="font-size: 12.5px;">No active or pipeline projects exist in the database yet.</p>
                                <button class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--erp-primary);" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                                    <i class="fa-solid fa-plus me-1"></i> Create First Project
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- CREATE PROJECT MODAL (INTERACTIVE FORM) -->
<!-- ========================================================================= -->
<div class="modal fade" id="createProjectModal" tabindex="-1" aria-labelledby="createProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Projects" asp-action="Create" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="createProjectModalLabel" style="color: var(--erp-primary); font-size: 16px;">
                        <i class="fa-solid fa-diagram-project me-2"></i>Create New Project
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Project Code <span class="text-danger">*</span></label>
                            <input type="text" name="projectCode" class="form-control" placeholder="e.g. PRJ-2026-001" value="PRJ-@DateTime.Now.ToString("yyyyMMdd-HHmm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Project Name <span class="text-danger">*</span></label>
                            <input type="text" name="projectName" class="form-control" placeholder="e.g. Metro Line Surveillance Infrastructure" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Client / Customer <span class="text-danger">*</span></label>
                            <select name="clientId" class="form-select" required>
                                <option value="">-- Select Client from Master --</option>
                                @foreach (var c in clients)
                                {
                                    <option value="@c.Id">@c.ClientName (@c.ClientCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold mb-0" style="font-size: 12.5px;">Project Type <span class="text-danger">*</span></label>
                                <a asp-controller="Masters" asp-action="Index" class="text-decoration-none" style="font-size: 11px;" target="_blank">
                                    <i class="fa-solid fa-gear me-1"></i>Manage in Masters
                                </a>
                            </div>
                            <select name="projectType" class="form-select" required>
                                @if (projectTypes.Any())
                                {
                                    @foreach (var pt in projectTypes)
                                    {
                                        <option value="@pt.Code">@pt.Name</option>
                                    }
                                }
                                else
                                {
                                    <option value="STANDARD" selected>Standard Turnkey Contract</option>
                                    <option value="AMC">Annual Maintenance Contract (AMC)</option>
                                    <option value="CONSULTING">Consulting &amp; Advisory</option>
                                    <option value="SUPPLY_INSTALL">Supply &amp; Installation</option>
                                    <option value="MANPOWER">Manpower &amp; Managed Services</option>
                                    <option value="INTERNAL">Internal R&amp;D</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Total Contract Value (&#8377;) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" name="contractValue" class="form-control fw-bold text-success" placeholder="0.00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Start Date</label>
                            <input type="date" name="startDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Expected Delivery Date <span class="text-danger">*</span></label>
                            <input type="date" name="expectedEndDate" class="form-control" required />
                        </div>

                        <!-- PROJECT DOCUMENT & WORK ORDER UPLOAD -->
                        <div class="col-12 mt-3 pt-2 border-top">
                            <h6 class="fw-bold text-dark mb-1" style="font-size: 13px;">
                                <i class="fa-solid fa-file-contract text-primary me-2"></i>Project Document &amp; Client Work Order (WO)
                            </h6>
                            <small class="text-muted d-block mb-3" style="font-size: 11.5px;">
                                Attach client work orders, contract agreements, or tender documents directly upon initialization.
                            </small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Client Work Order / PO Ref No.</label>
                            <input type="text" name="clientPoNumber" class="form-control" placeholder="e.g. WO-2026-9842 or PO/REL/01" />
                            <small class="text-muted" style="font-size: 11px;">Auto-creates linked Client PO record in the project workspace.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">Document Classification</label>
                            <select name="documentTitle" class="form-select">
                                <option value="Client Work Order" selected>Client Work Order (WO)</option>
                                <option value="Client Purchase Order">Client Purchase Order (PO)</option>
                                <option value="Contract Agreement">Formal Contract Agreement</option>
                                <option value="Tender / Scope Document">Tender / Scope Specification</option>
                                <option value="Letter of Intent (LOI)">Letter of Intent (LOI) / Award Notice</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size: 12.5px;">
                                <i class="fa-solid fa-file-arrow-up text-primary me-1"></i>Upload Contract / Work Order File (Optional)
                            </label>
                            <input type="file" name="projectDocument" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.zip" />
                            <small class="text-muted" style="font-size: 11.5px;">Accepted formats: PDF, Word (.docx), Scanned Images (.jpg, .png), Zip archive (Max 25 MB).</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold" style="background: var(--erp-primary);">
                        <i class="fa-solid fa-save me-1"></i> Save &amp; Initialize Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
