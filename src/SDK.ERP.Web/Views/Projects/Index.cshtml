<!-- ========================================================================= -->
<!-- JAVASCRIPT: INSTANT LIVE FILTERING, TAB LOGIC, AND MODAL DATA BINDING -->
<!-- ========================================================================= -->
@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const clientFilter = document.getElementById("filterClientSelect");
        const projectFilter = document.getElementById("filterProjectSelect");
        const searchInput = document.getElementById("searchKeywordInput");
        const divisionFilter = document.getElementById("filterDivisionSelect");
        const btnClear = document.getElementById("btnClearFilters");
        const btnSearch = document.getElementById("btnSearchTrigger");
        const tabPills = document.querySelectorAll(".status-tab-pill");
        const items = document.querySelectorAll(".project-row-item");
        const noMatchMsg = document.getElementById("noMatchMessage");

        let activeTab = "OPEN"; // Default to Open Projects like reference

        function applyAllFilters() {
            const selectedClient = clientFilter.value.trim().toLowerCase();
            const selectedProject = projectFilter.value.trim().toLowerCase();
            const keyword = searchInput.value.trim().toLowerCase();
            const selectedDivision = divisionFilter.value.trim().toLowerCase();

            let visibleCount = 0;

            // Recalculate dynamic counts based on current filters (except tab filter)
            let tabOpen = 0, tabSupport = 0, tabClosed = 0, tabScrapped = 0, tabAll = 0;

            items.forEach(item => {
                const pName = (item.dataset.projectName || "").toLowerCase();
                const pCode = (item.dataset.projectCode || "").toLowerCase();
                const cName = (item.dataset.clientName || "").toLowerCase();
                const divName = (item.dataset.division || "").toLowerCase();
                const desc = (item.dataset.description || "").toLowerCase();
                const manager = (item.dataset.managerName || "").toLowerCase();
                const statusCategory = (item.dataset.statusCategory || "").toUpperCase();

                // Match against filter dropdowns & keyword
                const matchesClient = !selectedClient || cName === selectedClient;
                const matchesProject = !selectedProject || pName === selectedProject;
                const matchesDivision = !selectedDivision || divName === selectedDivision;
                const matchesKeyword = !keyword || (
                    pName.includes(keyword) ||
                    pCode.includes(keyword) ||
                    cName.includes(keyword) ||
                    desc.includes(keyword) ||
                    manager.includes(keyword)
                );

                const passesCommonFilters = matchesClient && matchesProject && matchesDivision && matchesKeyword;

                if (passesCommonFilters) {
                    tabAll++;
                    if (statusCategory === "OPEN") tabOpen++;
                    else if (statusCategory === "SUPPORT") tabSupport++;
                    else if (statusCategory === "CLOSED") tabClosed++;
                    else if (statusCategory === "SCRAPPED") tabScrapped++;
                }

                // Match against active status tab
                const matchesTab = (activeTab === "ALL") || (statusCategory === activeTab);

                if (passesCommonFilters && matchesTab) {
                    item.style.display = "flex";
                    visibleCount++;
                } else {
                    item.style.display = "none";
                }
            });

            // Update badge counts on tabs
            const elOpen = document.getElementById("countOpen");
            const elSupport = document.getElementById("countSupport");
            const elClosed = document.getElementById("countClosed");
            const elScrapped = document.getElementById("countScrapped");
            const elAll = document.getElementById("countAll");

            if (elOpen) elOpen.textContent = tabOpen;
            if (elSupport) elSupport.textContent = tabSupport;
            if (elClosed) elClosed.textContent = tabClosed;
            if (elScrapped) elScrapped.textContent = tabScrapped;
            if (elAll) elAll.textContent = tabAll;

            if (noMatchMsg) {
                if (visibleCount === 0 && items.length > 0) {
                    noMatchMsg.classList.remove("d-none");
                } else {
                    noMatchMsg.classList.add("d-none");
                }
            }
        }

        // Event listeners for filters
        clientFilter.addEventListener("change", applyAllFilters);
        projectFilter.addEventListener("change", function () {
            if (projectFilter.value) {
                searchInput.value = projectFilter.value;
            }
            applyAllFilters();
        });
        divisionFilter.addEventListener("change", applyAllFilters);
        searchInput.addEventListener("input", applyAllFilters);
        if (btnSearch) btnSearch.addEventListener("click", applyAllFilters);

        // Status Tabs Click Event
        tabPills.forEach(pill => {
            pill.addEventListener("click", function () {
                tabPills.forEach(p => p.classList.remove("active"));
                this.classList.add("active");
                activeTab = this.dataset.statusFilter || "ALL";
                applyAllFilters();
            });
        });

        // Clear Filters Handler
        function resetFilters() {
            clientFilter.value = "";
            projectFilter.value = "";
            divisionFilter.value = "";
            searchInput.value = "";
            activeTab = "OPEN";
            tabPills.forEach(p => {
                if (p.dataset.statusFilter === "OPEN") p.classList.add("active");
                else p.classList.remove("active");
            });
            applyAllFilters();
        }

        if (btnClear) btnClear.addEventListener("click", resetFilters);
        window.resetAllFilters = resetFilters;

        // Run filter initially to show Open Projects by default
        applyAllFilters();
    });

    // Helper: Copy Path or URL to Clipboard
    function copyToClipboard(text) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function() {
                alert("File path copied to clipboard:\n" + text);
            }).catch(function() {
                prompt("Copy path below:", text);
            });
        } else {
            prompt("Copy path below:", text);
        }
    }

    // Modal Handlers: Open Edit Modal
    function openEditModal(projectId) {
        const item = document.querySelector(`.project-row-item[data-project-id="${projectId}"]`);
        if (!item) return;

        document.getElementById("editProjectId").value = projectId;
        document.getElementById("editProjectCode").value = item.dataset.projectCode || "";
        document.getElementById("editProjectName").value = item.dataset.projectName || "";
        document.getElementById("editClientId").value = item.dataset.clientId || "";
        document.getElementById("editDivision").value = item.dataset.division || "";
        document.getElementById("editProjectType").value = item.dataset.projectType || "";
        document.getElementById("editManagerId").value = item.dataset.managerId || "";
        document.getElementById("editContractValue").value = item.dataset.contractValue || "0";
        document.getElementById("editStartDate").value = item.dataset.startDate || "";
        document.getElementById("editExpectedEndDate").value = item.dataset.expectedEndDate || "";
        document.getElementById("editStatus").value = item.dataset.status || "OPEN";
        document.getElementById("editPhysicalFileStatus").value = item.dataset.physicalStatus || "Not Create";
        document.getElementById("editDescription").value = item.dataset.description || "";

        const modal = new bootstrap.Modal(document.getElementById("editProjectModal"));
        modal.show();
    }

    // Modal Handlers: Open Status Change Modal
    function openStatusModal(projectId, currentStatus, projectCode) {
        document.getElementById("statusProjectId").value = projectId;
        document.getElementById("statusProjectText").textContent = `Update status for ${projectCode}:`;
        document.getElementById("quickStatusSelect").value = currentStatus || "OPEN";
        const modal = new bootstrap.Modal(document.getElementById("statusChangeModal"));
        modal.show();
    }

    // Modal Handlers: Open Delete Modal
    function openDeleteModal(projectId, projectCode, projectName) {
        document.getElementById("deleteProjectId").value = projectId;
        document.getElementById("deleteProjectName").textContent = `${projectCode} - ${projectName}`;
        const modal = new bootstrap.Modal(document.getElementById("deleteProjectModal"));
        modal.show();
    }
</script>
}
