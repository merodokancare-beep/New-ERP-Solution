@model IEnumerable<SDK.ERP.Domain.Entities.Projects.Project>
@{
    ViewData["Title"] = "Project List";
    ViewData["ActiveMenu"] = "Projects";
    var projectList = (Model ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Projects.Project>()).ToList();
    var totalContract = projectList.Sum(p => p.ContractValue);
    
    // Status counts
    var openCount = projectList.Count(p => p.Status == "OPEN" || p.Status == "ACTIVE" || p.Status == "PLANNING");
    var supportCount = projectList.Count(p => p.Status == "SUPPORT" || p.Status == "UNDER_SUPPORT" || p.Status == "UNDER SUPPORT" || p.Status == "MAINTENANCE");
    var closedCount = projectList.Count(p => p.Status == "CLOSED" || p.Status == "COMPLETED");
    var scrappedCount = projectList.Count(p => p.Status == "SCRAPPED" || p.Status == "CANCELLED" || p.Status == "CLOSE SCRAPPED" || p.Status == "ON_HOLD");

    var clients = ViewBag.Clients as IEnumerable<SDK.ERP.Domain.Entities.MasterData.Client> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.Client>();
    var projectTypes = ViewBag.ProjectTypes as IEnumerable<SDK.ERP.Domain.Entities.MasterData.ProjectType> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.MasterData.ProjectType>();
    var users = ViewBag.Users as IEnumerable<SDK.ERP.Domain.Entities.Admin.User> ?? Enumerable.Empty<SDK.ERP.Domain.Entities.Admin.User>();
    var divisions = ViewBag.Divisions as IEnumerable<string> ?? new List<string> { "HARDWARE DIVISION", "GENERAL SUPPLY", "SOFTWARE & IT", "NETWORKING", "CIVIL & INFRA" };
    var docCounts = ViewBag.ProjectDocCounts as Dictionary<long, int> ?? new Dictionary<long, int>();
}

<!-- Custom Scoped Styling for Attractive & Responsive Project Register -->
<style>
    .project-register-container {
        font-size: 13px;
        color: #1E293B;
    }

    /* Top Title Header */
    .project-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .project-page-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        color: #0F172A;
        letter-spacing: -0.5px;
    }

    .project-page-title i {
        color: var(--erp-primary);
        font-size: 20px;
    }

    .btn-add-project-main {
        background: #0284C7;
        color: #FFFFFF;
        border: none;
        font-weight: 600;
        font-size: 13.5px;
        padding: 8px 18px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(2, 132, 199, 0.25);
    }

    .btn-add-project-main:hover {
        background: #0369A1;
        color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
    }

    /* Filter & Search Bar Card */
    .filter-panel-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .filter-label {
        font-size: 12px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 6px;
        display: block;
    }

    .form-select-filter, .form-input-filter {
        height: 38px;
        font-size: 13px;
        border-radius: 8px;
        border: 1px solid #CBD5E1;
        background-color: #F8FAFC;
        transition: all 0.15s ease;
    }

    .form-select-filter:focus, .form-input-filter:focus {
        background-color: #FFFFFF;
        border-color: #0284C7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .search-input-group {
        position: relative;
        display: flex;
    }

    .search-input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .btn-search-trigger {
        background: #F59E0B;
        border: 1px solid #F59E0B;
        color: #FFFFFF;
        padding: 0 16px;
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: background 0.15s ease;
    }

    .btn-search-trigger:hover {
        background: #D97706;
        color: #FFFFFF;
    }

    .btn-clear-filters {
        background: #10B981;
        border: 1px solid #10B981;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 13px;
        height: 38px;
        padding: 0 18px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.15s ease;
        box-shadow: 0 2px 6px rgba(16, 185, 129, 0.2);
    }

    .btn-clear-filters:hover {
        background: #059669;
        color: #FFFFFF;
        transform: translateY(-1px);
    }

    /* Status Tab Pills */
    .status-tab-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .status-tab-pill {
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #475569;
        padding: 8px 18px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        text-decoration: none;
        user-select: none;
    }

    .status-tab-pill:hover {
        background: #F1F5F9;
        color: #0F172A;
    }

    .status-tab-pill.active {
        background: #0D9488;
        border-color: #0D9488;
        color: #FFFFFF;
        box-shadow: 0 2px 8px rgba(13, 148, 136, 0.3);
    }

    .status-tab-pill.active .badge-pill-count {
        background: rgba(255, 255, 255, 0.25);
        color: #FFFFFF;
    }

    .badge-pill-count {
        font-size: 11px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 12px;
        background: #E2E8F0;
        color: #475569;
        transition: all 0.2s ease;
    }

    /* Project List Table & Header */
    .project-table-wrapper {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    }

    .project-table-header {
        background: linear-gradient(180deg, #94A3B8 0%, #64748B 100%);
        color: #FFFFFF;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 13.5px;
        letter-spacing: 0.3px;
    }

    .project-row-item {
        padding: 16px 20px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        transition: all 0.2s ease;
        background: #FFFFFF;
        position: relative;
    }

    .project-row-item:last-child {
        border-bottom: none;
    }

    .project-row-item:hover {
        background: #F8FAFC;
    }

    .project-details-grid {
        flex: 1;
        display: grid;
        grid-template-columns: 2.2fr 1fr;
        gap: 20px;
    }

    /* Left Details Area */
    .project-main-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .project-title-link {
        font-size: 14.5px;
        font-weight: 700;
        color: #0284C7;
        text-decoration: none;
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        line-height: 1.35;
        transition: color 0.15s ease;
    }

    .project-title-link:hover {
        color: #0369A1;
        text-decoration: underline;
    }

    .project-code-tag {
        font-size: 11px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 4px;
        background: #E0F2FE;
        color: #0369A1;
        border: 1px solid #BAE6FD;
        display: inline-block;
    }

    .project-field-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        font-size: 12.5px;
        color: #334155;
    }

    .field-key {
        font-weight: 700;
        color: #0284C7;
        margin-right: 4px;
    }

    .field-val-money {
        font-weight: 800;
        color: #0F172A;
    }

    .badge-file-status {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .badge-file-notcreated {
        background: #DC2626;
        color: #FFFFFF;
    }

    .badge-file-created {
        background: #10B981;
        color: #FFFFFF;
    }

    .project-desc-row {
        font-size: 12px;
        color: #475569;
        word-break: break-all;
    }

    .network-path-link {
        font-family: Consolas, "Courier New", monospace;
        color: #0369A1;
        background: #F1F5F9;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #E2E8F0;
        font-size: 11.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

    .network-path-link:hover {
        background: #E2E8F0;
        color: #0284C7;
    }

    /* Right Meta Column */
    .project-side-meta {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        font-size: 12px;
        border-left: 1px dashed #E2E8F0;
        padding-left: 18px;
    }

    .badge-status-pill {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 12px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        display: inline-block;
        width: fit-content;
    }

    .badge-status-open {
        background: #22C55E;
        color: #FFFFFF;
    }

    .badge-status-support {
        background: #0EA5E9;
        color: #FFFFFF;
    }

    .badge-status-closed {
        background: #64748B;
        color: #FFFFFF;
    }

    .badge-status-scrapped {
        background: #EF4444;
        color: #FFFFFF;
    }

    /* Action Buttons */
    .project-actions-cell {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        min-width: 140px;
        justify-content: flex-end;
    }

    .btn-action-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid transparent;
        background: transparent;
        color: #64748B;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
    }

    .btn-action-icon:hover {
        transform: scale(1.1);
    }

    .btn-action-icon.edit:hover {
        color: #0284C7;
        background: #E0F2FE;
        border-color: #BAE6FD;
    }

    .btn-action-icon.view:hover {
        color: #0D9488;
        background: #CCFBF1;
        border-color: #99F6E4;
    }

    .btn-action-icon.status:hover {
        color: #16A34A;
        background: #DCFCE7;
        border-color: #BBF7D0;
    }

    .btn-action-icon.delete:hover {
        color: #DC2626;
        background: #FEE2E2;
        border-color: #FECACA;
    }

    /* Responsive Breakpoints */
    @@media (max-width: 992px) {
        .project-details-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }
        .project-side-meta {
            border-left: none;
            padding-left: 0;
            border-top: 1px dashed #E2E8F0;
            padding-top: 10px;
        }
        .project-row-item {
            flex-direction: column;
            align-items: flex-start;
        }
        .project-actions-cell {
            width: 100%;
            justify-content: flex-start;
            border-top: 1px solid #F1F5F9;
            padding-top: 10px;
        }
    }
</style>

<div class="project-register-container">

    <!-- Top Page Header -->
    <div class="project-header-bar">
        <div>
            <h2 class="project-page-title">
                <i class="fa-solid fa-list-check"></i> Project List
            </h2>
            <div class="text-muted" style="font-size: 12px; margin-top: 2px;">
                Active Project Register &bull; Client Work Orders, Physical Documents, Division Mapping &amp; Status
            </div>
        </div>
        <div>
            <button class="btn-add-project-main" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                <i class="fa-solid fa-plus"></i> Add Project
            </button>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
            <div>@Html.Raw(TempData["SuccessMessage"])</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5 me-2 text-danger"></i>
            <div>@Html.Raw(TempData["ErrorMessage"])</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- FILTER & SEARCH PANEL (MATCHING USER SCREENSHOT) -->
    <!-- ========================================================================= -->
    <div class="filter-panel-card">
        <div class="row g-3">
            <!-- Row 1: Client Name & Project Name -->
            <div class="col-md-6">
                <label class="filter-label">Client Name:</label>
                <select id="filterClientSelect" class="form-select form-select-filter">
                    <option value="">-- Filter By Client --</option>
                    @foreach (var c in clients)
                    {
                        <option value="@c.ClientName">@c.ClientName</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="filter-label">Project Name:</label>
                <select id="filterProjectSelect" class="form-select form-select-filter">
                    <option value="">----Select Project List----</option>
                    @foreach (var p in projectList.OrderBy(p => p.ProjectName))
                    {
                        <option value="@p.ProjectName">@p.ProjectName</option>
                    }
                </select>
            </div>

            <!-- Row 2: Search Input, Project Division & Clear Filter -->
            <div class="col-md-6">
                <div class="search-input-group mt-2">
                    <input type="text" id="searchKeywordInput" class="form-control form-input-filter" placeholder="Search by project Name.." />
                    <button class="btn-search-trigger" id="btnSearchTrigger" type="button" title="Search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mt-2">
                    <select id="filterDivisionSelect" class="form-select form-select-filter">
                        <option value="">-- Filter By Project Division --</option>
                        @foreach (var div in divisions)
                        {
                            <option value="@div">@div</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-2 text-md-end">
                <div class="mt-2">
                    <button type="button" id="btnClearFilters" class="btn-clear-filters w-100">
                        <i class="fa-solid fa-rotate-right"></i> Clear Filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- STATUS TAB PILLS (OPEN, UNDER SUPPORT, CLOSED, SCRAPPED) -->
    <!-- ========================================================================= -->
    <div class="status-tab-bar">
        <div class="status-tab-pill active" data-status-filter="OPEN" id="tabOpenProjects">
            Open Projects <span class="badge-pill-count" id="countOpen">@openCount</span>
        </div>
        <div class="status-tab-pill" data-status-filter="SUPPORT" id="tabSupportProjects">
            Project Under Support <span class="badge-pill-count" id="countSupport">@supportCount</span>
        </div>
        <div class="status-tab-pill" data-status-filter="CLOSED" id="tabClosedProjects">
            Closed Projects <span class="badge-pill-count" id="countClosed">@closedCount</span>
        </div>
        <div class="status-tab-pill" data-status-filter="SCRAPPED" id="tabScrappedProjects">
            Close Scrapped <span class="badge-pill-count" id="countScrapped">@scrappedCount</span>
        </div>
        <div class="status-tab-pill" data-status-filter="ALL" id="tabAllProjects">
            All Projects <span class="badge-pill-count" id="countAll">@projectList.Count</span>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- PROJECT LISTING ACCORDION / CARD TABLE -->
    <!-- ========================================================================= -->
    <div class="project-table-wrapper">
        <div class="project-table-header">
            <div><i class="fa-solid fa-folder-tree me-2"></i>Project Details</div>
            <div>Action</div>
        </div>

        <div id="projectItemsContainer">
            @if (projectList.Any())
            {
                @foreach (var p in projectList)
                {
                    var clientName = p.Client?.ClientName ?? "N/A";
                    var divisionName = !string.IsNullOrWhiteSpace(p.Division) ? p.Division : (!string.IsNullOrWhiteSpace(p.ProjectType) ? p.ProjectType : "N/A");
                    var managerName = p.Manager?.FullName ?? (!string.IsNullOrWhiteSpace(p.Manager?.Username) ? p.Manager.Username : "Unassigned");
                    var rawStatus = (p.Status ?? "OPEN").Trim().ToUpperInvariant();
                    var desc = !string.IsNullOrWhiteSpace(p.Description) ? p.Description : (!string.IsNullOrWhiteSpace(p.ClosureNotes) ? p.ClosureNotes : "N/A");
                    
                    // Physical file status logic
                    var hasDocs = (docCounts.ContainsKey(p.Id) && docCounts[p.Id] > 0) || p.PurchaseOrders.Any(po => po.AttachmentDocId != null);
                    var physicalStatus = !string.IsNullOrWhiteSpace(p.PhysicalFileStatus) ? p.PhysicalFileStatus : (hasDocs ? "Created" : "Not Create");
                    var isCreated = physicalStatus.Equals("Created", StringComparison.OrdinalIgnoreCase) || physicalStatus.Equals("Available", StringComparison.OrdinalIgnoreCase);

                    // Normalize status for filtering
                    var statusCategory = "OPEN";
                    var statusBadgeClass = "badge-status-open";
                    var statusDisplay = "Open";

                    if (rawStatus == "SUPPORT" || rawStatus == "UNDER_SUPPORT" || rawStatus == "UNDER SUPPORT" || rawStatus == "MAINTENANCE")
                    {
                        statusCategory = "SUPPORT";
                        statusBadgeClass = "badge-status-support";
                        statusDisplay = "Under Support";
                    }
                    else if (rawStatus == "CLOSED" || rawStatus == "COMPLETED")
                    {
                        statusCategory = "CLOSED";
                        statusBadgeClass = "badge-status-closed";
                        statusDisplay = "Closed";
                    }
                    else if (rawStatus == "SCRAPPED" || rawStatus == "CLOSE SCRAPPED" || rawStatus == "CANCELLED" || rawStatus == "ON_HOLD")
                    {
                        statusCategory = "SCRAPPED";
                        statusBadgeClass = "badge-status-scrapped";
                        statusDisplay = "Scrapped";
                    }

                    <div class="project-row-item"
                         data-project-id="@p.Id"
                         data-project-code="@p.ProjectCode"
                         data-project-name="@p.ProjectName"
                         data-client-name="@clientName"
                         data-client-id="@p.ClientId"
                         data-division="@divisionName"
                         data-project-type="@p.ProjectType"
                         data-contract-value="@p.ContractValue"
                         data-start-date="@p.StartDate.ToString("yyyy-MM-dd")"
                         data-expected-end-date="@(p.ExpectedEndDate?.ToString("yyyy-MM-dd") ?? "")"
                         data-manager-id="@(p.ManagerId ?? 0)"
                         data-manager-name="@managerName"
                         data-status="@rawStatus"
                         data-status-category="@statusCategory"
                         data-physical-status="@physicalStatus"
                         data-description="@desc">

                        <!-- Center / Main Details Grid -->
                        <div class="project-details-grid">
                            <div class="project-main-meta">
                                <div>
                                    <span class="field-key">Name:</span>
                                    <a asp-controller="Projects" asp-action="Detail" asp-route-id="@p.Id" class="project-title-link">
                                        @p.ProjectName
                                    </a>
                                    <span class="project-code-tag ms-1">@p.ProjectCode</span>
                                </div>

                                <div class="project-field-row mt-1">
                                    <div>
                                        <span class="field-key">Client Name:</span>
                                        <span>@clientName</span>
                                    </div>
                                    <div>
                                        <span class="field-key">Physical File:</span>
                                        <span class="badge-file-status @(isCreated ? "badge-file-created" : "badge-file-notcreated")">
                                            @physicalStatus
                                        </span>
                                    </div>
                                </div>

                                <div class="project-field-row">
                                    <div>
                                        <span class="field-key">Total Value:</span>
                                        <span class="field-val-money">&#8377; @p.ContractValue.ToString("N2")</span>
                                    </div>
                                    <div>
                                        <span class="field-key">Project Division:</span>
                                        <span class="fw-semibold">@divisionName</span>
                                    </div>
                                </div>

                                <div class="project-field-row">
                                    <div>
                                        <span class="field-key">Project Incharge:</span>
                                        <span>@managerName</span>
                                    </div>
                                </div>

                                <div class="project-desc-row mt-1">
                                    <span class="field-key">Description:</span>
                                    @if (desc.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@desc" target="_blank" class="network-path-link">
                                            <i class="fa-solid fa-link me-1"></i>Open Resource Link
                                        </a>
                                    }
                                    else if (desc.StartsWith("\\\\"))
                                    {
                                        <span class="network-path-link" title="Click to copy path" onclick="copyToClipboard('@desc.Replace("\\", "\\\\")')">
                                            <i class="fa-solid fa-folder-open me-1"></i>@desc
                                            <i class="fa-regular fa-copy ms-1 text-muted"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@desc</span>
                                    }
                                </div>
                            </div>

                            <!-- Right Side Meta (Status, Type, Date, Added By) -->
                            <div class="project-side-meta">
                                <div>
                                    <span class="field-key">Status:</span>
                                    <span class="badge-status-pill @statusBadgeClass">@statusDisplay</span>
                                </div>
                                <div>
                                    <span class="field-key">Type:</span>
                                    <span>@p.ProjectType</span>
                                </div>
                                <div>
                                    <span class="field-key">Date:</span>
                                    <span>
                                        @p.StartDate.ToString("dd MMM yyyy") - @(p.ExpectedEndDate?.ToString("dd MMM yyyy") ?? "N/A")
                                    </span>
                                </div>
                                <div>
                                    <span class="field-key">Added By:</span>
                                    <span>@(p.Manager?.FullName ?? (!string.IsNullOrWhiteSpace(p.Manager?.Username) ? p.Manager.Username : "Unassigned"))</span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Icons Column -->
                        <div class="project-actions-cell">
                            <!-- Edit -->
                            <button type="button" class="btn-action-icon edit" title="Edit Project Details" onclick="openEditModal(@p.Id)">
                                <i class="fa-solid fa-pencil"></i>
                            </button>
                            <!-- View Workspace -->
                            <a asp-controller="Projects" asp-action="Detail" asp-route-id="@p.Id" class="btn-action-icon view" title="Open Project Workspace">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <!-- Change Status Toggle -->
                            <button type="button" class="btn-action-icon status" title="Change Project Status" onclick="openStatusModal(@p.Id, '@rawStatus', '@p.ProjectCode')">
                                <i class="fa-solid fa-circle-check"></i>
                            </button>
                            <!-- Delete -->
                            <button type="button" class="btn-action-icon delete" title="Delete / Remove Project" onclick="openDeleteModal(@p.Id, '@p.ProjectCode', '@p.ProjectName.Replace("'", "\\'")')">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-diagram-project mb-3 text-muted" style="font-size: 44px; opacity: 0.5;"></i>
                    <h5 class="fw-bold text-secondary mb-1">No Projects in Directory</h5>
                    <p class="text-muted mb-3" style="font-size: 13px;">No projects currently registered in the database.</p>
                    <button class="btn btn-primary btn-sm px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                        <i class="fa-solid fa-plus me-1"></i> Register First Project
                    </button>
                </div>
            }

            <!-- Zero Match State during filtering -->
            <div id="noMatchMessage" class="text-center py-5 d-none">
                <i class="fa-solid fa-filter-circle-xmark mb-3 text-muted" style="font-size: 40px; opacity: 0.6;"></i>
                <h6 class="fw-bold text-secondary mb-1">No Matching Projects Found</h6>
                <p class="text-muted mb-3" style="font-size: 12.5px;">No projects match the currently selected filter criteria or search keyword.</p>
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="resetAllFilters()">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset Filters
                </button>
            </div>
        </div>
    </div>
</div>

